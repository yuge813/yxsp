.rr-card{background:#FFF;border:2rpx solid #F1DAE3;border-radius:30rpx;padding:27rpx;margin:22rpx 0;text-align:left;color:#27212C}.rr-mine{background:linear-gradient(125deg,#FFF6DF,#FFF2F2);border-color:#F4DDB1}.rr-heading{display:flex;align-items:center;gap:12rpx;min-height:50rpx}.rr-heading>text:first-of-type{flex:1;font-size:29rpx;font-weight:700}.rr-heading>button{font-size:24rpx;color:#BF214A;padding:10rpx;background:none;margin:0}.rr-pill{font-size:22rpx;color:#A05236;background:#FFE5B9;border-radius:14rpx;padding:8rpx}.rr-amount{font-size:56rpx;line-height:1.4;font-weight:800;color:#C70E3D;margin-top:12rpx}.rr-amount>text{font-size:24rpx;font-weight:400;margin-left:12rpx}.rr-copy,.rr-small,.rr-error{display:block;font-size:24rpx;color:#856171;line-height:1.8;margin-top:14rpx;white-space:normal}.rr-error{color:#BD2148}.rr-totals,.rr-rule-pair{display:flex;gap:20rpx;margin:22rpx 0}.rr-totals>view,.rr-rule-pair>view{flex:1;min-width:0;display:flex;flex-direction:column;gap:8rpx}.rr-totals>view>text:first-child{font-size:56rpx;color:#C71342;font-weight:750;overflow-wrap:anywhere}.rr-totals>view>text:last-child,.rr-rule-pair>view>text:last-child{font-size:24rpx;color:#856171}.rr-rule-head{font-size:28rpx;font-weight:700;border-top:2rpx dashed #F0D9DF;padding-top:24rpx;margin-top:22rpx}.rr-rule-pair{background:#FFF4E5;padding:20rpx;border-radius:20rpx}.rr-rule-pair>view>text:first-child{font-size:42rpx;font-weight:750;color:#BB2349}.rr-links{display:flex;gap:18rpx;flex-wrap:wrap;margin-top:14rpx}.rr-links>button{background:none;color:#C21943;font-size:25rpx;min-height:70rpx;padding:10rpx 0;margin:0;line-height:1.7}.rr-record{display:flex;justify-content:space-between;align-items:center;gap:18rpx;background:#FFF;border:2rpx solid #F1DEE7;border-radius:24rpx;padding:24rpx;margin:16rpx 0}.rr-record>view:first-child{flex:1;min-width:0}.rr-record>view>text{display:block;font-size:24rpx;line-height:1.7;color:#856171}.rr-record>view:first-child>text:first-child{font-size:28rpx;font-weight:650;color:#332531}.rr-record>view:last-child{text-align:right;flex-shrink:0}.rr-record>view>text.rr-paid{color:#C71342;font-size:29rpx;font-weight:700}.rr-tabs{display:flex;background:#FFEAF0;border-radius:24rpx;padding:7rpx;margin:22rpx 0}.rr-tabs>view{flex:1;min-height:80rpx;display:flex;align-items:center;justify-content:center;font-size:28rpx;color:#98637C;border-radius:19rpx}.rr-tabs>view.active{background:#D4113A;color:white;font-weight:700}
