.yx22-screen{position:fixed;inset:0;z-index:1500;display:flex;align-items:center;justify-content:center;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;box-sizing:border-box;}.yx22-mask{position:absolute;inset:0;background:rgba(20,36,29,.5);}.yx22-stage{position:relative;width:650rpx;max-width:calc(100vw - 64rpx);max-height:calc(100vh - 50rpx);display:flex;flex-direction:column;align-items:center;}.yx22-panel{width:100%;border-radius:32rpx;background:#FFFFFF;overflow:hidden;box-shadow:0 28rpx 100rpx rgba(12,32,21,.2);box-sizing:border-box;}.yx22-hero{display:flex;align-items:center;gap:14rpx;padding:20rpx 36rpx 6rpx;box-sizing:border-box;color:#795D68;font-size:25rpx;}.yx22-symbol{width:52rpx;height:52rpx;border-radius:16rpx;background:#FBE9DE;display:flex;align-items:center;justify-content:center;}.yx22-copy-scroll{width:100%;box-sizing:border-box;}.yx22-copy-inner{padding:18rpx 36rpx 28rpx;box-sizing:border-box;}.yx22-title{display:block;font-size:42rpx;font-weight:650;color:#27212C;line-height:1.4;word-break:break-all;}.yx22-cover{display:block;width:100%;border-radius:16rpx;margin-top:24rpx;}.yx22-body{display:block;font-size:29rpx;line-height:1.9;color:#53644F;white-space:pre-wrap;word-break:break-all;margin-top:22rpx;}.yx22-footer{padding-left:36rpx;padding-right:36rpx;box-sizing:border-box;}.yx22-primary{display:flex;align-items:center;justify-content:center;width:100%;padding:14rpx 22rpx;border-radius:18rpx;background:#D4113A;color:#FFFFFF;font-size:30rpx;line-height:1.4;font-weight:600;margin:0;box-sizing:border-box;}.yx22-primary::after,.yx22-dismiss::after{border:0;}.yx22-dismiss{display:flex;align-items:center;justify-content:center;gap:12rpx;min-height:88rpx;padding:12rpx 28rpx;margin-top:12rpx;color:#FFFFFF;font-size:27rpx;line-height:1.5;background:transparent;box-sizing:border-box;}
