<view wx:if="{{type==='loading'}}" class="state-skeleton" aria-role="status" aria-label="正在加载"><view class="skeleton-line short"></view><view class="skeleton-block"></view><view class="skeleton-line"></view><view class="skeleton-line middle"></view><text class="loading-label">{{title||'正在加载，请稍候'}}</text></view>
<view wx:else class="state" aria-role="status"><view class="state-icon"><yx-icon name="{{type==='error'?'refresh':'leaf'}}" tone="green" size="52"/></view><text class="state-title">{{title||(type==='error'?'暂时没有加载出来':'这里还没有记录')}}</text><text wx:if="{{description}}" class="state-description">{{description}}</text><button wx:if="{{action}}" class="state-action" bindtap="act">{{action}}</button></view>
