:host{display:block;}.state{padding:58rpx 28rpx;text-align:center;display:flex;flex-direction:column;align-items:center;}.state-icon{display:flex;align-items:center;justify-content:center;width:102rpx;height:102rpx;border-radius:30rpx;background:#E9EDDF;margin-bottom:24rpx;}.state-title{font-size:32rpx;font-weight:600;line-height:1.5;color:#20352E;}.state-description{display:block;white-space:pre-wrap;max-width:580rpx;font-size:26rpx;line-height:1.85;color:#627060;margin-top:16rpx;}.state-action{display:flex;align-items:center;justify-content:center;background:#20352E;color:#FFFEFA;min-height:92rpx;padding:18rpx 36rpx;border-radius:16rpx;min-width:220rpx;font-size:28rpx;margin-top:30rpx;line-height:1.5;}.state-action::after{border:0;}.state-skeleton{padding:32rpx 0;}.skeleton-line,.skeleton-block{background:#E4E7DC;border-radius:12rpx;}.skeleton-line{height:28rpx;margin:22rpx 0;}.skeleton-line.short{width:40%;}.skeleton-line.middle{width:75%;}.skeleton-block{height:240rpx;border-radius:22rpx;}.loading-label{display:block;color:#627060;font-size:26rpx;text-align:center;margin-top:24rpx;}
