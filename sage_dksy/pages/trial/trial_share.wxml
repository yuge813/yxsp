<view class="ui-page tr-page tr-people-root"><text class="tr-people-kicker">元享 · 好物体验</text><text class="tr-people-title">活动分享记录</text><text class="tr-people-lead">查看此活动已返回的分享用户</text><yx-state wx:if="{{loading&&!loaded}}" type="loading"/><yx-state wx:elif="{{error&&!loaded}}" type="error" title="暂时无法读取记录" description="{{error}}" action="重新加载" bindaction="retry"/><block wx:else><view wx:if="{{error}}" class="ui-error" bindtap="retry">{{error}} · 点击重试</view><view class="tr-people-grid"><view class="tr-person ui-card" wx:for="{{rows}}" wx:key="index"><image wx:if="{{item.headimg&&!item.imageFailed}}" src="{{item.headimg}}" mode="aspectFill" binderror="imageError" data-index="{{index}}"/><view wx:else class="tr-person-placeholder"><yx-icon name="user" tone="muted" size="54"/></view><text>{{item.nickname||'元享用户'}}</text></view></view><yx-state wx:if="{{loaded&&!rows.length}}" type="empty" title="暂无返回的分享记录" description="分享记录以活动实际数据为准"/></block></view>
