<view class="ui-page tr-page trial-root">
 <view class="trial-index-heading"><text class="trial-index-kicker">先试一试，再发现喜欢</text><text class="trial-index-title">新品试用</text><image class="trial-header-mark" src="/sage_dksy/resource/red/hero.png" mode="aspectFit"/></view>
 <view class="tr-pill-tabs"><view class="{{activeTab===0?'active':''}}" data-tab="0" bindtap="switchTrialTab">正在报名</view><view class="{{activeTab===1?'active':''}}" data-tab="1" bindtap="switchTrialTab">即将开始</view><view class="{{activeTab===2?'active':''}}" data-tab="2" bindtap="switchTrialTab">已结束</view></view>
 <yx-state wx:if="{{loading&&!loaded}}" type="loading"/><yx-state wx:elif="{{error&&!loaded}}" type="error" title="试用活动暂时没有加载出来" description="请检查网络后再试一次" action="重新加载" bindaction="retry"/>
 <block wx:else><view wx:if="{{error}}" class="ui-error" bindtap="retry">{{error}} · 点击重试</view>
 <view wx:for="{{filteredTrial}}" wx:key="pro_id" class="trial-feature"><view class="trial-feature-image" data-id="{{item.pro_id}}" bindtap="openTrial"><image wx:if="{{item.pro_picurl&&!item._imageFailed}}" src="{{item.pro_picurl}}" mode="aspectFill" binderror="onTrialImageError" data-id="{{item.pro_id}}"/><yx-icon wx:else name="gift" tone="muted" size="100"/><text class="trial-feature-tag">{{item.isyes=='1'?'新品体验':item.isyes=='0'?'即将开始':'活动已结束'}}</text></view>
 <view class="trial-feature-copy"><text class="trial-feature-title">{{item.pro_title}}</text><text class="trial-feature-desc">先申请，再等待活动公布结果。</text><view class="trial-feature-stats"><view><text>试用名额</text><view><text>{{item.pro_num}}</text><text>份</text></view></view><view><text>{{item.end_time_day?'报名截止':'已申请'}}</text><view><text class="trial-stat-date">{{item.end_time_day||item.apply_num}}</text><text wx:if="{{!item.end_time_day}}">人</text></view></view></view><button class="ui-primary" data-id="{{item.pro_id}}" bindtap="openTrial">{{item.isyes=='1'?'申请试用':'查看活动详情'}}</button></view></view>
 <yx-state wx:if="{{!filteredTrial.length}}" type="empty" title="当前已加载活动中暂无此类试用" description="可切换分类，或继续加载更多活动"/>
 <view wx:if="{{loading}}" class="tr-list-footer">正在加载…</view><button wx:elif="{{hasMore}}" class="ui-text-button" bindtap="onReachBottom">继续加载更多</button><view wx:elif="{{trial.length}}" class="tr-list-footer">已展示全部返回的活动</view></block>
 <view class="tr-notice"><yx-icon name="info" tone="brand" size="36"/><text>申请不等于中选，请以活动实际公布的结果为准。</text></view>
 <navigator class="trial-my-entry" url="/sage_dksy/pages/user/trial_list"><yx-icon name="order" tone="brand" size="48"/><view><text>我的试用</text><text>查看报名、中选与收货资料进度</text></view><yx-icon name="arrow" tone="brand" size="32"/></navigator>
 <view class="tr-ad" wx:if="{{v3Ready&&v3Unit&&activeTab===0}}"><ad-custom unit-id="{{v3Unit}}" bindload="onV3AdLoad" binderror="onV3AdError"/></view>
</view><include src="/sage_dksy/pages/nav/nav.wxml"/>
