@import "../../wxParse/wxParse.wxss";
.trial-detail{background:#F5F3ED;min-height:100vh}.trial-detail-photo{height:560rpx;background:#E9ECE1;position:relative}.trial-detail-photo>image{width:100%;height:100%;display:block}.trial-detail-photo>view{height:100%;display:flex;align-items:center;justify-content:center}.trial-detail-photo>text{position:absolute;left:32rpx;bottom:30rpx;padding:12rpx 20rpx;border-radius:12rpx;background:#FFFEFA;color:#20352E;font-size:26rpx}.detail-body{padding-bottom:calc(190rpx + env(safe-area-inset-bottom))}.detail-title{display:block;font-size:44rpx;font-weight:650;line-height:1.45;margin:18rpx 0 32rpx;color:#20352E;word-break:break-all}.detail-metrics{padding:30rpx 18rpx;display:flex;justify-content:space-between;margin-bottom:22rpx}.detail-metrics>view{display:flex;flex:1;flex-direction:column;align-items:center;gap:14rpx;border-right:1rpx solid #DFE3D6}.detail-metrics>view:last-child{border:0}.detail-metrics>view>text:first-child{font-size:40rpx;font-weight:650;color:#20352E}.detail-metrics>view>text:last-child{font-size:24rpx;color:#65725D}.detail-dates{padding:28rpx}.detail-dates>view{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:26rpx;color:#64705D;line-height:1.6}.detail-dates>view+view{margin-top:24rpx}.detail-dates>view>text:last-child{color:#20352E;text-align:right}.detail-steps{display:flex;gap:12rpx;margin:24rpx 0}.detail-steps>view{flex:1;background:#E7EBDD;border-radius:18rpx;padding:24rpx 12rpx;display:flex;flex-direction:column;align-items:center;gap:12rpx;color:#20352E}.detail-steps>view>text:first-child{font-size:34rpx;font-weight:650;color:#BF442A}.detail-steps>view>text:last-child{font-size:26rpx}.detail-note{display:block;font-size:26rpx;color:#64705D;line-height:1.8;margin:24rpx 4rpx}.detail-rich{padding:28rpx;font-size:30rpx;line-height:1.85;overflow:hidden}.detail-rich image{max-width:100%}.flow-image{width:100%;display:block;margin:24rpx 0}.detail-ad{margin:32rpx 0}.detail-share{display:flex;gap:18rpx;margin-top:30rpx}.detail-share>button{flex:1;min-height:92rpx;line-height:92rpx;background:#E8EBDD;border-radius:18rpx;color:#20352E;font-size:28rpx}.detail-fixed{position:fixed;left:0;right:0;bottom:0;padding:22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));background:#FFFEFA;border-top:1rpx solid #E0E3D7;z-index:30}
