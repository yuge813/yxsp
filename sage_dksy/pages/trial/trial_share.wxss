.people-page>.ui-title{display:block;margin:24rpx 0 16rpx;font-size:48rpx}.people-page>.ui-lead{display:block;color:#65735C;line-height:1.8;margin-bottom:36rpx}.people-grid{display:flex;flex-wrap:wrap;justify-content:space-between}.person{width:48%;margin-bottom:24rpx;padding:30rpx 18rpx;display:flex;align-items:center;flex-direction:column;gap:20rpx;min-width:0}.person>image,.person-placeholder{height:106rpx;width:106rpx;border-radius:50%;background:#E7EBDD;display:flex;align-items:center;justify-content:center}.person>text{max-width:100%;word-break:break-all;font-size:28rpx;line-height:1.5;color:#20352E;text-align:center}
