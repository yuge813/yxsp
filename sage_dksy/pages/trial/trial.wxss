.trial-hero{position:relative;background:#20352E;border-radius:32rpx;padding:40rpx 34rpx;color:#FFFEFA;overflow:hidden;margin-bottom:32rpx}.trial-hero .ui-kicker{color:#C9D4BC}.trial-hero .ui-title{display:block;font-size:52rpx;margin:20rpx 0 16rpx;max-width:520rpx}.trial-hero .ui-lead{color:#DFE4D8;font-size:26rpx;max-width:480rpx;line-height:1.7}.trial-hero>yx-icon{position:absolute;right:-16rpx;bottom:-10rpx;opacity:.12}.trial-switch{display:flex;border-bottom:1rpx solid #DCDDD2;gap:48rpx;margin-bottom:24rpx;font-size:30rpx;color:#697263}.trial-switch>navigator,.trial-switch>view{padding:16rpx 0 22rpx;min-height:88rpx}.trial-switch .selected{color:#20352E;font-weight:700;border-bottom:4rpx solid #BF442A}.trial-tabs{display:flex;gap:12rpx;margin-bottom:28rpx}.trial-tabs>view{flex:1;min-height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;background:#EAECE1;color:#62705D;font-size:28rpx}.trial-tabs .on{background:#20352E;color:#FFFEFA}.trial-card{display:block;background:#FFFEFA;border:1rpx solid #E1E2D7;border-radius:28rpx;overflow:hidden;margin-bottom:28rpx}.trial-photo{height:330rpx;background:#EAECE1;position:relative}.trial-photo>image{width:100%;height:100%;display:block}.trial-placeholder{height:100%;display:flex;align-items:center;justify-content:center}.trial-status{position:absolute;top:22rpx;left:22rpx;background:#FFFEFA;color:#20352E;border-radius:10rpx;padding:10rpx 16rpx;font-size:24rpx;font-weight:600}.trial-copy{padding:26rpx}.trial-name{display:block;color:#20352E;font-size:34rpx;font-weight:650;line-height:1.5;word-break:break-all}.trial-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;gap:12rpx}.trial-bottom>view{display:flex;flex-direction:column;gap:12rpx;color:#62705D;font-size:25rpx}.trial-action{color:#C44A2F;display:flex;align-items:center;gap:4rpx;font-size:26rpx}.list-footer{text-align:center;padding:28rpx;color:#67735F;font-size:25rpx}.yx44-inline-ad{margin:32rpx 0;position:relative}
