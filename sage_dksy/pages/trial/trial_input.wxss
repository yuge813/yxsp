.apply-page .ui-title{display:block;margin:24rpx 0 16rpx;font-size:48rpx}.apply-page .ui-lead{display:block;margin-bottom:36rpx;color:#63725B;line-height:1.7}.apply-product{display:flex;gap:28rpx;align-items:center;padding:26rpx;margin-bottom:28rpx}.apply-product>image,.apply-placeholder{height:168rpx;width:168rpx;flex-shrink:0;border-radius:18rpx;background:#E8EBDD}.apply-placeholder{display:flex;align-items:center;justify-content:center}.apply-product>text{font-size:32rpx;font-weight:600;line-height:1.5;color:#20352E;word-break:break-all}.apply-rules{padding:30rpx;margin-bottom:38rpx}.apply-heading{display:flex;gap:14rpx;align-items:center;font-size:32rpx;font-weight:600;color:#20352E;margin-bottom:20rpx}.apply-rules>view:not(.apply-heading){display:flex;gap:20rpx;font-size:28rpx;line-height:1.8;margin:22rpx 0;color:#5F6F58}.apply-rules>view:not(.apply-heading)>text:first-child{font-size:25rpx;color:#CB4F32;font-weight:600;flex-shrink:0}
.apply-records{display:flex;align-items:center;justify-content:center;margin-top:22rpx}
