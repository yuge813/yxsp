.favorites-heading{display:flex;align-items:center;gap:20rpx;padding:16rpx 0 34rpx}.favorites-heading>view:first-child{flex:1;min-width:0}.favorites-heading .ui-title{display:block;margin:14rpx 0}.favorites-heading .ui-lead{font-size:26rpx;line-height:1.7}.favorites-mark{width:114rpx;height:134rpx;background:#E2E8D7;border-radius:48% 48% 30% 30%;display:flex;align-items:center;justify-content:center;transform:rotate(8deg);flex-shrink:0}.favorites-label{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #D8DFCD;margin-top:6rpx}.favorites-label>text{font-size:27rpx;font-weight:600}.favorites-label button{display:flex;align-items:center;gap:4rpx;font-size:24rpx;color:#65745F;padding:0;margin:0}.favorite-item{display:flex;align-items:flex-start;gap:22rpx;padding:30rpx 0;border-bottom:1rpx solid #DDE3D2}.favorite-copy{min-width:0;flex:1;display:flex;flex-direction:column}.favorite-source{font-size:23rpx;color:#65745F;line-height:1.5;margin-bottom:12rpx}.favorite-title{font-size:32rpx;line-height:1.55;font-weight:650;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.favorite-summary{font-size:25rpx;line-height:1.7;color:#65745F;margin-top:12rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.favorite-cover{width:186rpx;height:168rpx;background:#E7EADC;border-radius:18rpx;flex-shrink:0;margin-top:2rpx}.favorite-image-empty{display:flex;align-items:center;justify-content:center}.favorites-error{margin:22rpx 0;padding:22rpx;border-radius:18rpx;background:#F8E7DB;color:#924431;font-size:25rpx;line-height:1.7}.favorites-end{font-size:24rpx;color:#65745F;text-align:center;margin:32rpx 0}
