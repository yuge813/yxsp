.settings-page{background:#FFF6F5}.settings-brand{text-align:center;padding:44rpx 0 56rpx}.settings-brand-logo{display:flex;align-items:center;justify-content:center;width:154rpx;height:154rpx;padding:10rpx;background:#FFFDF8;border:2rpx solid #F2D9B8;border-radius:40rpx;margin:0 auto 20rpx;box-shadow:0 14rpx 35rpx #A4313A15}.settings-brand-logo>image{width:100%;height:100%;display:block}.settings-brand>.settings-brand-name{display:block;font-size:40rpx;font-weight:750;color:#27212C;line-height:1.4;margin-bottom:10rpx}.settings-brand>text{font-size:26rpx;color:#806574}.settings-card{background:#fff;border:1rpx solid #F1DEE7;border-radius:30rpx;margin-bottom:28rpx;padding:0 26rpx}.settings-row{width:100%;display:flex;align-items:center;gap:20rpx;min-height:118rpx;border-bottom:1rpx solid #F3E5EC;text-align:left}.settings-row:last-child{border:0}.settings-row>view{width:64rpx;height:64rpx;background:#FFF0F3;border-radius:18rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.settings-row>text{flex:1;font-size:28rpx;font-weight:500}.settings-row>text.settings-hint{font-size:24rpx;flex:none;color:#806574}.settings-note{display:flex;align-items:flex-start;gap:16rpx;font-size:24rpx;line-height:1.9;color:#806574;padding:26rpx 10rpx 48rpx}.settings-note>text>text{display:block}.settings-note>yx-icon{margin-top:8rpx}
