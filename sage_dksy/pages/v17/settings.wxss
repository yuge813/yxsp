.settings-page{background:#FFF6F5}.settings-brand{text-align:center;padding:44rpx 0 56rpx}.settings-brand>view{display:flex;align-items:center;justify-content:center;width:128rpx;height:128rpx;background:linear-gradient(145deg,#F42B3A,#C6083D);border-radius:36rpx;font-size:42rpx;font-weight:750;color:#fff;margin:0 auto 25rpx;box-shadow:0 14rpx 35rpx #D30F3C22}.settings-brand>text{font-size:26rpx;color:#806574}.settings-card{background:#fff;border:1rpx solid #F1DEE7;border-radius:30rpx;margin-bottom:28rpx;padding:0 26rpx}.settings-row{width:100%;display:flex;align-items:center;gap:20rpx;min-height:118rpx;border-bottom:1rpx solid #F3E5EC;text-align:left}.settings-row:last-child{border:0}.settings-row>view{width:64rpx;height:64rpx;background:#FFF0F3;border-radius:18rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.settings-row>text{flex:1;font-size:28rpx;font-weight:500}.settings-row>text.settings-hint{font-size:24rpx;flex:none;color:#806574}.settings-note{display:flex;align-items:flex-start;gap:16rpx;font-size:24rpx;line-height:1.9;color:#806574;padding:26rpx 10rpx 48rpx}.settings-note>text>text{display:block}.settings-note>yx-icon{margin-top:8rpx}
