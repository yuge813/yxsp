.settings-heading{padding:16rpx 0 40rpx}.settings-heading .ui-title{display:block;margin:14rpx 0}.settings-section{display:block;font-size:25rpx;color:#687566;margin:16rpx 8rpx 18rpx}.settings-card{padding:0 24rpx;margin-bottom:32rpx}.settings-row{display:flex;align-items:center;gap:22rpx;padding:30rpx 0;border-bottom:1rpx solid #E2E7D7;color:#20352E;min-height:120rpx}.settings-row:last-child{border-bottom:0}.settings-row>view{display:flex;flex:1;min-width:0;flex-direction:column;gap:10rpx}.settings-row>view>text:first-child{font-size:30rpx;font-weight:500}.settings-row>view>text:last-child{font-size:24rpx;color:#687566;line-height:1.6}.settings-contact{width:100%;padding-left:0;padding-right:0;line-height:1.5;text-align:left;margin:0;background:transparent;border-radius:0;font-weight:400}.settings-notice{display:flex;align-items:flex-start;gap:15rpx;margin:36rpx 10rpx;font-size:25rpx;color:#62745B;line-height:1.8}.settings-notice>text{flex:1}.settings-home{margin-top:44rpx}
