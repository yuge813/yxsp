<view class="ui-page favorites-page"><view class="favorites-heading"><view><text class="ui-kicker">喜欢的内容，留在这里</text><text class="ui-title">我的收藏</text><text class="ui-lead">再读一遍，也许有新的发现。</text></view><view class="favorites-mark"><yx-icon name="heart" tone="green" size="70"/></view></view>
  <view class="favorites-label"><text>已收藏文章</text><button class="ui-text-button" bindtap="goRead">发现更多 <yx-icon name="arrow" tone="muted" size="24"/></button></view>
  <yx-state wx:if="{{loading&&!loaded}}" type="loading"/><yx-state wx:elif="{{error&&!loaded}}" type="error" title="收藏暂未加载" description="{{error}}" action="重新加载" bindaction="retry"/><yx-state wx:elif="{{loaded&&!items.length&&!error}}" type="empty" title="把喜欢的文章留一份" description="阅读时点击收藏，就能在这里再次找到它。" action="去读点好内容" bindaction="goRead"/>
  <view wx:else class="favorites-list"><view class="favorite-item" wx:for="{{items}}" wx:key="id" bindtap="open" data-id="{{item.id}}"><view class="favorite-copy"><text class="favorite-source">{{item.source||'元享阅读'}}</text><text class="favorite-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="favorite-summary">{{item.summary}}</text></view><image wx:if="{{item.cover_url&&!item.imageFailed}}" class="favorite-cover" src="{{item.cover_url}}" mode="aspectFill" lazy-load="true" binderror="imageError" data-id="{{item.id}}"/><view wx:else class="favorite-cover favorite-image-empty"><yx-icon name="book" tone="green" size="54"/></view></view></view>
  <view wx:if="{{error&&loaded}}" class="favorites-error" bindtap="retry">{{error}}　重新加载</view><button wx:if="{{loaded&&items.length&&more&&!error}}" class="ui-text-button" bindtap="loadMore" loading="{{loading}}" disabled="{{loading}}">{{loading?'正在读取':'加载更多收藏'}}</button><view wx:if="{{loaded&&items.length&&!more}}" class="favorites-end">喜欢的内容，随时回来读。</view>
</view>
