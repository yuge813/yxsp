<view class="directory-page ui-page"><view class="directory-intro"><text class="ui-kicker">元享 / 服务目录</text><view class="ui-title">想用的功能，<text>在这里找到。</text></view></view><view class="directory-search"><yx-icon name="search" tone="muted" size="36"/><input value="{{q}}" bindinput="onSearch" placeholder="搜索签到、兑换、订单等功能" confirm-type="search"/><button wx:if="{{q}}" bindtap="clear" aria-label="清除搜索"><yx-icon name="close" tone="muted" size="32"/></button></view><block wx:if="{{q}}"><text class="directory-result-label">功能搜索结果</text><view wx:if="{{results.length}}" class="directory-results ui-card"><view wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="open" class="directory-result"><view><yx-icon name="{{item.uiIcon}}" tone="green" size="42"/></view><text>{{item.name}}</text><yx-icon name="arrow" tone="muted" size="28"/></view></view><yx-state wx:else type="empty" title="没有找到相关功能" description="试试其他名称，或清除关键词查看全部" action="清除搜索" bindaction="clear"/></block><block wx:else><view wx:if="{{recent.length}}" class="directory-recent"><view class="ui-section-head"><text>最近使用</text></view><view class="directory-recent-grid"><view wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view><yx-icon name="{{item.uiIcon}}" tone="green" size="42"/></view><text>{{item.name}}</text></view></view></view><view class="ui-section-head"><text>按分类查找</text></view><scroll-view scroll-x="true" class="directory-tabs" show-scrollbar="false"><view class="directory-tab-row"><view wx:for="{{groups}}" wx:key="*this" class="directory-tab {{group===item?'is-active':''}}" data-group="{{item}}" bindtap="choose">{{item}}</view></view></scroll-view><view class="directory-grid"><view class="directory-feature ui-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="directory-feature-top"><yx-icon name="{{item.uiIcon}}" tone="green" size="50"/><yx-icon name="arrow" tone="muted" size="27"/></view><text>{{item.name}}</text></view></view></block></view>
