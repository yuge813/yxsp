page{background:#FFF6F5}.directory-intro{padding:20rpx 0 38rpx}.directory-intro .ui-title{font-size:56rpx;line-height:1.35;margin-top:24rpx;letter-spacing:-1rpx}.directory-intro .ui-title text{display:block}.directory-search{display:flex;align-items:center;gap:16rpx;height:96rpx;background:#FFF0F3;padding:0 24rpx;border-radius:18rpx;margin-bottom:34rpx}.directory-search input{flex:1;min-width:0;font-size:25rpx;color:#27212C}.directory-search button{padding:0;margin:0;min-height:88rpx;width:64rpx;background:transparent;display:flex;align-items:center;justify-content:center}.directory-result-label{font-size:25rpx;color:#806574;display:block;margin:18rpx 0 24rpx}.directory-results{padding:0 26rpx}.directory-result{display:flex;align-items:center;gap:22rpx;min-height:124rpx;border-bottom:1rpx solid #F2DFE6}.directory-result:last-child{border-bottom:0}.directory-result>view{height:68rpx;width:68rpx;display:flex;align-items:center;justify-content:center;background:#806574;border-radius:20rpx;flex-shrink:0}.directory-result>text{flex:1;font-size:30rpx;color:#27212C;line-height:1.6}.directory-recent{margin-bottom:30rpx}.directory-recent-grid{display:flex;gap:12rpx;flex-wrap:wrap}.directory-recent-grid>view{width:calc(33.333% - 8rpx);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:18rpx;padding:20rpx 6rpx}.directory-recent-grid>view>view{width:80rpx;height:80rpx;background:#FFE7EE;border-radius:22rpx;display:flex;align-items:center;justify-content:center}.directory-recent-grid text{font-size:25rpx;color:#27212C}.directory-tabs{white-space:nowrap;margin:20rpx 0 28rpx}.directory-tab-row{display:flex;gap:16rpx}.directory-tab{display:flex;align-items:center;justify-content:center;padding:0 26rpx;min-height:88rpx;background:#FFF0F3;color:#806574;font-size:26rpx;border-radius:18rpx;flex-shrink:0}.directory-tab.is-active{color:#FFFFFF;background:#27212C}.directory-grid{display:flex;flex-wrap:wrap;gap:22rpx}.directory-feature{width:calc(50% - 11rpx);