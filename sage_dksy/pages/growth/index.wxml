<view class="growth-page">
 <view class="growth-hero"><view class="growth-hero-top"><text>元享 · 给坚持一点期待</text><view bindtap="goRules">礼遇说明 <yx-icon name="arrow" tone="light" size="24"/></view></view><view class="growth-hero-title">把7天坚持，<text>变成一份期待。</text></view><text class="growth-hero-copy">日常慢慢积累，成长清楚可见。</text><image src="/sage_dksy/resource/red/hero.png" mode="aspectFit"/><view class="growth-hero-pill"><yx-icon name="gift" tone="light" size="30"/><text>7天成长礼遇</text></view></view>
 <view class="growth-body">
  <yx-state wx:if="{{loading&&!loaded}}" type="loading" title="正在同步成长进度"/>
  <yx-state wx:elif="{{message&&!loaded}}" type="error" title="成长信息暂未加载" description="{{message}}" action="重新连接" bindaction="ensureLogin"/>
  <block wx:if="{{loaded}}">
   <view wx:if="{{message}}" class="ui-error" bindtap="ensureLogin">{{message}} · 点击刷新核对</view><view wx:if="{{lastActionMessage}}" class="growth-receipt"><yx-icon name="yes" tone="brand" size="34"/><text>{{lastActionMessage}}</text><text bindtap="goLedger">明细 ›</text></view>
   <view class="growth-progress-card">
    <view class="growth-section-top"><view><text>我的7天成长</text><text>{{!growth.known?'参与状态待同步':growth.joined?'记录每一次坚持':'从今天，开启一份期待'}}</text></view><view class="growth-status">{{!growth.known?'待同步':growth.joined?'已参与':'未开启'}}</view></view>
    <view class="growth-count"><view><text>{{growth.joined?(growth.doneCount===null?'—':growth.doneCount):'7'}}</text><text>{{growth.joined?' / 7 天':'天成长旅程'}}</text></view><text wx:if="{{growth.joined&&(growth.startDay||growth.endDay)}}">{{growth.startDay}}<text wx:if="{{growth.startDay&&growth.endDay}}"> — </text>{{growth.endDay}}</text><text wx:elif="{{growth.joined}}">成长周期以实际状态为准</text><text wx:else>开启后查看本期实际进度</text></view>
    <view wx:if="{{growth.joined}}" class="growth-days"><view wx:for="{{growth.days}}" wx:key="index" class="growth-day {{item.state}}"><text>第{{item.index}}天</text><view><yx-icon wx:if="{{item.state==='done'}}" name="yes" tone="light" size="30"/><yx-icon wx:elif="{{item.index===7}}" name="gift" tone="brand" size="30"/><text wx:else>{{item.index}}</text></view><text>{{item.date||'—'}}</text></view></view>
    <view wx:if="{{growth.joined&&growth.doneCount!==null}}" class="growth-progress-track"><view style="width:{{growth.progress}}%"></view></view><view class="growth-independent"><yx-icon name="info" tone="brand" size="30"/><text>成长进度与每日连续签到分别统计。</text></view>
    <button wx:if="{{growth.canStart}}" class="ui-primary growth-start-button" bindtap="join" disabled="{{busy||loading||!!message||actionUnknown}}" loading="{{busy}}">{{growth.joined?'开启新的7天计划':'开启我的7天计划'}}</button><button wx:elif="{{!growth.known}}" class="ui-secondary growth-start-button" bindtap="ensureLogin" disabled="{{loading}}">重新同步参与状态</button>
   </view>
   <view class="growth-section-heading"><view><text>成长礼遇</text><text>达到条件后，自主领取</text></view><view bindtap="goRules">了解规则 ›</view></view>
   <view class="growth-milestones"><view wx:for="{{growth.milestones}}" wx:key="day" class="growth-milestone {{item.day===7?'seventh':''}}"><view class="growth-milestone-head"><text>第 {{item.day}} 天</text><yx-icon name="{{item.day===7?'gift':'coin'}}" tone="brand" size="42"/></view><text class="growth-milestone-name">{{item.day===7?'7天成长礼遇':'3天阶段礼遇'}}</text><view wx:if="{{item.amount!==null&&(item.enabled||item.claimed)}}" class="growth-milestone-amount">{{item.amount}}<text>金币</text></view><view wx:else class="growth-milestone-unknown">{{item.enabled?'金额待同步':'以活动公布为准'}}</view><text class="growth-milestone-copy">{{item.claimed?'已领取，可在明细核对':item.enabled?'实际资格以当前状态为准':'本节点当前未开放领取'}}</text><button class="growth-claim {{item.canClaim?'ready':''}}" bindtap="claim" data-milestone="{{item.day}}" disabled="{{!item.canClaim||busy||loading||!!message||actionUnknown}}" loading="{{busy}}">{{item.label}}</button></view></view>
   <view class="growth-rules-card"><view class="growth-section-top"><view><text>礼遇怎么参与？</text><text>先了解，再按自己的节奏来</text></view><yx-icon name="shield" tone="brand" size="44"/></view><view class="growth-rule"><text>01</text><view><text>自主开启7天计划</text><text>开启后，查看本期成长记录和进度。</text></view></view><view class="growth-rule"><text>02</text><view><text>签到与成长，分别记账</text><text>每天可前往签到；成长记录、周期及达成条件以当前实际状态为准。</text></view></view><view class="growth-rule"><text>03</text><view><text>达到条件，领取已开放礼遇</text><text>3天、7天节点是否开放、金额和领取资格均按实际活动显示，不承诺固定奖励。</text></view></view><view class="growth-rule"><text>04</text><view><text>到账以后，明细可查</text><text>基础签到与成长额外金币独立结算，以服务端确认和实际明细为准。</text></view></view><view class="growth-rule-link" bindtap="goRules">查看完整成长说明 <yx-icon name="arrow" tone="brand" size="26"/></view></view>
   <view class="growth-panel"><view class="growth-section-top"><view><text>和好友一起坚持</text><text>自愿同行，彼此多一点动力</text></view><yx-icon name="friend" tone="brand" size="44"/></view><view wx:if="{{incomingInvite&&!friend.paired}}" class="growth-incoming"><text>你收到一份同行邀请</text><text>接受后，双方可看到近7天签到进度；可随时退出，不影响个人奖励。</text><button class="ui-primary" bindtap="acceptInvite" disabled="{{busy||loading||!!message}}">同意加入同行</button><button class="ui-text-button" bindtap="dismissInvite">暂不加入</button></view><view wx:elif="{{friend.paired}}"><view class="growth-friend"><view><yx-icon name="user" tone="brand" size="46"/></view><view><text>我的同行好友</text><text>近7天已签到 {{friend.peer_days===null?'—':friend.peer_days}} 天</text></view></view><button class="ui-text-button" bindtap="leavePair" disabled="{{busy||loading||!!message}}">退出同行关系</button></view><view wx:else><text class="growth-panel-copy">同行仅用于自愿共享近7天签到进度，与推广一级关系分别管理。</text><button wx:if="{{!inviteCode}}" class="ui-secondary" bindtap="makeInvite" disabled="{{busy||loading||!!message}}">生成同行邀请</button><button wx:else class="ui-secondary" open-type="share">分享同行邀请</button></view></view>
   <view class="growth-panel"><view class="growth-section-top"><view><text>为喜欢的好礼积累</text><text>设置心愿，给积累一个方向</text></view><view class="growth-balance">{{balance===null?'—':balance}} 金币</view></view><view wx:if="{{wish}}" class="growth-wish"><image wx:if="{{wish.prize_picurl&&!missingWishImage}}" src="{{wish.prize_picurl}}" mode="aspectFill" binderror="onWishImageError"/><view wx:else class="growth-wish-placeholder"><yx-icon name="gift" tone="brand" size="52"/></view><view><text>{{wish.prize_title||'我的心愿好礼'}}</text><text>目标 {{wish._cost===null?'待同步':wish._cost+' 金币'}}</text><text>{{wishRemaining===null?'余额或目标待同步':wishRemaining===0?'已达到兑换金币目标':'还差 '+wishRemaining+' 金币'}}</text></view></view><view wx:if="{{wish&&wishRemaining!==null}}" class="growth-progress-track"><view style="width:{{wishPercent}}%"></view></view><text wx:elif="{{!wish}}" class="growth-panel-copy">选择真实在售商品作为心愿，商品价格与库存以详情页为准。</text><scroll-view wx:if="{{prizes.length}}" scroll-x="true" class="growth-choices" show-scrollbar="{{false}}"><view class="growth-choice-row"><view wx:for="{{prizes}}" wx:key="prize_id" class="growth-choice" data-id="{{item.prize_id}}" bindtap="chooseWish"><image wx:if="{{item.prize_picurl&&!item._missingImage}}" src="{{item.prize_picurl}}" mode="aspectFill" data-id="{{item.prize_id}}" binderror="onChoiceImageError"/><view wx:else class="growth-choice-empty"><yx-icon name="gift" tone="brand" size="44"/></view><text>{{item.prize_title}}</text><text>{{item._cost===null?'价格待同步':item._cost+' 金币'}}</text></view></view></scroll-view><text class="growth-small-note">设置心愿仅保存目标，不会扣除金币或自动兑换。</text></view>
   <yx22-ad placement="growth_banner"/>
   <view wx:if="{{activities.length}}" class="growth-panel"><view class="growth-section-top"><view><text>近期试用活动</text><text>有新发现，也有新期待</text></view><yx-icon name="bag" tone="brand" size="42"/></view><view wx:for="{{activities}}" wx:key="pro_id" class="growth-event" data-id="{{item.pro_id}}" bindtap="goTrial"><view><text>{{item.pro_title}}</text><text>{{item.is_open==1?'正在报名':'查看活动'}}<text wx:if="{{item.pro_num!==undefined&&item.pro_num!==null}}"> · 名额 {{item.pro_num}} 份</text></text><text wx:if="{{item.end_label}}">{{item.end_label}} 截止报名</text></view><yx-icon name="arrow" tone="muted" size="26"/></view></view>
  </block>
  <view class="growth-bottom-note">成长礼遇与推广奖励分别按各自活动规则计算。</view>
 </view>
 <view class="growth-footer-spacer"></view><view class="growth-footer"><button class="growth-footer-ledger" bindtap="goLedger"><yx-icon name="coin" tone="brand" size="34"/><text>金币明细</text></button><button class="ui-primary" bindtap="goSign">去每日签到 <yx-icon name="arrow" tone="light" size="30"/></button></view>
</view>
