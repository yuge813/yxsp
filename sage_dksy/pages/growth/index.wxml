<view class="growth-page ui-page">
 <view class="growth-intro"><text class="ui-kicker">元享成长 / 给坚持一点期待</text><view class="ui-title">让日常，<text>慢慢长出好事。</text></view><text class="ui-lead">签到、同行、心愿，按自己的节奏来。</text></view>
 <yx-state wx:if="{{loading&&!loaded}}" type="loading" title="正在读取成长进度"/>
 <yx-state wx:elif="{{message&&!loaded}}" type="error" title="成长信息暂时没有加载出来" description="{{message}}" action="重新连接" bindaction="ensureLogin"/>
 <block wx:if="{{loaded}}">
  <view wx:if="{{message}}" class="ui-error" bindtap="ensureLogin">更新未成功，已保留上次进度 · 点击重试</view>
  <view class="growth-challenge"><view class="growth-card-head"><view><text class="growth-number">01 / 坚持</text><view class="growth-title">7天成长计划</view></view><view class="growth-chip">独立成长记录</view></view>
   <block wx:if="{{challenge.joined}}"><view class="growth-progress-caption"><view><text class="growth-progress-big">{{challenge.done_count===undefined?'—':challenge.done_count}}</text><text> / 7 天</text></view><text>{{challenge.start_day}} — {{challenge.end_day}}</text></view><view class="growth-days"><view wx:for="{{challenge.days}}" wx:key="index" class="growth-day {{item.done?'done':''}} {{item.today?'today':''}}"><text>第{{item.index}}天</text><view><yx-icon wx:if="{{item.done}}" name="yes" tone="light" size="30"/><text wx:else>{{item.index}}</text></view><text>{{item.date}}</text></view></view><text class="growth-explain">成长计划与每日连续签到分别统计。</text>
    <view wx:if="{{challenge.reward_enabled||challenge.claimed3||challenge.claimed7}}" class="growth-milestones"><view wx:if="{{challenge.day3_enabled||challenge.claimed3}}" class="growth-milestone"><view><text>坚持3天</text><text>额外 {{challenge.three_points}} 金币</text></view><button class="growth-claim" disabled="{{!challenge.can_claim3||busy}}" loading="{{busy}}" data-milestone="3" bindtap="claim">{{challenge.claimed3?'已领取':challenge.can_claim3?'领取奖励':'待达成'}}</button></view><view wx:if="{{challenge.day7_enabled||challenge.claimed7}}" class="growth-milestone"><view><text>坚持7天</text><text>额外 {{challenge.seven_points}} 金币</text></view><button class="growth-claim" disabled="{{!challenge.can_claim7||busy}}" loading="{{busy}}" data-milestone="7" bindtap="claim">{{challenge.claimed7?'已领取':challenge.can_claim7?'领取奖励':'待达成'}}</button></view></view><button wx:if="{{challenge.can_start}}" class="growth-join" bindtap="join" disabled="{{busy}}" loading="{{busy}}">开启新的7天计划</button>
   </block><view wx:else class="growth-start"><view class="growth-seven">7<text>天 / 给坚持一个开始</text></view><text>每天签到，查看自己的成长进度。</text><button class="growth-join" bindtap="join" disabled="{{busy}}" loading="{{busy}}">开启我的7天计划</button></view>
  </view>
  <view class="growth-panel ui-card"><view class="growth-card-head"><view><text class="growth-number">02 / 同行</text><view class="growth-title">和好友一起坚持</view></view><yx-icon name="friend" tone="green" size="48"/></view><view wx:if="{{incomingInvite&&!friend.paired}}" class="growth-incoming"><view>你收到一份同行邀请</view><text>接受后，双方可看到近7天签到天数，可随时退出。</text><button class="ui-primary" bindtap="acceptInvite" disabled="{{busy}}" loading="{{busy}}">同意加入</button><button class="ui-text-button" bindtap="dismissInvite">暂不加入</button></view><view wx:elif="{{friend.paired}}"><view class="growth-friend"><view><yx-icon name="user" tone="green" size="48"/></view><view><text>同行好友</text><text>近7天已签到 {{friend.peer_days}} 天</text></view></view><button class="ui-text-button" bindtap="leavePair">退出同行关系</button></view><view wx:else><text class="growth-panel-copy">分享一份坚持，彼此多一点动力。</text><button wx:if="{{!inviteCode}}" class="ui-secondary" bindtap="makeInvite" disabled="{{busy}}">生成同行邀请</button><button wx:else class="ui-secondary" open-type="share">分享同行邀请</button></view></view>
  <view class="growth-panel ui-card"><view class="growth-card-head"><view><text class="growth-number">03 / 心愿</text><view class="growth-title">为喜欢的好礼积累</view></view><view class="growth-balance">{{balance===null?'—':balance}} 金币</view></view><view wx:if="{{wish}}" class="growth-wish"><image wx:if="{{wish.prize_picurl&&!missingWishImage}}" src="{{wish.prize_picurl}}" mode="aspectFill" binderror="onWishImageError"/><view wx:else class="growth-wish-image"><yx-icon name="gift" tone="green" size="52"/></view><view><text>{{wish.prize_title}}</text><text>目标 {{wish.prize_integral}} 金币</text><text>{{balance===null?'余额待同步':wishRemaining===0?'已达到兑换金币目标':'还差 '+wishRemaining+' 金币'}}</text></view></view><view wx:if="{{wish&&balance!==null}}" class="growth-progress-track"><view style="width:{{wishPercent}}%"></view></view><text wx:else class="growth-panel-copy">从在售商品中挑一件心仪好物，给积累一个具体的期待。</text><scroll-view wx:if="{{prizes.length}}" scroll-x="true" class="growth-choices" show-scrollbar="{{false}}"><view class="growth-choice-row"><view wx:for="{{prizes}}" wx:key="prize_id" class="growth-choice" data-id="{{item.prize_id}}" bindtap="chooseWish"><image wx:if="{{item.prize_picurl&&!item._missingImage}}" src="{{item.prize_picurl}}" mode="aspectFill" data-id="{{item.prize_id}}" binderror="onChoiceImageError"/><view wx:else class="growth-choice-empty"><yx-icon name="gift" tone="green" size="44"/></view><text>{{item.prize_title}}</text><text>{{item.prize_integral}} 金币</text></view></view></scroll-view></view>
  <yx22-ad placement="growth_banner"/>
  <view class="growth-panel ui-card"><view class="growth-card-head"><view><text class="growth-number">04 / 发现</text><view class="growth-title">近期试用活动</view></view><yx-icon name="gift" tone="green" size="44"/></view><view wx:if="{{!activities.length}}" class="growth-panel-copy">近期暂无新的试用活动，之后再来看看。</view><view wx:for="{{activities}}" wx:key="pro_id" class="growth-event" data-id="{{item.pro_id}}" bindtap="goTrial"><view><text>{{item.pro_title}}</text><text>{{item.is_open?'正在报名':'即将开始'}} · 名额 {{item.pro_num}} 份</text><text>{{item.end_label}} 截止报名</text></view><yx-icon name="arrow" tone="muted" size="30"/></view></view>
 </block>
</view>
