<view class="ui-page profile-page"><view class="profile-heading"><text class="ui-kicker">让元享，多一点你的样子</text><text class="ui-title">个人资料</text><text class="ui-lead">头像与昵称，随时自主完善。</text></view>
  <yx-state wx:if="{{profileBusy&&!profileLoaded}}" type="loading"/>
  <view wx:else class="profile-form ui-card"><view class="profile-avatar-wrap"><button class="profile-avatar-button" bindchooseavatar="upface" disabled="{{avatarBusy}}" open-type="chooseAvatar"><image wx:if="{{avatarPreview||userinfo.headimg}}" src="{{avatarPreview||userinfo.headimg}}" mode="aspectFill"/><view wx:else class="profile-avatar-placeholder"><yx-icon name="user" tone="green" size="76"/></view><view class="profile-avatar-edit"><yx-icon name="image" tone="light" size="24"/></view></button><text>{{avatarBusy?'头像正在保存…':'点击选择微信头像'}}</text><button class="ui-text-button profile-album" bindtap="chooseAlbumAvatar" disabled="{{avatarBusy}}">从手机相册选择</button></view><view class="profile-field"><text>昵称</text><input type="nickname" class="ui-input" value="{{nickname}}" bindinput="changename" bindblur="nicknamereview" maxlength="30" placeholder="你想被怎样称呼" disabled="{{profileBusy}}"/><text>最多30个字，选择你喜欢的名字。</text></view></view>
  <view wx:if="{{profileError}}" class="profile-error"><yx-icon name="info" tone="brand" size="32"/><text>{{profileError}}</text><button class="ui-text-button" bindtap="refreshProfile" disabled="{{profileBusy||avatarBusy}}">重试读取</button></view>
  <button class="ui-primary profile-save" bindtap="tijiao" disabled="{{profileBusy||avatarBusy}}" loading="{{profileBusy}}">保存昵称</button><button class="ui-text-button profile-skip" bindtap="skipProfile">暂不完善，继续浏览</button><view class="profile-note">头像选择后会单独保存；昵称在点击「保存昵称」后更新。完善资料由你自主选择。</view>
</view>
