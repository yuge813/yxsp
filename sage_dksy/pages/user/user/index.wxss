.profile-heading{padding:16rpx 0 40rpx}.profile-heading .ui-title{display:block;margin:14rpx 0}.profile-form{padding:40rpx 28rpx}.profile-avatar-wrap{display:flex;flex-direction:column;align-items:center;padding:8rpx 0 28rpx}.profile-avatar-button{width:156rpx;height:156rpx;position:relative;padding:0;background:#E7EBDD;border-radius:50%;overflow:visible;margin:0}.profile-avatar-button image,.profile-avatar-placeholder{display:flex;align-items:center;justify-content:center;width:156rpx;height:156rpx;border-radius:50%;overflow:hidden}.profile-avatar-edit{position:absolute;bottom:2rpx;right:0;background:#20352E;border:6rpx solid #FFFEFA;width:46rpx;height:46rpx;border-radius:50%;display:flex;align-items:center;justify-content:center}.profile-avatar-wrap>text{font-size:26rpx;color:#647160;margin-top:22rpx}.profile-album{font-size:25rpx;color:#9A4A31;margin:4rpx 0 0}.profile-field{border-top:1rpx solid #E3E7DA;padding-top:28rpx;display:flex;flex-direction:column;gap:16rpx}.profile-field>text:first-child{font-size:28rpx;font-weight:600}.profile-field input{width:100%;padding:24rpx;box-sizing:border-box;background:#F3F4EB;border-radius:16rpx;height:100rpx;font-size:31rpx}.profile-field>text:last-child{font-size:24rpx;color:#687566;line-height:1.6}.profile-save{margin-top:34rpx}.profile-skip{margin-top:10rpx}.profile-error{display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;background:#F8E7DC;border-radius:18rpx;margin-top:22rpx;padding:16rpx 22rpx;font-size:25rpx;line-height:1.6;color:#924431}.profile-error>text{flex:1}.profile-error button{font-size:24rpx;min-height:64rpx}.profile-note{font-size:24rpx;color:#687566;line-height:1.8;text-align:center;padding:24rpx 16rpx 0}
