.profile-page{padding:38rpx 34rpx calc(200rpx + env(safe-area-inset-bottom));color:#27212C}.profile-heading{padding:4rpx 4rpx 30rpx}.profile-heading>text{display:block;font-size:24rpx;letter-spacing:4rpx;color:#B13B60}.profile-heading>view{font-size:57rpx;font-weight:700;line-height:1.38;margin-top:18rpx;letter-spacing:-1rpx}.profile-heading>view>text{display:block}.profile-avatar-wrap{display:flex;align-items:center;flex-direction:column;position:relative;padding:40rpx 0 42rpx}.profile-avatar-button{position:relative;width:194rpx;height:194rpx;border:8rpx solid #FFFFFF;border-radius:50%;background:linear-gradient(150deg,#FFF0C8,#FFC5C5);box-shadow:0 0 0 20rpx #FFF0F4;padding:0;overflow:visible;margin:0}.profile-avatar-button image,.profile-avatar-placeholder{width:178rpx;height:178rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;overflow:hidden}.profile-avatar-camera{position:absolute;right:-15rpx;bottom:-3rpx;height:60rpx;width:60rpx;border:6rpx solid #FFFFFF;background:#D11B46;border-radius:50%;display:flex;align-items:center;justify-content:center}.profile-avatar-label{font-size:28rpx;font-weight:650;color:#BD1E4B;margin-top:40rpx}.profile-avatar-caption{font-size:24rpx;color:#806574;line-height:1.6;margin-top:12rpx}.profile-album{font-size:24rpx;color:#A4365A;min-height:68rpx;padding:12rpx 24rpx}.profile-fields{background:#FFFFFF;border:1rpx solid #F0DDE6;border-radius:36rpx;padding:34rpx 36rpx}.profile-fields>text:first-child{font-size:27rpx;color:#806574;display:block;margin-bottom:18rpx}.profile-input{width:100%;height:98rpx;min-height:98rpx;background:#FFF7F9;border:1rpx solid #EFD5E1;border-radius:20rpx;padding:22rpx 24rpx;color:#512F43;font-size:30rpx;line-height:1.6;box-sizing:border-box}.profile-fields>text:last-child{display:block;font-size:25rpx;line-height:1.8;color:#806574;margin-top:18rpx}.profile-note{display:flex;align-items:flex-start;gap:18rpx;padding:38rpx 10rpx 12rpx;color:#A73A62}.profile-note>text{font-size:25rpx;line-height:1.9;color:#806574;flex:1}.profile-note>text>text{display:block}.profile-note>text>text:last-child{font-size:24rpx;margin-top:12rpx}.profile-skip{min-height:88rpx;padding:20rpx;font-size:25rpx;color:#A23B60;margin-top:10rpx}.profile-error{display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;background:#FFF0F4;border:1rpx solid #F1CDD9;border-radius:18rpx;margin-top:22rpx;padding:16rpx 22rpx;font-size:25rpx;line-height:1.6;color:#A52851}.profile-error>text{flex:1}.profile-error>button{font-size:24rpx;min-height:76rpx;padding:12rpx}.profile-footer{position:fixed;z-index:40;left:0;right:0;bottom:0;background:#FFFFFF;border-top:1rpx solid #F0DDE6;padding:24rpx 34rpx calc(24rpx + env(safe-area-inset-bottom))}.profile-footer .ui-primary{border-radius:30rpx;box-shadow:0 12rpx 30rpx #D4113A12}
