<view class="mine-page">
  <view class="mine-stage"><view class="mine-account"><navigator class="mine-profile" url="/sage_dksy/pages/user/user/index"><image wx:if="{{userinfo.headimg&&!avatarFailed}}" class="mine-avatar" src="{{userinfo.headimg}}" mode="aspectFill" binderror="avatarError"/><view wx:else class="mine-avatar mine-avatar-empty"><yx-icon name="user" tone="brand" size="62"/></view><view><text class="mine-name">{{userinfo.nickname||'元享用户'}}</text><text class="mine-profile-link">个人资料 <yx-icon name="arrow" tone="light" size="24"/></text></view></navigator><navigator url="/sage_dksy/pages/v17/settings" class="mine-setting" aria-label="设置与隐私"><yx-icon name="settings" tone="light" size="44"/></navigator></view>
    <view class="mine-wallet"><view class="mine-wallet-top"><navigator url="/sage_dksy/pages/user/integral?view=wallet">我的金币</navigator><navigator url="/sage_dksy/pages/user/integral">收支明细 <yx-icon name="arrow" tone="light" size="26"/></navigator></view><navigator url="/sage_dksy/pages/user/integral?view=wallet" class="mine-wallet-amount"><text>{{balanceText}}</text><text>金币</text></navigator><text wx:if="{{loading}}" class="mine-wallet-caption">正在同步账户余额…</text><text wx:elif="{{pageError&&loaded}}" class="mine-wallet-caption">暂未同步，保留上次账户信息。</text><text wx:elif="{{balance===null}}" class="mine-wallet-caption">余额暂未同步，点击下方重试。</text><text wx:else class="mine-wallet-caption">每一点积累，都清楚可查。</text><navigator url="/sage_dksy/pages/prize/index" open-type="redirect" class="mine-wallet-foot"><view><yx-icon name="gift" tone="light" size="34"/><text>去挑一份喜欢的好礼</text></view><yx-icon name="arrow" tone="light" size="34"/></navigator></view>
  </view>
  <view class="mine-body"><view wx:if="{{pageError}}" class="mine-error" bindtap="retry"><yx-icon name="refresh" tone="brand" size="32"/><text>{{pageError}}</text><text>重试</text></view>
    <view class="mine-actions"><navigator url="/sage_dksy/pages/v14/sign/index"><view><yx-icon name="check" tone="brand" size="46"/></view><text>每日签到</text></navigator><navigator url="/sage_dksy/pages/v14/tasks/index" open-type="redirect"><view><yx-icon name="play" tone="brand" size="46"/></view><text>广告赚币</text></navigator><navigator url="/sage_dksy/pages/prize/index" open-type="redirect"><view><yx-icon name="gift" tone="brand" size="46"/></view><text>金币兑换</text></navigator><navigator url="/sage_dksy/pages/trial/trial" open-type="redirect"><view><yx-icon name="package" tone="brand" size="46"/></view><text>商品试用</text></navigator><navigator url="/sage_dksy/pages/v11/promote"><view><yx-icon name="friend" tone="brand" size="46"/></view><text>邀请好友</text></navigator></view>
    <view class="mine-record-head"><text>我的记录</text><text>每一次期待，都有记录</text></view><view class="mine-records"><navigator url="/sage_dksy/pages/user/order"><view class="mine-record-icon"><yx-icon name="order" tone="brand" size="52"/></view><text>兑换记录</text><text>订单与物流</text><yx-icon name="arrow" tone="muted" size="30"/></navigator><navigator url="/sage_dksy/pages/user/trial_list"><view class="mine-record-icon trial"><yx-icon name="package" tone="muted" size="52"/></view><text>试用记录</text><text>报名与中选结果</text><yx-icon name="arrow" tone="muted" size="30"/></navigator></view>
    <view class="mine-menu"><navigator url="/sage_dksy/pages/v132grow/index" class="mine-row"><view class="mine-row-icon"><yx-icon name="friend" tone="brand" size="38"/></view><view><text>我的好友</text><text>与你一起发现元享</text></view><yx-icon name="arrow" tone="muted" size="28"/></navigator><navigator url="/sage_dksy/pages/address/list" class="mine-row"><view class="mine-row-icon"><yx-icon name="location" tone="brand" size="38"/></view><view><text>收货地址</text></view><yx-icon name="arrow" tone="muted" size="28"/></navigator><navigator url="/sage_dksy/pages/v14/reminders/index" class="mine-row"><view class="mine-row-icon"><yx-icon name="bell" tone="brand" size="38"/></view><view><text>签到提醒</text><text>由你自主订阅</text></view><yx-icon name="arrow" tone="muted" size="28"/></navigator><button open-type="contact" class="mine-row mine-contact"><view class="mine-row-icon"><yx-icon name="support" tone="brand" size="38"/></view><view><text>帮助与客服</text></view><yx-icon name="arrow" tone="muted" size="28"/></button><navigator url="/sage_dksy/pages/v17/settings" class="mine-row"><view class="mine-row-icon"><yx-icon name="shield" tone="brand" size="38"/></view><view><text>设置与隐私</text></view><yx-icon name="arrow" tone="muted" size="28"/></navigator></view>
    <view class="mine-ad" wx:if="{{v3Ready&&v3Unit}}"><ad unit-id="{{v3Unit}}" bindload="onV3AdLoad" binderror="onV3AdError"/></view><yx22-ad placement="mine_banner" wx:if="{{!v3Ready}}"/><text class="mine-end">元享 · 每天都有小惊喜</text>
  </view>
</view><include src="/sage_dksy/pages/nav/nav.wxml"/><yx22-popup scene="mine" ready="{{loaded}}"/>
