<view class="ui-page trial-history"><text class="ui-kicker">元享 · 好物体验</text><text class="ui-title">每一份期待，都有记录。</text><text class="ui-lead">查看试用报名、中选结果与收货资料。</text><view class="history-tabs"><view data-tt="0" bindtap="typein" class="{{prize_on===0?'on':''}}">全部申请</view><view data-tt="1" bindtap="typein" class="{{prize_on===1?'on':''}}">已中选</view></view>
 <yx-state wx:if="{{loading&&!loaded}}" type="loading"/><yx-state wx:elif="{{error&&!loaded}}" type="error" title="记录暂时没有加载出来" description="{{error}}" action="重新加载" bindaction="retry"/>
 <block wx:else><view wx:if="{{error}}" class="ui-error" bindtap="retry">{{error}} · 点击重试</view><view wx:for="{{triallist}}" wx:key="id" class="history-row ui-card"><view class="history-photo"><image wx:if="{{item.trial_pro.pro_picurl&&!item.imageFailed}}" src="{{item.trial_pro.pro_picurl}}" mode="aspectFill" binderror="imageError" data-id="{{item.id}}"/><yx-icon wx:else name="gift" tone="muted" size="60"/></view><view class="history-copy"><text class="history-title">{{item.trial_pro.pro_title}}</text><text class="history-date">{{item.createtime}}</text><text class="history-status">{{item.status_text||'状态待更新'}}</text><navigator wx:if="{{item.can_complete===1}}" url="/sage_dksy/pages/trial/complete/complete?id={{item.id}}" class="history-fill">填写中选收货资料 <yx-icon name="arrow" tone="brand" size="24"/></navigator></view></view>
 <yx-state wx:if="{{loaded&&!triallist.length}}" type="empty" title="{{prize_on===1?'还没有已公布的中选记录':'还没有试用申请记录'}}" description="报名不等于中选，具体结果以活动公布为准"/>
 <view wx:if="{{loading}}" class="history-end">正在加载…</view><button wx:elif="{{hasMore&&triallist.length}}" class="ui-text-button" bindtap="onReachBottom">继续加载</button><view wx:elif="{{triallist.length}}" class="history-end">已展示全部返回的记录</view></block>
 <navigator url="/sage_dksy/pages/trial/trial" class="ui-secondary history-explore">发现更多试用活动</navigator>
</view>
