<view class="ui-page orders-page"><view class="orders-intro"><text class="ui-kicker">积累的喜欢，都有记录</text><view class="ui-title">我的兑换</view><text class="ui-lead">在这里查看订单与物流进度。</text></view><yx-state wx:if="{{loading&&!userorder.length}}" type="loading"/><yx-state wx:elif="{{error&&!userorder.length}}" type="error" title="{{error}}" description="没有读到记录不代表没有订单，请重新加载。" action="重新加载" bindaction="retry"/><yx-state wx:elif="{{!userorder.length}}" type="empty" title="还没有兑换记录" description="去挑一份喜欢的好礼，给日常一点期待。" action="发现好礼" bindaction="goGifts"/><block wx:else><view wx:if="{{error}}" class="ui-error" bindtap="retry">{{error}} · 点击重试</view><view class="ui-section-head"><text>兑换记录</text><text class="orders-count">已加载 {{userorder.length}} 笔</text></view><view class="order-card" wx:for="{{userorder}}" wx:key="id"><view class="order-status"><text>{{item.isyes_name||'查看处理进度'}}</text><text>{{item.createtime}}</text></view><view class="order-product"><image wx:if="{{item.prize.prize_picurl&&!item.imageFailed}}" src="{{item.prize.prize_picurl}}" mode="aspectFit" binderror="onImageError" data-index="{{index}}"/><view wx:else class="order-image-fallback"><yx-icon name="gift" size="58" tone="muted"/></view><view><text>{{item.prize.prize_title||'兑换商品'}}</text><text wx:if="{{item.prize.prize_integral!==undefined}}">{{item.prize.prize_integral}} 金币</text></view></view><view wx:if="{{item.expressage_company||item.expressage_number}}" class="order-logistics"><view wx:if="{{item.expressage_company}}">配送公司<text>{{item.expressage_company}}</text></view><view wx:if="{{item.expressage_number}}">快递单号<text>{{item.expressage_number}}</text></view><button wx:if="{{item.expressage_number}}" class="logistics-copy" bindtap="copyLogistics" data-number="{{item.expressage_number}}">复制单号</button></view><view wx:if="{{item.v10canconfirm}}" class="order-actions"><button class="ui-primary" data-id="{{item.id}}" loading="{{confirmingId==item.id}}" disabled="{{!!confirmingId}}" bindtap="confirmV10">确认收货</button></view></view><view class="order-load" wx:if="{{loadingMore}}">正在加载更多记录…</view><button wx:elif="{{moreError}}" class="ui-text-button" bindtap="loadMore">{{moreError}}</button><button wx:elif="{{hasMore}}" class="ui-text-button" bindtap="loadMore">加载更多记录</button><view wx:else class="order-load">已展示全部已返回记录</view></block><button class="ui-text-button order-help" open-type="contact"><yx-icon name="support" tone="green" size="34"/> 订单有疑问？联系客服</button></view>