<view class="cm-scope">
 <view wx:if="{{orderView==='list'}}" class="cm-page cm-record-page">
  <view class="cm-record-heading"><text>每一份好礼，都有记录</text><view class="cm-h1">我的兑换</view><view class="cm-record-icon"><yx-icon name="order" tone="brand" size="86"/></view></view>
  <yx-state wx:if="{{loading&&!userorder.length}}" type="loading"/><yx-state wx:elif="{{error&&!userorder.length}}" type="error" title="连接开了个小差" description="请重新加载。已有订单不会因此清空。" action="重新加载" bindaction="retry"/>
  <view wx:elif="{{!userorder.length}}" class="cm-empty-orders"><view class="cm-empty-receipt"><image src="/sage_dksy/resource/red/hero.png" mode="aspectFit"/><view class="cm-empty-lines"><view></view><view></view><view></view></view></view><view class="cm-h2">还没有兑换记录</view><view class="cm-p">先攒一点金币，再挑一件喜欢的好物。<text>兑换成功后，记录会出现在这里。</text></view><button class="ui-primary" bindtap="goGifts">去挑选好礼</button><view class="cm-empty-wallet"><yx-icon name="coin" tone="brand" size="36"/><text>当前可用金币</text><text>{{balance===null?'待同步':balance}}</text><text wx:if="{{balance!==null}}">金币</text></view></view>
  <block wx:else><view wx:if="{{error}}" class="ui-error" bindtap="retry">{{error}} · 点击重试</view><view class="cm-record-sub"><text>全部兑换记录</text><text class="cm-small">已加载 {{userorder.length}} 笔</text></view><view class="cm-order-card" wx:for="{{userorder}}" wx:key="id"><view class="cm-order-top"><text>{{item.createtime}}</text><text class="tag {{item._hasTracking?'gold-tag':''}}">{{item._status||item.isyes_name||'状态待更新'}}</text></view><view class="cm-product-row" data-id="{{item.id}}" bindtap="openOrder"><view class="cm-mini-product"><image wx:if="{{item.prize.prize_picurl&&!item.imageFailed}}" src="{{item.prize.prize_picurl}}" mode="aspectFit" data-index="{{index}}" binderror="onImageError"/><view wx:else class="cm-image-placeholder"><yx-icon name="gift" tone="muted" size="58"/></view></view><view class="cm-product-copy"><text class="cm-b">{{item.prize.prize_title||'兑换商品'}}</text><text wx:if="{{item.prize.prize_integral!==undefined}}" class="cm-strong">{{item.prize.prize_integral}} <text class="cm-small">金币</text></text></view></view><view class="cm-order-bottom" data-id="{{item.id}}" bindtap="openOrder"><text>订单信息与处理进度</text><text>{{item._hasTracking?'查看物流':'查看订单'}} ›</text></view></view><view wx:if="{{loadingMore}}" class="cm-record-end">正在加载更多记录…</view><button wx:elif="{{moreError}}" class="small-link" bindtap="loadMore">{{moreError}}</button><button wx:elif="{{hasMore}}" class="small-link" bindtap="loadMore">加载更多兑换记录</button><view wx:else class="cm-record-end">已展示全部已返回记录</view><button class="ui-secondary cm-outline" bindtap="goGifts">继续发现好礼</button></block><button open-type="contact" class="small-link"><yx-icon name="support" tone="muted" size="32"/>订单有疑问？联系客服</button>
 </view>
 <view wx:elif="{{detailOrder&&orderView==='detail'}}" class="cm-page cm-with-footer cm-order-detail">
  <view class="cm-order-hero"><view class="cm-order-halo"></view><view><text class="hero-kicker">元享好礼 · 我的兑换</text><view class="cm-h1">{{detailOrder._header}}</view><view class="cm-p">{{detailOrder._hasTracking?'快递公司与单号已更新，可查看配送信息。':'后续处理进度，请以兑换记录的实际显示为准。'}}</view></view><view class="cm-order-symbol"><yx-icon name="{{detailOrder._hasTracking?'van':'package'}}" tone="light" size="116"/></view></view>
  <view wx:if="{{detailOrder._hasTracking}}" class="cm-shipping-link" bindtap="openLogistics"><yx-icon name="van" tone="brand" size="58"/><view><text class="cm-b">{{detailOrder.expressage_company||'配送信息'}}</text><view class="cm-p">{{detailOrder.expressage_number}}</view></view><text>物流信息 ›</text></view>
  <view wx:if="{{detailOrder._address}}" class="card cm-order-address"><yx-icon name="location" tone="brand" size="46"/><view><text class="cm-b">收货信息</text><view class="cm-p">{{detailOrder._address}}</view></view></view>
  <view class="cm-order-detail-card"><view class="cm-product-row"><view class="cm-mini-product"><image wx:if="{{detailOrder.prize.prize_picurl&&!detailOrder.imageFailed}}" src="{{detailOrder.prize.prize_picurl}}" mode="aspectFit" binderror="detailImageError"/><view wx:else class="cm-image-placeholder"><yx-icon name="gift" tone="muted" size="58"/></view></view><view class="cm-product-copy"><text class="cm-b">{{detailOrder.prize.prize_title||'兑换商品'}}</text><text wx:if="{{detailOrder.prize.prize_integral!==undefined}}" class="cm-strong">{{detailOrder.prize.prize_integral}} <text class="cm-small">金币</text></text></view></view><view class="cm-ticket-divider"></view><view class="info-line"><text>订单状态</text><text class="cm-b">{{detailOrder._status}}</text></view><view wx:if="{{detailOrder.createtime}}" class="info-line"><text>提交时间</text><text class="cm-b">{{detailOrder.createtime}}</text></view></view>
  <view class="section"><text>订单信息</text></view><view class="card cm-order-meta"><view wx:if="{{detailOrder._number}}" class="info-line" bindtap="copyOrderNumber"><text>订单编号</text><view class="cm-info-action"><text>{{detailOrder._number}}</text><yx-icon name="copy" tone="muted" size="28"/></view></view><view class="info-line"><text>提交时间</text><text class="cm-b">{{detailOrder.createtime||'以订单实际记录为准'}}</text></view></view><view class="cm-notice"><yx-icon name="info" tone="brand" size="36"/><text>{{detailOrder.v10canconfirm?'请在实际收到商品并确认无误后，再确认收货。':'实际处理与配送安排，请查看商品规则或联系客服。'}}</text></view><button class="small-link" bindtap="closeOrder">返回兑换记录</button><view class="cm-action-footer"><button class="ui-secondary" open-type="contact">联系客服</button><button wx:if="{{detailOrder.v10canconfirm}}" class="ui-primary" bindtap="confirmV10" data-id="{{detailOrder.id}}" loading="{{confirmingId==detailOrder.id}}" disabled="{{!!confirmingId}}">确认收货</button></view>
 </view>
 <view wx:elif="{{detailOrder&&orderView==='logistics'}}" class="cm-page cm-logistics-page">
  <view class="cm-logistics-banner"><view><text>好礼配送信息</text><view class="cm-h1">好礼在路上</view><view class="cm-p">通过快递公司查询配送详情</view></view><view><yx-icon name="van" tone="brand" size="120"/></view></view><view class="cm-waybill"><view class="cm-waybill-top"><view class="cm-courier-emblem"><yx-icon name="van" tone="light" size="50"/></view><view><view class="cm-h2">{{detailOrder.expressage_company||'配送公司待更新'}}</view><text>订单配送信息</text></view></view><view class="cm-waybill-code"><text>快递单号</text><text class="cm-b">{{detailOrder.expressage_number}}</text></view><button class="ui-secondary" bindtap="copyLogistics"><yx-icon name="copy" tone="brand" size="38"/>复制快递单号</button></view><view wx:if="{{detailOrder._address}}" class="card cm-logistics-recipient"><text>收货信息</text><text class="cm-b">{{detailOrder._address}}</text></view><view class="cm-logistics-note"><yx-icon name="info" tone="muted" size="40"/><view><text class="cm-b">如何查看最新配送进度？</text><view class="cm-p">复制快递单号，前往对应快递公司官方渠道查询。</view></view></view><view class="section"><text>配送商品</text></view><view class="card"><view class="cm-product-row"><view class="cm-mini-product"><image wx:if="{{detailOrder.prize.prize_picurl&&!detailOrder.imageFailed}}" src="{{detailOrder.prize.prize_picurl}}" mode="aspectFit" binderror="detailImageError"/></view><view class="cm-product-copy"><text class="cm-b">{{detailOrder.prize.prize_title||'兑换商品'}}</text><text class="cm-strong" wx:if="{{detailOrder.prize.prize_integral!==undefined}}">{{detailOrder.prize.prize_integral}} <text class="cm-small">金币</text></text></view></view></view><button class="small-link" bindtap="backToOrder">返回订单详情</button><button class="small-link" open-type="contact">配送有疑问？联系客服</button>
 </view>
</view>
