.trial-history>.ui-title{display:block;font-size:44rpx;line-height:1.5;margin:24rpx 0 18rpx}.trial-history>.ui-lead{display:block;font-size:28rpx;color:#65725D;line-height:1.8;margin-bottom:34rpx}.history-tabs{display:flex;gap:16rpx;margin-bottom:28rpx}.history-tabs>view{flex:1;background:#E8ECDD;border-radius:18rpx;min-height:90rpx;display:flex;align-items:center;justify-content:center;font-size:28rpx;color:#63705B}.history-tabs .on{background:#20352E;color:#FFFEFA}.history-row{display:flex;gap:24rpx;padding:26rpx;margin-bottom:24rpx;align-items:flex-start}.history-photo{height:166rpx;width:156rpx;flex-shrink:0;background:#E9ECDD;border-radius:18rpx;display:flex;align-items:center;justify-content:center;overflow:hidden}.history-photo>image{height:100%;width:100%}.history-copy{min-width:0;flex:1}.history-title{display:block;font-size:31rpx;font-weight:600;color:#20352E;line-height:1.5;word-break:break-all}.history-date{display:block;font-size:25rpx;color:#64715C;margin-top:12rpx;line-height:1.5}.history-status{display:inline-block;font-size:25rpx;color:#4E6544;background:#E8EEDD;padding:8rpx 12rpx;border-radius:8rpx;margin-top:14rpx}.history-fill{display:flex;align-items:center;gap:4rpx;font-size:26rpx;min-height:88rpx;color:#C1492E;font-weight:600;margin-top:4rpx}.history-end{font-size:25rpx;color:#64715C;text-align:center;padding:26rpx}.history-explore{display:flex;align-items:center;justify-content:center;margin-top:30rpx}
