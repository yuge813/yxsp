<view class="ui-page share-page"><view class="share-heading"><text class="ui-kicker">分享的每一次相遇</text><text class="ui-title">推广记录</text><text class="ui-lead">成员与相关记录，以实际归属为准。</text></view>
 <view wx:if="{{share_user}}" class="share-inviter ui-card"><image wx:if="{{share_user.headimg&&!share_user._avatarFailed}}" src="{{share_user.headimg}}" class="share-avatar" mode="aspectFill" binderror="inviterAvatarError"/><view wx:else class="share-avatar share-avatar-empty"><yx-icon name="user" tone="green" size="42"/></view><view><text>我的推广人</text><text>{{share_user.nickname||'元享用户'}}</text></view><yx-icon name="friend" tone="muted" size="38"/></view>
 <view class="share-tabs"><navigator class="selected" url="index" open-type="redirect">一级 <text>{{total_one===null?'—':total_one}}</text></navigator><navigator class="" url="list" open-type="redirect">二级 <text>{{total_two===null?'—':total_two}}</text></navigator></view>
 <yx-state wx:if="{{loading&&!loaded}}" type="loading"/><yx-state wx:elif="{{error&&!loaded}}" type="error" title="记录暂未加载" description="{{error}}" action="重新加载" bindaction="retry"/><yx-state wx:elif="{{loaded&&!list.length}}" type="empty" title="暂时没有推广记录" description="成员归属核验完成后，可在这里查看实际记录。"/>
 <view wx:else class="share-members ui-card"><view class="share-members-head"><text>成员信息</text><text>相关金币记录</text></view><view class="share-member" wx:for="{{list}}" wx:key="_key"><image wx:if="{{item.headimg&&!item._avatarFailed}}" class="share-avatar" src="{{item.headimg}}" mode="aspectFill" data-index="{{index}}" binderror="avatarError"/><view wx:else class="share-avatar share-avatar-empty"><yx-icon name="user" tone="green" size="36"/></view><view class="share-member-copy"><text>{{item.nickname||'元享用户'}}</text><text wx:if="{{item.user_id}}">ID：{{item.user_id}}</text><text>{{item.createtime}}</text></view><view class="share-member-amount"><text>{{item._amount===null?'—':(item.static_title||'')+item._amount}}</text><text>金币</text></view></view></view>
 <view wx:if="{{error&&loaded}}" class="share-error" bindtap="retry">{{error}}　重试</view><button wx:if="{{loaded&&list.length&&load&&!error}}" class="ui-text-button" bindtap="loadMore" loading="{{loading}}" disabled="{{loading}}">{{loading?'正在读取':'加载更多记录'}}</button><text class="share-foot">仅展示实际记录，分享本身不代表获得金币奖励。</text>
</view>