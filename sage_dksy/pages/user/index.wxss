.mine-page{padding:28rpx 32rpx 36rpx;color:#20352E}.mine-heading{padding:12rpx 0 30rpx}.mine-title{display:block;font-size:60rpx;line-height:1.3;font-weight:700;letter-spacing:-2rpx;margin-top:12rpx}.mine-profile{display:flex;align-items:center;gap:22rpx;padding:16rpx 0 34rpx}.mine-avatar{height:112rpx;width:112rpx;border-radius:50%;background:#E4E8DC;flex-shrink:0;border:6rpx solid #FFFEFA}.mine-avatar-empty{display:flex;align-items:center;justify-content:center}.mine-profile-copy{display:flex;flex-direction:column;gap:12rpx;min-width:0;flex:1}.mine-name{font-size:36rpx;font-weight:650;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mine-profile-link{font-size:25rpx;color:#687667}.mine-wallet{position:relative;background:#20352E;color:#FFFEFA;border-radius:32rpx;padding:34rpx 32rpx 0;overflow:hidden}.mine-wallet:after{content:"";position:absolute;width:300rpx;height:300rpx;border:1rpx solid #C8D4AE22;border-radius:50%;right:-146rpx;top:-100rpx;pointer-events:none}.mine-wallet-top{display:flex;align-items:center;justify-content:space-between;font-size:27rpx;position:relative;z-index:1}.mine-wallet-top navigator{display:flex;align-items:center;gap:6rpx;font-size:24rpx;color:#E1E8D6;min-height:56rpx}.mine-wallet-amount{display:flex;align-items:baseline;gap:16rpx;margin:20rpx 0 10rpx;font-size:88rpx;line-height:1.15;font-weight:600;font-variant-numeric:tabular-nums;word-break:break-all}.mine-wallet-unit{font-size:25rpx;font-weight:400;color:#D8DFC9;white-space:nowrap}.mine-wallet-caption{font-size:24rpx;line-height:1.6;color:#D8DFC9;margin-bottom:28rpx}.mine-wallet-action{border-top:1rpx solid #DDE6CB33;display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:24rpx 0;font-size:25rpx}.mine-wallet-action>text{color:#D8DFC9}.mine-wallet-action>view{display:flex;align-items:center;gap:6rpx;white-space:nowrap}.mine-error{display:flex;align-items:center;gap:12rpx;margin-top:20rpx;padding:20rpx;background:#F8E8DE;border-radius:18rpx;color:#924431;font-size:24rpx;line-height:1.5}.mine-error>text:first-of-type{flex:1}.mine-section-note{font-size:24rpx;font-weight:400;color:#6D796A}.mine-records{display:flex;gap:20rpx;margin-bottom:26rpx}.mine-record{position:relative;flex:1;min-width:0;padding:28rpx 24rpx;background:#FFFEFA;border:1rpx solid #E3E4D8;border-radius:24rpx;display:flex;flex-direction:column;gap:12rpx}.mine-record-icon{width:72rpx;height:72rpx;border-radius:20rpx;background:#F0E7DB;display:flex;align-items:center;justify-content:center;margin-bottom:6rpx}.mine-record-icon.green{background:#E5EAD9}.mine-record>text:first-of-type{font-size:31rpx;font-weight:650}.mine-record>text:nth-of-type(2){font-size:24rpx;color:#6D796A;line-height:1.6}.mine-record>yx-icon{position:absolute;right:22rpx;top:34rpx}.mine-menu{padding:0 24rpx;margin-bottom:28rpx}.mine-menu-row{display:flex;align-items:center;gap:20rpx;min-height:106rpx;border-bottom:1rpx solid #E8E9DF;color:#20352E}.mine-menu-row:last-child{border-bottom:0}.mine-menu-row>text:first-of-type{font-size:29rpx;flex:1;text-align:left}.mine-menu-row>yx-icon:last-child{margin-left:auto}.mine-row-note{font-size:24rpx;color:#6D796A}.mine-contact{background:transparent;padding:0;width:100%;border-radius:0;line-height:1.5;font-weight:400}.mine-ad{margin:32rpx 0}.mine-footer{display:flex;flex-direction:column;align-items:center;gap:12rpx;padding:30rpx 0 16rpx;color:#6D796A;font-size:24rpx}.mine-footer>text:first-child{font-size:29rpx;font-weight:600;letter-spacing:8rpx}.mine-hover{opacity:.8}
