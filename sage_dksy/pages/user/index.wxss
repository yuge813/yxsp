.mine-page{color:#27212C;background:#FFF6F5}.mine-stage{position:relative;overflow:hidden;padding:38rpx 38rpx 54rpx;color:#FFFFFF;background:radial-gradient(ellipse at 100% 30%,#FF876650,transparent 60%),linear-gradient(135deg,#D00A36,#F73549)}.mine-account{display:flex;align-items:center;gap:20rpx;position:relative;z-index:2;margin-bottom:40rpx}.mine-profile{display:flex;align-items:center;gap:24rpx;flex:1;min-width:0}.mine-avatar{width:112rpx;height:112rpx;flex-shrink:0;border-radius:50%;border:6rpx solid #FFF0D9;background:linear-gradient(150deg,#FFEAB7,#FFC19F)}.mine-avatar-empty{display:flex;align-items:center;justify-content:center}.mine-profile>view:last-child{flex:1;min-width:0}.mine-name{display:block;font-size:42rpx;font-weight:650;line-height:1.35;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mine-profile-link{display:flex;align-items:center;gap:6rpx;font-size:24rpx;color:#FFE1E5;margin-top:14rpx;min-height:44rpx}.mine-setting{width:88rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.mine-wallet{position:relative;overflow:hidden;z-index:2;border:1rpx solid #FFD0A850;border-radius:36rpx;background:linear-gradient(115deg,#7F163A,#AA1841);box-shadow:0 20rpx 48rpx #A0003025;padding:30rpx 32rpx 0;color:#FFE6AF}.mine-wallet:after{content:"";position:absolute;width:328rpx;height:328rpx;border:1rpx solid #FFD0A830;border-radius:50%;right:-144rpx;top:-76rpx;box-shadow:0 0 0 40rpx #FFD7B208;pointer-events:none}.mine-wallet-top{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;gap:16rpx;font-size:27rpx}.mine-wallet-top>navigator{display:flex;align-items:center;gap:6rpx;min-height:60rpx}.mine-wallet-top>navigator:last-child{font-size:24rpx;color:#F5D8CC}.mine-wallet-amount{position:relative;z-index:1;display:flex;align-items:baseline;gap:16rpx;margin:12rpx 0 10rpx;min-height:102rpx;line-height:1.1}.mine-wallet-amount>text:first-child{font-size:86rpx;font-weight:750;letter-spacing:-2rpx;font-variant-numeric:tabular-nums;overflow-wrap:anywhere;min-width:0}.mine-wallet-amount>text:last-child{font-size:25rpx;color:#F4D1C6;white-space:nowrap}.mine-wallet-caption{position:relative;z-index:1;display:block;font-size:24rpx;color:#F7D8D4;line-height:1.7;min-height:40rpx}.mine-wallet-foot{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:26rpx 0;margin-top:28rpx;border-top:1rpx solid #FFDCB82A;font-size:26rpx;color:#FFE7B8;min-height:96rpx}.mine-wallet-foot>view{display:flex;align-items:center;gap:14rpx;min-width:0}.mine-body{padding:0 34rpx 26rpx}.mine-actions{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8rpx;margin:36rpx 0 44rpx}.mine-actions>navigator{display:flex;flex-direction:column;align-items:center;gap:14rpx;min-width:0;min-height:132rpx}.mine-actions>navigator>view{width:82rpx;height:82rpx;border-radius:25rpx;background:#FFE8EF;display:flex;align-items:center;justify-content:center}.mine-actions>navigator>text{font-size:24rpx;color:#684155;white-space:nowrap;line-height:1.5}.mine-record-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:24rpx}.mine-record-head>text:first-child{font-size:34rpx;font-weight:650}.mine-record-head>text:last-child{font-size:24rpx;color:#896779}.mine-records{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22rpx;margin-bottom:32rpx}.mine-records>navigator{position:relative;min-width:0;min-height:238rpx;padding:28rpx 26rpx;border:1rpx solid #F1DEE8;background:#FFFFFF;border-radius:32rpx}.mine-record-icon{margin-bottom:18rpx}.mine-records>navigator>text{display:block;line-height:1.5}.mine-records>navigator>text:first-of-type{font-size:31rpx;font-weight:650}.mine-records>navigator>text:last-of-type{font-size:24rpx;color:#896779;margin-top:10rpx}.mine-records>navigator>yx-icon{position:absolute;right:22rpx;top:32rpx}.mine-menu{padding:0 28rpx;border:1rpx solid #F0DDE6;border-radius:34rpx;background:#FFFFFF}.mine-row{display:flex;align-items:center;gap:18rpx;min-height:112rpx;border-bottom:1rpx solid #F2E4EB;color:#27212C;padding:20rpx 0}.mine-row:last-child{border-bottom:0}.mine-row-icon{width:58rpx;height:58rpx;border-radius:18rpx;background:#FFF2F6;display:flex;align-items:center;justify-content:center;flex-shrink:0}.mine-row>view:nth-child(2){flex:1;min-width:0;display:flex;flex-direction:column;gap:6rpx}.mine-row>view:nth-child(2)>text:first-child{font-size:28rpx;font-weight:550;line-height:1.5;text-align:left}.mine-row>view:nth-child(2)>text+text{font-size:24rpx;color:#896779;line-height:1.6;text-align:left}.mine-contact{width:100%;background:transparent;border-radius:0;line-height:1.5}.mine-error{display:flex;align-items:center;gap:12rpx;margin-top:24rpx;padding:22rpx 18rpx;border:1rpx solid #F0CBDA;border-radius:18rpx;background:#FFFFFF;color:#A6204A;font-size:24rpx;line-height:1.6}.mine-error>text:first-of-type{flex:1}.mine-ad{margin:32rpx 0}.mine-end{display:block;text-align:center;font-size:24rpx;letter-spacing:2rpx;color:#896779;padding:34rpx 0 6rpx}
