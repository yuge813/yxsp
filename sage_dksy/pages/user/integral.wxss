.ledger-page{background:#FFF6F5}.ledger-wallet{display:flex;align-items:center;gap:18rpx;background:#fff;border:1rpx solid #F2DFE6;border-radius:26rpx;padding:24rpx;margin-bottom:24rpx;font-size:26rpx;color:#806574}.ledger-wallet>text:nth-child(2){font-size:48rpx;font-weight:750;color:#C6123D}.ledger-wallet>text:last-child{margin-left:auto;font-size:24rpx}.ledger-filters{display:flex;border-bottom:1rpx solid #EEDDE7;margin-bottom:36rpx}.ledger-filters>view{flex:1;position:relative;text-align:center;min-height:88rpx;display:flex;align-items:center;justify-content:center;font-size:28rpx;color:#806574}.ledger-filters .selected{color:#C81D49;font-weight:650}.selected:after{position:absolute;content:'';height:6rpx;background:#D11A47;border-radius:4rpx;bottom:-1rpx;left:40%;right:40%}.ledger-summary{padding:34rpx;background:linear-gradient(110deg,#FFF0EC,#FFE7E9);border:1rpx solid #F7D8DF;border-radius:32rpx;margin-bottom:30rpx}.ledger-summary>text{display:block;font-size:24rpx;color:#8B596D}.ledger-summary>view{font-size:70rpx;font-weight:750;color:#BD1D4A;line-height:1.4;margin:10rpx 0}.ledger-summary>view>text{font-size:26rpx;margin-left:12rpx}.out-summary{background:linear-gradient(110deg,#F9ECF4,#EFE8F5);border-color:#E7DBEC}.out-summary>view{color:#704569}.ledger-list-heading{display:flex;justify-content:space-between;font-size:30rpx;margin:20rpx 0 24rpx;font-weight:650}.ledger-list-heading>text:last-child{font-size:24rpx;font-weight:400;color:#806574}.ledger-list{background:#fff;border:1rpx solid #F2DFE6;border-radius:32rpx;padding:0 28rpx}.ledger-item{display:flex;align-items:center;gap:20rpx;padding:32rpx 0;border-bottom:1rpx solid #F1E7ED}.ledger-item:last-child{border:0}.ledger-mark{height:78rpx;width:78rpx;display:flex;align-items:center;justify-content:center;background:#FFF0DF;border-radius:24rpx;flex-shrink:0}.ledger-mark.outgoing{background:#F7E8EF}.ledger-item-copy{flex:1;min-width:0}.ledger-item-copy>text:first-child{display:block;font-size:28rpx;line-height:1.6;color:#402D3A}.ledger-item-copy>text:last-child{display:block;font-size:24rpx;color:#806574;margin-top:10rpx}.ledger-amount{font-size:34rpx;font-weight:700;word-break:break-all;max-width:220rpx;color:#CF153F}.ledger-amount.outgoing{color:#524455}.ledger-foot{padding:32rpx 10rpx;text-align:center;font-size:24rpx;line-height:1.8;color:#806574}.coin-account-stage{height:410rpx;position:relative;overflow:hidden;background:linear-gradient(125deg,#DB0D3D,#F93647);color:#fff;padding:44rpx;border-radius:44rpx}.coin-account-stage>text:first-child{font-size:26rpx;display:block;color:#FFE3E8}.coin-account-stage>view{display:flex;align-items:baseline;gap:16rpx;position:relative;z-index:2;margin-top:24rpx}.coin-account-stage>view>text:first-child{font-size:88rpx;font-weight:800;line-height:1.4;word-break:break-all;max-width:450rpx}.coin-account-stage>view>text:last-child{font-size:26rpx}.coin-account-stage>image{position:absolute;width:300rpx;height:320rpx;right:-40rpx;top:60rpx;opacity:.75}.coin-account-stage>text:last-child{position:absolute;bottom:36rpx;left:44rpx;font-size:24rpx;line-height:1.8;max-width:400rpx;color:#FFE4EA;z-index:2}.coin-two-actions{display:flex;gap:24rpx;margin:30rpx 0}.coin-two-actions>view{flex:1;background:white;border:1rpx solid #EEDCE7;border-radius:30rpx;padding:30rpx;display:flex;flex-direction:column;gap:18rpx}.coin-two-actions>view>text:first-of-type{font-size:28rpx;font-weight:650}.coin-two-actions>view>text:last-child{font-size:24rpx;color:#806574}
