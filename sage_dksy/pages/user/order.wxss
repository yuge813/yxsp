page{background:#F5F3ED}.orders-intro{padding:14rpx 0 40rpx}.orders-intro .ui-title{font-size:62rpx;margin:12rpx 0}.orders-intro .ui-lead{display:block;color:#62705F;font-size:28rpx;line-height:1.7}.orders-count{font-size:24rpx;color:#66745D}.order-card{border:1rpx solid #DFE4D6;background:#FFFEFA;border-radius:28rpx;padding:28rpx;margin-bottom:28rpx}.order-status{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding-bottom:24rpx;border-bottom:1rpx solid #E8EBDD;font-size:26rpx;color:#3F5D42}.order-status>text:first-child{font-weight:600}.order-status>text:nth-child(2){font-size:22rpx;font-weight:400;color:#63735A;text-align:right}.order-product{display:flex;align-items:center;gap:24rpx;margin-top:26rpx}.order-product>image,.order-image-fallback{height:170rpx;width:170rpx;background:#EDEFE4;border-radius:18rpx;flex-shrink:0}.order-image-fallback{display:flex;align-items:center;justify-content:center}.order-product>view:last-child{flex:1;min-width:0;display:flex;flex-direction:column;gap:18rpx;font-size:30rpx;line-height:1.6;color:#20352E}.order-product>view:last-child>text:nth-child(2){color:#A73F26;font-size:26rpx}.order-logistics{border-top:1rpx solid #E5E9DA;margin-top:28rpx;padding-top:6rpx}.order-logistics>view{display:flex;gap:24rpx;justify-content:space-between;font-size:24rpx;color:#65745C;line-height:1.7;margin-top:16rpx}.order-logistics>view>text{color:#20352E;text-align:right;overflow-wrap:anywhere}.logistics-copy{background:#EFF1E7;color:#40593D;min-height:88rpx;line-height:88rpx;font-size:24rpx;padding:0 26rpx;display:table;border-radius:14rpx;margin:20rpx 0 0 auto}.logistics-copy:after{border:0}.order-actions{display:flex;justify-content:flex-end;border-top:1rpx solid #E5E9DA;margin-top:28rpx;padding-top:24rpx}.order-actions>button{margin:0;min-width:220rpx;font-size:28rpx;min-height:88rpx}.order-load{text-align:center;color:#64735C;font-size:24rpx;padding:34rpx 0}.order-help{display:flex;align-items:center;justify-content:center;gap:12rpx;margin-top:28rpx}
