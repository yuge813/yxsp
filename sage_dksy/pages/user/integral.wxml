<view class="ledger-page ui-page">
 <block wx:if="{{viewMode==='wallet'}}"><view class="coin-account-stage"><text>当前可用金币</text><view><text>{{balanceText}}</text><text>金币</text></view><image src="/sage_dksy/resource/red/coin.png" mode="aspectFit"/><text>{{balanceLoading?'正在同步账户余额…':'签到和自愿广告所得，可用于兑换商品。'}}</text></view><view class="coin-two-actions"><view bindtap="goEarn"><yx-icon name="play" tone="brand" size="48"/><text>继续赚金币</text><text>查看可参与任务</text></view><view bindtap="goGifts"><yx-icon name="gift" tone="brand" size="48"/><text>金币换商品</text><text>去挑喜欢的好礼</text></view></view><view class="ui-section-head"><text>近期金币记录</text><text bindtap="showLedger">全部明细 ›</text></view></block>
 <block wx:else><view class="ledger-wallet"><text>我的金币</text><text>{{balanceText}}</text><text>{{balanceLoading?'同步中':'单位：金币'}}</text></view><view class="ledger-filters"><view bindtap="chooseFilter" data-filter="all" class="{{filter==='all'?'selected':''}}">全部</view><view bindtap="chooseFilter" data-filter="in" class="{{filter==='in'?'selected':''}}">收入</view><view bindtap="chooseFilter" data-filter="out" class="{{filter==='out'?'selected':''}}">支出</view></view><view wx:if="{{filter==='in'||filter==='out'}}" class="ledger-summary {{filter==='out'?'out-summary':''}}"><text>{{filter==='in'?'已加载收入':'已加载支出'}}</text><view>{{firstLoaded?(filter==='in'?'+'+loadedIncome:'−'+loadedExpense):'—'}}<text>金币</text></view><text>仅统计当前已加载记录</text></view><view class="ledger-list-heading"><text>收支记录</text><text>按发生时间排列</text></view></block>
 <yx-state wx:if="{{loading&&!firstLoaded}}" type="loading"/><yx-state wx:elif="{{error&&!firstLoaded}}" type="error" title="金币记录暂未加载" description="{{error}}" action="重新加载" bindaction="retry"/>
 <view wx:else class="ledger-list"><view class="ledger-item" wx:for="{{visibleList}}" wx:key="ledgerKey"><view class="ledger-mark {{item.income?'incoming':'outgoing'}}"><yx-icon name="{{item.income?'coin':'gift'}}" tone="{{item.income?'brand':'muted'}}" size="40"/></view><view class="ledger-item-copy"><text>{{item.displayTitle}}</text><text>{{item.displayDate}}</text></view><view class="ledger-amount {{item.income?'incoming':'outgoing'}}"><text>{{item.income?'+':'−'}}{{item.displayAmount}}</text></view></view><yx-state wx:if="{{!visibleList.length&&!error}}" type="empty" title="暂时没有这类记录" description="成功到账与兑换扣减后，可在这里核对。"/></view>
 <view wx:if="{{error&&firstLoaded}}" class="ui-error" bindtap="retry">{{error}}　重试</view><button wx:if="{{firstLoaded&&load&&!error}}" class="ui-text-button" bindtap="loadMore" loading="{{loading}}" disabled="{{loading}}">{{loading?'正在读取':'加载更多记录'}}</button><view class="ledger-foot">{{viewMode==='wallet'?'金币不是现金，不提供提现；兑换规则请查看商品说明。':'汇总仅统计当前已加载记录，不包含待核验奖励。'}}</view>
</view>
