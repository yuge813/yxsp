@import "./commerce.wxss";
.shop-title{display:flex;align-items:center;justify-content:space-between;padding:8rpx 0 32rpx;gap:24rpx}.shop-title>view{flex:1;min-width:0}.shop-title>view>text{font-size:24rpx;color:#A65F7D;display:block;margin-bottom:14rpx}.shop-title>view>view{font-size:58rpx;font-weight:800;letter-spacing:-2rpx;color:#27212C}.shop-wallet-pill{display:flex;align-items:center;gap:12rpx;border-radius:44rpx;background:#FFF0CE;color:#B73832;padding:18rpx 22rpx;font-size:30rpx;font-weight:700;max-width:46%;min-width:0}.shop-wallet-pill>text{min-width:0;word-break:break-all;font-variant-numeric:tabular-nums}.shop-cover{height:490rpx;position:relative;overflow:hidden;background:linear-gradient(130deg,#F4DCE3,#F9E7E9);border-radius:48rpx;margin-bottom:36rpx}.shop-cover-image{position:absolute;right:0;top:0;bottom:0;width:68%;opacity:.97}.shop-cover-image>image{width:100%;height:100%;display:block}.shop-cover-copy{position:relative;z-index:2;padding:38rpx 30rpx;width:69%;height:100%;background:linear-gradient(90deg,rgba(244,219,226,.98),rgba(246,224,231,.86) 64%,transparent)}.shop-cover-copy>.tag{font-size:22rpx;border-radius:12rpx;padding:7rpx 14rpx}.shop-cover-title{font-size:42rpx;line-height:1.65;font-weight:750;color:#713147;letter-spacing:-1rpx;margin:30rpx 0 24rpx}.shop-cover-title>text{display:block}.shop-cover-copy>text:not(.tag){display:block;font-size:24rpx;color:#A3627D;line-height:1.6;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:88%}.shop-filters{display:flex;gap:14rpx;overflow-x:auto;white-space:nowrap;margin:0 0 10rpx}.shop-filters>view{padding:16rpx 22rpx;font-size:27rpx;background:#FFF;color:#87677C;border-radius:40rpx;flex-shrink:0;min-height:88rpx;display:flex;align-items:center;justify-content:center}.shop-filters>.active{background:#DA0B3D;color:#FFF;font-weight:650}.shop-filter-scope{display:block;margin:-6rpx 0 22rpx;font-size:24rpx;color:#806574}.shop-goods{display:flex;flex-wrap:wrap;justify-content:space-between}.shop-product{width:48%;border:1rpx solid #F0DCE6;border-radius:32rpx;overflow:hidden;background:#FFF;margin-bottom:26rpx}.shop-product-image{height:288rpx;position:relative;background:linear-gradient(140deg,#F0CED6,#F9E8E9)}.shop-product-image>image{height:100%;width:100%;display:block}.shop-product-image>.tag{position:absolute;top:18rpx;left:18rpx;font-size:23rpx;background:#FFF1F3;color:#D31240;z-index:2}.shop-product-copy{padding:24rpx 22rpx}.shop-product-copy>text{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;height:84rpx;font-size:29rpx;font-weight:650;line-height:1.45;color:#27212C}.shop-product-copy>view{display:flex;align-items:baseline;gap:7rpx;margin-top:18rpx;color:#CF0D3E}.shop-product-copy>view>text:first-child{font-size:46rpx;line-height:1.2;font-weight:750;min-width:0;word-break:break-all}.shop-product-copy>view>text:nth-child(2){font-size:23rpx;white-space:nowrap}.shop-product-copy>view>yx-icon{margin-left:auto;flex-shrink:0}.shop-more{padding:32rpx 0;text-align:center;color:#806574;font-size:24rpx}.shop-ad{margin:32rpx 0}
