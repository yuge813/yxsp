page{background:#F5F3ED}.gift-page{padding-top:28rpx}.gift-header{position:relative;padding:0 80rpx 30rpx 0}.gift-header .ui-title{font-size:54rpx;line-height:1.25;margin-top:14rpx;font-weight:700;letter-spacing:-2rpx}.gift-header .ui-title text{display:block}.gift-header-mark{position:absolute;right:0;bottom:45rpx;transform:rotate(12deg);background:#E7EBDC;border-radius:24rpx;padding:14rpx}.gift-wallet{display:flex;align-items:center;justify-content:space-between;background:#20352E;color:#F8F5EB;border-radius:28rpx;padding:30rpx 32rpx;margin-bottom:34rpx}.gift-wallet>view>text{font-size:24rpx;color:#D9E2D3}.gift-balance{font-size:66rpx;line-height:1.25;font-weight:700;margin-top:8rpx;font-variant-numeric:tabular-nums}.gift-balance text{font-size:24rpx;margin-left:12rpx;font-weight:400}.gift-wallet-link{display:flex;align-items:center;gap:8rpx;font-size:24rpx;color:#F0EADD}.gift-tabs{display:flex;gap:44rpx;border-bottom:1rpx solid #D9DCD2;margin-bottom:30rpx;font-size:30rpx;color:#68756A}.gift-tabs>view,.gift-tabs>navigator{padding:0 0 22rpx;min-height:88rpx;display:flex;align-items:center}.gift-tabs .selected{font-weight:700;color:#20352E;border-bottom:6rpx solid #BF442A}.gift-grid{display:flex;flex-wrap:wrap;justify-content:space-between}.gift-item{width:48%;border-radius:24rpx;background:#FFFEFA;overflow:hidden;margin-bottom:28rpx;border:1rpx solid #E6E7DC}.gift-photo{height:300rpx;position:relative;background:#ECEDE4}.gift-item:nth-child(2n) .gift-photo{background:#E8E3D8}.gift-photo>image{width:100%;height:100%;display:block}.gift-fallback{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;color:#687568;font-size:22rpx;text-align:center}.gift-stock{position:absolute;left:16rpx;bottom:16rpx;background:#FFFEFA;white-space:nowrap;font-size:22rpx;padding:8rpx 14rpx;border-radius:8rpx;color:#65735F}.gift-copy{padding:24rpx 20rpx}.gift-name{font-size:29rpx;line-height:1.5;height:88rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:#20352E}.gift-price{display:flex;align-items:baseline;gap:8rpx;color:#B84225;margin-top:20rpx}.gift-price>text:first-child{font-size:38rpx;font-weight:700;min-width:0;overflow-wrap:anywhere}.gift-price>text:nth-child(2){font-size:22rpx;white-space:nowrap}.gift-price yx-icon{margin-left:auto;flex-shrink:0}.gift-more{text-align:center;color:#687564;font-size:24rpx;padding:30rpx 0}.gift-ad{margin:32rpx 0;position:relative;clear:both}

/* Keep large account values inside the wallet on narrow devices. */
.gift-wallet>view:first-child{flex:1;min-width:0;margin-right:24rpx}.gift-balance{min-width:0;overflow-wrap:anywhere;word-break:break-all}.gift-wallet-link{flex-shrink:0}
