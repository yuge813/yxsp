<view class="ui-page gift-page">
 <view class="gift-header"><text class="ui-kicker">把积累，换成日常喜欢</text><view class="ui-title">每一点坚持<text>都值得一份好礼。</text></view><view class="gift-header-mark"><yx-icon name="gift" tone="green" size="72"/></view></view>
 <navigator url="/sage_dksy/pages/user/integral" class="gift-wallet"><view><text>我的金币</text><view class="gift-balance">{{balance===null?'—':balance}}<text>金币</text></view></view><view class="gift-wallet-link">查看明细<yx-icon name="arrow" size="28" tone="light"/></view></navigator>
 <view class="gift-tabs"><view class="selected">金币兑换</view><navigator url="/sage_dksy/pages/trial/trial">商品试用</navigator></view>
 <view class="ui-section-head"><text>发现好礼</text><navigator url="/sage_dksy/pages/user/order">兑换记录 ›</navigator></view>
 <yx-state wx:if="{{loading&&!prize.length}}" type="loading"/>
 <yx-state wx:elif="{{error&&!prize.length}}" type="error" title="好礼暂时没有加载出来" description="请检查网络后重新试试。" action="重新加载" bindaction="retry"/>
 <yx-state wx:elif="{{!prize.length}}" type="empty" title="好礼正在准备中" description="新的好礼上架后，会出现在这里。"/>
 <block wx:else><view wx:if="{{error}}" class="ui-error" bindtap="retry">{{error}} · 点击重试</view><view class="gift-grid"><view wx:for="{{prize}}" wx:key="prize_id" class="gift-item" data-id="{{item.prize_id}}" bindtap="prize_show"><view class="gift-photo"><image wx:if="{{item.prize_picurl&&!item._imageFailed}}" src="{{item.prize_picurl}}" mode="aspectFit" lazy-load="{{true}}" binderror="onPrizeImageError" data-id="{{item.prize_id}}"/><view wx:else class="gift-fallback"><yx-icon name="gift" size="68" tone="muted"/><text>商品图片暂不可用</text></view><text wx:if="{{item.prize_num!==undefined&&item.prize_num<=0}}" class="gift-stock">暂时缺货</text></view><view class="gift-copy"><text class="gift-name">{{item.prize_title}}</text><view class="gift-price"><text>{{item.prize_integral}}</text><text>金币</text><yx-icon name="arrow" tone="brand" size="28"/></view></view></view></view><view class="gift-more" wx:if="{{loadingMore}}">正在加载更多好礼…</view><button wx:elif="{{moreError}}" class="ui-text-button" bindtap="loadMore">{{moreError}}</button><button wx:elif="{{hasMore}}" class="ui-text-button" bindtap="loadMore">继续发现好礼</button><view wx:else class="gift-more">这些喜欢，值得慢慢攒。</view></block>
 <view class="gift-ad"><ad-custom wx:if="{{v3Ready&&v3Unit}}" unit-id="{{v3Unit}}" bindload="onV3AdLoad" binderror="onV3AdError"/><ad wx:elif="{{adset.banner_prize_on===1&&adset.banner_id&&!bannerFailed}}" unit-id="{{adset.banner_id}}" bindload="onPrizeBannerLoad" binderror="onPrizeBannerError" bindclose="onPrizeBannerClose"/><yx22-ad wx:else placement="gift_native"/></view>
</view><include src="/sage_dksy/pages/nav/nav.wxml"/><yx22-popup scene="gift"/>
