<view class="cm-page cm-scope shop-page">
 <view class="shop-title"><view><text>用积累，兑换日常喜欢</text><view>金币好礼</view></view><navigator url="/sage_dksy/pages/user/integral" class="shop-wallet-pill"><yx-icon name="coin" tone="brand" size="34"/><text>{{balance===null?'—':balance}}</text></navigator></view>
 <view wx:if="{{featuredPrize}}" class="shop-cover" data-id="{{featuredPrize.prize_id}}" bindtap="prize_show"><view class="shop-cover-image"><image wx:if="{{featuredPrize.prize_picurl&&!featuredPrize._imageFailed}}" src="{{featuredPrize.prize_picurl}}" mode="aspectFill" binderror="onPrizeImageError" data-id="{{featuredPrize.prize_id}}"/><view wx:else class="cm-image-placeholder"><yx-icon name="gift" size="120" tone="brand"/></view></view><view class="shop-cover-copy"><text class="tag gold-tag">元享好礼</text><view class="shop-cover-title">让每一份积累，<text>都有新的喜欢。</text></view><text>{{featuredPrize.prize_title}}</text><text>{{featuredPrize._displayPrice}} 金币</text></view></view>
 <view class="shop-filters"><view class="{{filter==='all'?'active':''}}" data-filter="all" bindtap="changeFilter">全部</view><view class="{{filter==='ready'?'active':''}}" data-filter="ready" bindtap="changeFilter">可兑换</view><view class="{{filter==='saving'?'active':''}}" data-filter="saving" bindtap="changeFilter">继续积累</view><view class="{{filter==='soldout'?'active':''}}" data-filter="soldout" bindtap="changeFilter">已兑完</view></view>
 <view class="section"><text>为你精选</text><navigator url="/sage_dksy/pages/user/order">兑换记录 ›</navigator></view><text wx:if="{{filter!=='all'}}" class="shop-filter-scope">根据当前已加载商品与金币余额筛选</text>
 <yx-state wx:if="{{loading&&!prize.length}}" type="loading"/><yx-state wx:elif="{{error&&!prize.length}}" type="error" title="好礼暂时没有加载出来" description="请检查网络后重新试试。" action="重新加载" bindaction="retry"/><yx-state wx:elif="{{!prize.length}}" type="empty" title="好礼正在准备中" description="新的好礼上架后，会出现在这里。"/>
 <block wx:else><view wx:if="{{error}}" class="ui-error" bindtap="retry">{{error}} · 点击重试</view><view class="shop-goods"><view wx:for="{{filteredPrize}}" wx:key="prize_id" class="shop-product" data-id="{{item.prize_id}}" bindtap="prize_show"><view class="shop-product-image"><image wx:if="{{item.prize_picurl&&!item._imageFailed}}" src="{{item.prize_picurl}}" mode="aspectFill" lazy-load="{{true}}" binderror="onPrizeImageError" data-id="{{item.prize_id}}"/><view wx:else class="cm-image-placeholder"><yx-icon name="gift" size="76" tone="muted"/><text>商品图片暂不可用</text></view><text wx:if="{{item._canRedeem||item._soldOut}}" class="tag">{{item._soldOut?'已兑完':'可兑换'}}</text></view><view class="shop-product-copy"><text>{{item.prize_title}}</text><view><text>{{item._displayPrice}}</text><text>金币</text><yx-icon name="arrow" tone="brand" size="30"/></view></view></view></view><yx-state wx:if="{{!filteredPrize.length}}" type="empty" title="当前已加载商品中暂无此类好礼" description="试试其他分类，或继续加载更多商品。"/><view class="shop-more" wx:if="{{loadingMore}}">正在加载更多好礼…</view><button wx:elif="{{moreError}}" class="ui-text-button" bindtap="loadMore">{{moreError}}</button><button wx:elif="{{hasMore}}" class="ui-text-button" bindtap="loadMore">继续发现好礼</button><view wx:else class="shop-more">这些喜欢，值得慢慢攒。</view></block>
 <view class="shop-ad"><ad-custom wx:if="{{v3Ready&&v3Unit}}" unit-id="{{v3Unit}}" bindload="onV3AdLoad" binderror="onV3AdError"/><ad wx:elif="{{adset.banner_prize_on===1&&adset.banner_id&&!bannerFailed}}" unit-id="{{adset.banner_id}}" bindload="onPrizeBannerLoad" binderror="onPrizeBannerError" bindclose="onPrizeBannerClose"/><yx22-ad wx:else placement="gift_native"/></view>
</view><include src="/sage_dksy/pages/nav/nav.wxml"/><yx22-popup scene="gift"/>
