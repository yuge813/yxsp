<import src="../../wxParse/wxParse.wxml"/>
<view class="cm-scope">
 <view wx:if="{{loading&&!prize_show}}" class="cm-page"><yx-state type="loading"/></view><view wx:elif="{{pageError&&!prize_show}}" class="cm-page"><yx-state type="error" title="{{pageError}}" description="请稍后重试，或返回好礼挑选其他商品。" action="重新加载" bindaction="retry"/></view>
 <view wx:elif="{{orderSuccess}}" class="cm-page cm-result-page">
  <view class="cm-success-banner"><image class="cm-success-art" src="/sage_dksy/resource/red/hero.png" mode="aspectFit"/><view class="cm-result-check"><yx-icon name="yes" tone="brand" size="42"/></view><view class="cm-h1">兑换申请已提交</view><view class="cm-p">你的每一点积累，都有了新期待。</view></view>
  <view class="cm-ticket"><view class="cm-ticket-heading"><text>本次兑换</text><text class="tag">已提交</text></view><view class="cm-product-row"><view class="cm-mini-product"><image wx:if="{{prize_show.prize_picurl}}" src="{{prize_show.prize_picurl}}" mode="aspectFit"/></view><view class="cm-product-copy"><text class="cm-b">{{prize_show.prize_title}}</text><text>1 件</text><text class="cm-strong">{{prize_show.prize_integral}} <text class="cm-small">金币</text></text></view></view><view class="cm-ticket-divider"></view><view class="info-line"><text>商品所需金币</text><text class="cm-b">{{prize_show.prize_integral}} 金币</text></view><view class="info-line"><text>当前金币余额</text><text class="cm-b">{{resultBalance===null?'请到金币明细查看':resultBalance+' 金币'}}</text></view><view class="cm-p cm-muted">{{orderMessage}}</view></view>
  <navigator wx:if="{{resultBalance===null}}" url="/sage_dksy/pages/user/integral" class="small-link">查看金币明细</navigator><view class="cm-result-actions"><button class="ui-primary" bindtap="goOrders">查看兑换记录</button><button class="ui-secondary" bindtap="goGifts">继续挑选好礼</button></view><button class="cm-help-line ui-text-button" open-type="contact"><yx-icon name="support" size="32" tone="muted"/>需要帮助？联系客服</button>
 </view>
 <view wx:elif="{{prize_show&&detailView==='shortfall'}}" class="cm-page cm-with-footer cm-shortfall-page">
  <view class="cm-shortfall-hero"><text class="hero-kicker">离心仪好礼，又近了一点</text><view class="cm-h1">再攒 <text class="cm-b">{{shortfall}}</text> 金币<text>就够兑换了</text></view><image wx:if="{{prize_show.prize_picurl}}" class="cm-shortfall-product" src="{{prize_show.prize_picurl}}" mode="aspectFit"/></view><view class="cm-target-card"><text>{{prize_show.prize_title}}</text><view><text class="cm-strong">{{balance}}</text><text>/ {{prize_show.prize_integral}} 金币</text></view><view class="cm-progress-track"><view style="width:{{progressPercent}}%"></view></view><view class="cm-p">当前金币 {{balance}} · 还差 {{shortfall}} 金币</view></view>
  <view class="section"><text>今天可以继续积累</text></view><view class="card cm-earn-path" bindtap="goSign"><view class="cm-earn-icon"><yx-icon name="check" tone="brand" size="48"/></view><view><text class="cm-b">每日签到</text><view class="cm-p">查看今日签到奖励与连续进度</view></view><text>去签到 ›</text></view><view class="card cm-earn-path" bindtap="goTasks"><view class="cm-earn-icon"><yx-icon name="play" tone="brand" size="48"/></view><view><text class="cm-b">自愿看广告</text><view class="cm-p">完整观看后按实际规则领取</view></view><text>去观看 ›</text></view><view class="cm-notice"><yx-icon name="info" tone="brand" size="34"/><text>奖励按实际规则到账。先积累，再兑换喜欢。</text></view><button class="small-link" bindtap="viewProduct">返回商品详情</button><view class="cm-action-footer"><button class="ui-primary" bindtap="goTasks">去赚金币</button></view>
 </view>
 <view wx:elif="{{prize_show&&detailView==='soldout'}}" class="cm-flush cm-soldout-page">
  <view class="cm-photo-stage cm-soldout-stage"><image wx:if="{{prize_show.prize_picurl}}" src="{{prize_show.prize_picurl}}" mode="aspectFit"/><view wx:else class="cm-image-placeholder"><yx-icon name="gift" tone="muted" size="100"/></view><view class="cm-soldout-badge"><text>本轮好礼</text><text>已兑完</text></view></view><view class="cm-soldout-body"><view class="cm-cost"><text class="cm-strong">{{prize_show.prize_integral}}</text><text>金币</text><text class="tag gray-tag">暂时售罄</text></view><view class="cm-h1">{{prize_show.prize_title}}</view><view class="cm-p cm-muted">这一批好礼已经被领走啦。</view><view class="cm-soldout-note"><yx-icon name="gift" tone="brand" size="50"/><view><text class="cm-b">还有其他好礼，等你发现</text><view class="cm-p">商品与库存以当前上架信息为准。</view></view></view><button class="ui-primary cm-cta-disabled" disabled="{{true}}">暂时缺货 · 不可兑换</button><button class="small-link" bindtap="viewProduct">查看商品介绍</button><block wx:if="{{relatedGoods.length}}"><view class="section"><text>继续看看这些好礼</text></view><view class="cm-related-grid"><view wx:for="{{relatedGoods}}" wx:key="prize_id" class="cm-related-item" data-id="{{item.prize_id}}" bindtap="openRelated"><view><image wx:if="{{item.prize_picurl&&!item._imageFailed}}" src="{{item.prize_picurl}}" mode="aspectFit" binderror="relatedImageError" data-id="{{item.prize_id}}"/><yx-icon wx:else name="gift" tone="muted" size="60"/></view><text>{{item.prize_title}}</text><text>{{item.prize_integral}} 金币</text></view></view></block></view><view class="cm-action-footer"><button class="ui-primary" bindtap="goGifts">发现其他好礼</button></view>
 </view>
 <view wx:elif="{{prize_show}}" class="cm-flush cm-detail">
  <view wx:if="{{pageError}}" class="ui-error" bindtap="retry">{{pageError}} · 点击重试</view><view class="cm-photo-stage"><text class="cm-photo-stamp">元享好礼</text><swiper wx:if="{{prize_show.prize_pics.length}}" bindchange="onGalleryChange" current="{{photoIndex}}"><swiper-item wx:for="{{prize_show.prize_pics}}" wx:key="*this"><image src="{{item}}" mode="aspectFit" data-index="{{index}}" binderror="onProductImageError"/></swiper-item></swiper><view wx:else class="cm-image-placeholder"><yx-icon name="gift" tone="muted" size="100"/><text>商品图片暂不可用</text></view><text wx:if="{{prize_show.prize_pics.length}}" class="cm-photo-label">{{photoIndex+1}} / {{prize_show.prize_pics.length}}</text></view>
  <view class="cm-product-info"><view class="cm-cost"><text class="cm-strong">{{priceReady?prize_show.prize_integral:'待同步'}}</text><text>金币</text><text class="cm-small">{{stockReady?'库存 '+prize_show.prize_num+' 件':'库存待同步'}}</text></view><view class="cm-h1">{{prize_show.prize_title}}</view><view wx:if="{{prize_show.prize_price&&prize_show.prize_price!='0'}}" class="cm-p cm-muted">参考价 ¥{{prize_show.prize_price}}</view><view class="cm-can-redeem"><yx-icon name="{{shortfall===0?'yes':'coin'}}" tone="brand" size="32"/><text>我的金币 {{balance===null?'待同步':balance}}</text><text class="cm-b">{{shortfall===null?'余额待同步':shortfall>0?'还差 '+shortfall+' 金币':'当前可兑换'}}</text></view></view>
  <view wx:if="{{prize_show.prize_type==0}}" class="card cm-address-select" bindtap="yx29OpenAddressBook"><yx-icon name="location" tone="brand" size="44"/><view><text class="cm-b">{{selectedAddress?selectedAddress.name+'　'+selectedAddress.viewPhone:'选择收货地址'}}</text><view class="cm-p">{{selectedAddress?selectedAddress.viewAddress:'选择本机地址，或使用微信收货地址'}}</view></view><yx-icon name="arrow" tone="muted" size="30"/></view>
  <view wx:if="{{prize_show.prize_type==1}}" class="cm-virtual"><text class="cm-input-label">虚拟商品接收信息</text><textarea class="cm-field" value="{{remark}}" bindinput="beizhu" maxlength="150" placeholder="请按商品说明填写接收信息"/></view>
  <view class="cm-service-grid"><view><yx-icon name="shield" tone="muted" size="34"/>兑换信息可查</view><navigator url="/sage_dksy/pages/user/order"><yx-icon name="order" tone="muted" size="34"/>订单进度可查</navigator></view>
  <view class="section"><text>商品详情</text></view><view class="card cm-detail-copy"><template is="wxParse" data="{{wxParseData:content.nodes}}"/><view class="cm-detail-rules"><view class="info-line"><text>兑换数量</text><text class="cm-b">1 件</text></view><view class="info-line" wx:if="{{balanceAfter!==null&&shortfall===0}}"><text>兑换后金币</text><text class="cm-b">{{balanceAfter}} 金币</text></view><view class="cm-p">库存、扣除及配送规则以提交时的实际状态和商品说明为准。</view></view></view>
  <view wx:if="{{v10shareOn||v10posterOn}}" class="cm-product-share"><button wx:if="{{v10shareOn}}" class="ui-secondary" open-type="share">分享商品</button><button wx:if="{{v10posterOn}}" class="ui-secondary" bindtap="v10Poster">制作海报</button></view><view class="cm-product-ad" wx:if="{{v3Ready&&v3Unit}}"><ad unit-id="{{v3Unit}}" bindload="onV3AdLoad" binderror="onV3AdError"/></view><view wx:if="{{orderMessage}}" class="ui-error">{{orderMessage}}<navigator url="/sage_dksy/pages/user/order">查看兑换记录 ›</navigator></view>
  <view class="cm-action-footer"><view class="footer-price"><text class="cm-b">{{priceReady?prize_show.prize_integral:'—'}}</text><text>金币</text></view><button class="ui-primary" bindtap="duihuan" loading="{{submitting}}" disabled="{{!orderUnknown&&(loading||submitting||!accountReady||balance===null||!priceReady||!stockReady)}}">{{orderUnknown?'核对兑换记录':loading?'刷新中':!stockReady||!priceReady?'状态待同步':prize_show.prize_num<=0?'本轮已兑完':shortfall>0?'金币还差一点':'立即兑换'}}</button></view>
 </view>
</view>
<view wx:if="{{confirmVisible}}" class="cm-confirm-modal cm-scope" catchtouchmove="stopTouch"><view class="cm-confirm-scrim" bindtap="closeConfirmation"></view><view class="cm-confirm-sheet"><view class="cm-sheet-heading"><view><text>再确认一次，就能带走喜欢。</text><view class="cm-h2">确认兑换</view></view><button bindtap="closeConfirmation" disabled="{{submitting}}" aria-label="关闭确认"><yx-icon name="close" tone="muted" size="42"/></button></view><view class="cm-product-row"><view class="cm-mini-product"><image wx:if="{{prize_show.prize_picurl}}" src="{{prize_show.prize_picurl}}" mode="aspectFit"/></view><view class="cm-product-copy"><text class="cm-b">{{prize_show.prize_title}}</text><text>1 件</text><text class="cm-strong">{{prize_show.prize_integral}} <text class="cm-small">金币</text></text></view></view><view class="cm-confirm-money"><view class="info-line"><text>当前金币</text><text class="cm-b">{{balance}}</text></view><view class="info-line"><text>本次扣除</text><text class="cm-b">−{{prize_show.prize_integral}}</text></view><view class="info-line total" wx:if="{{balanceAfter!==null}}"><text>兑换后剩余</text><text class="cm-b">{{balanceAfter}} 金币</text></view></view><view class="cm-sheet-address" wx:if="{{prize_show.prize_type==0&&selectedAddress}}"><yx-icon name="location" tone="brand" size="42"/><view><text class="cm-b">{{selectedAddress.name}}　{{selectedAddress.viewPhone}}</text><view class="cm-p">{{selectedAddress.viewAddress}}</view></view><button bindtap="closeConfirmation" disabled="{{submitting}}">修改</button></view><view wx:elif="{{prize_show.prize_type==1}}" class="cm-sheet-address"><text>接收信息：{{remark}}</text></view><view class="cm-p cm-confirm-note">请核对商品、收货信息与兑换规则。<text>提交后可在兑换记录查看处理进度。</text></view><button class="ui-primary" bindtap="confirmRedeem" disabled="{{submitting}}" loading="{{submitting}}">{{submitting?'正在提交，请稍候':'确认扣除 '+prize_show.prize_integral+' 金币'}}</button><button class="small-link" bindtap="closeConfirmation" disabled="{{submitting}}">暂不兑换</button></view></view>
