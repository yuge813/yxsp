<import src="../../wxParse/wxParse.wxml"/>
<view class="detail-page">
 <yx-state wx:if="{{loading&&!prize_show}}" type="loading"/>
 <yx-state wx:elif="{{pageError&&!prize_show}}" type="error" title="{{pageError}}" description="请稍后重试，或返回好礼挑选其他商品。" action="重新加载" bindaction="retry"/>
 <block wx:elif="{{orderSuccess}}"><view class="redeem-success"><view class="success-icon"><yx-icon name="yes" size="70" tone="green"/></view><text class="ui-kicker">把积累，换成喜欢</text><view class="ui-title">兑换申请已提交</view><text class="ui-lead">{{orderMessage}}</text><view class="success-product"><image wx:if="{{prize_show.prize_picurl}}" src="{{prize_show.prize_picurl}}" mode="aspectFit"/><view><text>{{prize_show.prize_title}}</text><text>{{prize_show.prize_integral}} 金币 · 1 件</text></view></view><button class="ui-primary" bindtap="goOrders">查看兑换记录</button><button class="ui-secondary" bindtap="goGifts">继续发现好礼</button><button class="ui-text-button" open-type="contact">需要帮助？联系客服</button></view></block>
 <block wx:elif="{{prize_show}}">
 <view wx:if="{{pageError}}" class="ui-error" bindtap="retry">{{pageError}} · 点击重试</view>
 <view class="product-gallery"><swiper wx:if="{{prize_show.prize_pics.length}}" class="product-swiper" indicator-dots="{{prize_show.prize_pics.length>1}}" indicator-color="#c0c8ba" indicator-active-color="#20352E"><swiper-item wx:for="{{prize_show.prize_pics}}" wx:key="*this"><image class="product-photo" src="{{item}}" mode="aspectFit" data-index="{{index}}" binderror="onProductImageError"/></swiper-item></swiper><view wx:else class="product-noimage"><yx-icon name="gift" size="100" tone="muted"/><text>商品图片暂不可用</text></view></view>
 <view class="product-body"><view class="product-price"><view><text>{{prize_show.prize_integral}}</text><text>{{setinfo.integral_title||'金币'}}</text></view><text>{{stockReady?'库存 '+prize_show.prize_num+' 件':'库存待同步'}}</text></view><view class="product-title">{{prize_show.prize_title}}</view><text wx:if="{{prize_show.prize_price&&prize_show.prize_price!='0'}}" class="product-reference">参考价 ¥{{prize_show.prize_price}}</text>
 <view class="product-balance"><yx-icon name="coin" tone="green" size="34"/><view><text>我的金币 {{balance===null?'读取中':balance}}</text><text wx:if="{{shortfall!==null}}">{{shortfall>0?'还差 '+shortfall+' 金币':'当前余额可兑换'}}</text></view><view wx:if="{{shortfall>0}}" bindtap="goTasks">去积累 ›</view></view>
 <view wx:if="{{prize_show.prize_type==0}}" class="product-address"><view class="address-target" bindtap="yx35PickWechatAddress"><yx-icon name="location" tone="ink" size="40"/><view wx:if="{{selectedAddress}}"><text>{{selectedAddress.name}}　{{selectedAddress.viewPhone}}</text><text>{{selectedAddress.viewAddress}}</text></view><view wx:else><text>选择收货地址</text><text>使用微信地址或手动填写</text></view><yx-icon name="arrow" tone="muted" size="28"/></view><button class="address-manual" bindtap="yx29OpenAddressBook">管理本机地址簿</button></view>
 <view wx:if="{{prize_show.prize_type==1}}" class="product-remark"><text class="ui-label">虚拟商品接收信息</text><textarea class="ui-input" value="{{remark}}" maxlength="150" bindinput="beizhu" placeholder="请按商品说明填写接收信息"/></view>
 <view class="product-share" wx:if="{{v10shareOn||v10posterOn}}"><button wx:if="{{v10shareOn}}" class="ui-secondary" open-type="share"><yx-icon name="share" size="30" tone="ink"/> 分享好礼</button><button wx:if="{{v10posterOn}}" class="ui-secondary" bindtap="v10Poster">制作海报</button></view>
 <view class="product-rules"><text>兑换前请确认</text><view>兑换数量<text>1 件</text></view><view>本次扣除<text>{{prize_show.prize_integral}} 金币</text></view><view wx:if="{{balanceAfter!==null&&shortfall===0}}">兑换后余额<text>{{balanceAfter}} 金币</text></view><text class="rule-note">配送和兑换规则以本商品介绍为准；库存与金币由提交时的实际状态确认。</text></view>
 <view class="product-ad" wx:if="{{v3Ready&&v3Unit}}"><ad unit-id="{{v3Unit}}" bindload="onV3AdLoad" binderror="onV3AdError"/></view>
 <view class="product-description"><view class="ui-section-head"><text>商品介绍</text></view><template is="wxParse" data="{{wxParseData:content.nodes}}"/></view>
 <view wx:if="{{orderMessage}}" class="ui-error">{{orderMessage}}<navigator url="/sage_dksy/pages/user/order">查看兑换记录 ›</navigator></view>
 </view><view class="product-footer"><view><text>合计</text><text>{{prize_show.prize_integral}}</text><text>金币</text></view><button class="ui-primary" bindtap="duihuan" loading="{{submitting}}" disabled="{{loading||submitting||!accountReady||balance===null||!priceReady||!stockReady||prize_show.prize_num<=0||shortfall>0}}">{{orderUnknown?'核对兑换记录':(loading?'刷新中':(balance===null?'余额待同步':(!priceReady||!stockReady?'状态待同步':(prize_show.prize_num<=0?'暂时缺货':(shortfall>0?'金币还差一点':'立即兑换')))))}}</button></view>
 </block>
</view>
<view wx:if="{{confirmVisible}}" class="redeem-mask" catchtouchmove="stopTouch"><view class="redeem-overlay" bindtap="closeConfirmation"></view><view class="redeem-sheet"><view class="sheet-heading"><text>确认兑换</text><button bindtap="closeConfirmation" disabled="{{submitting}}" aria-label="关闭确认"><yx-icon name="close" size="38" tone="muted"/></button></view><view class="confirm-product"><image wx:if="{{prize_show.prize_picurl}}" src="{{prize_show.prize_picurl}}" mode="aspectFit"/><view><text>{{prize_show.prize_title}}</text><text>1 件 · {{prize_show.prize_integral}} 金币</text></view></view><view class="confirm-lines"><view>当前金币<text>{{balance===null?'提交时确认':balance}}</text></view><view>本次扣除<text>{{prize_show.prize_integral}} 金币</text></view><view wx:if="{{balanceAfter!==null}}">兑换后剩余<text>{{balanceAfter}} 金币</text></view></view><view class="confirm-destination" wx:if="{{prize_show.prize_type==0&&selectedAddress}}"><yx-icon name="location" size="34" tone="ink"/><view><text>{{selectedAddress.name}}　{{selectedAddress.viewPhone}}</text><text>{{selectedAddress.viewAddress}}</text></view></view><view class="confirm-destination" wx:if="{{prize_show.prize_type==1}}"><text>接收信息：{{remark}}</text></view><text class="confirm-note">请核对以上信息。提交后可在兑换记录查看处理进度。</text><button class="ui-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="confirmRedeem">{{submitting?'正在提交，请稍候':'确认扣除 '+prize_show.prize_integral+' 金币'}}</button><button class="ui-text-button" disabled="{{submitting}}" bindtap="closeConfirmation">暂不兑换</button></view></view>
