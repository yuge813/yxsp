.auth-page{padding-top:68rpx}.auth-mark{width:144rpx;height:144rpx;background:#E2E7D7;display:flex;align-items:center;justify-content:center;border-radius:40rpx;margin-bottom:56rpx;transform:rotate(-5deg)}.auth-copy .ui-kicker{margin-bottom:20rpx}.auth-title{display:block;font-size:68rpx;line-height:1.35;font-weight:700;letter-spacing:-2rpx}.auth-title>text{display:block}.auth-description{display:block;font-size:29rpx;line-height:1.9;color:#63715F;margin-top:28rpx;max-width:620rpx}.auth-permissions{display:flex;align-items:center;gap:20rpx;padding:26rpx;margin-top:44rpx;font-size:26rpx;line-height:1.8}.auth-permissions text{flex:1}.auth-actions{display:flex;flex-direction:column;gap:20rpx;margin-top:52rpx}.auth-note{display:block;text-align:center;font-size:24rpx;color:#657262;margin-top:36rpx}
