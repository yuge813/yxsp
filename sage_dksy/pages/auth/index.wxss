.auth-page{padding:32rpx 34rpx calc(52rpx + env(safe-area-inset-bottom));color:#27212C}.auth-stage{position:relative;overflow:hidden;min-height:470rpx;border-radius:36rpx;background:radial-gradient(ellipse at 100% 80%,#FF7A4B66,transparent 60%),linear-gradient(135deg,#CF0636,#FA2943 70%,#FF5942);padding:38rpx 34rpx;color:#FFFFFF}.auth-stage>text{display:block;font-size:24rpx;letter-spacing:3rpx;color:#FFE7E9;position:relative;z-index:2}.auth-stage>.auth-headline{position:relative;z-index:2;font-size:50rpx;font-weight:700;line-height:1.38;margin-top:26rpx;max-width:480rpx}.auth-stage>view>text{display:block;color:#FFE49F}.auth-stage>image{position:absolute;width:300rpx;height:280rpx;right:4rpx;bottom:-20rpx;z-index:1}.auth-stage-ring{position:absolute;right:-112rpx;top:78rpx;width:390rpx;height:390rpx;border:1rpx solid #FFE2C755;border-radius:50%;box-shadow:0 0 0 40rpx #FFE2C710}.auth-copy{padding:34rpx 4rpx 20rpx}.auth-copy>text:first-child{display:block;font-size:36rpx;font-weight:650;line-height:1.5}.auth-copy>text:last-child{display:block;font-size:27rpx;line-height:1.9;color:#806574;margin-top:16rpx}.auth-permissions{display:flex;align-items:center;gap:18rpx;background:#FFFFFF;border:1rpx solid #F0DDE6;border-radius:24rpx;padding:24rpx;margin:10rpx 0 34rpx;font-size:25rpx;line-height:1.8;color:#806574}.auth-permissions>text{flex:1}.auth-actions{display:flex;flex-direction:column;gap:20rpx}.auth-note{display:block;text-align:center;font-size:24rpx;color:#806574;margin-top:30rpx}

.auth-stage>.auth-brand{position:relative;z-index:2;display:flex;align-items:center;gap:18rpx}.auth-brand>text{font-size:28rpx;color:#FFE9E2;font-weight:600;line-height:1.5}.auth-brand>.yx-brand-badge{width:84rpx;height:84rpx}
