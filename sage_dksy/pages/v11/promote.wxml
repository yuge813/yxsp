<view class="social-page {{view==='poster'?'social-poster-page':'social-invite-page'}}">
 <block wx:if="{{view==='hub'}}">
  <view class="social-invite-stage"><text class="social-stage-label">元享 · 一级推广</text><view class="social-stage-headline">好礼一起攒<text>快乐一起享</text></view><text class="social-stage-copy">直属一级邀请，和朋友一起享</text><image class="social-stage-art" src="/sage_dksy/resource/red/hero.png" mode="aspectFit"/><view class="social-stage-spark">✦</view><view class="social-invite-person"><image wx:if="{{avatar}}" class="social-person-avatar" src="{{avatar}}" mode="aspectFill" binderror="avatarError"/><view wx:else class="social-person-avatar"><yx-icon name="user" tone="brand" size="52"/></view><view><text>{{nickname?nickname+'的专属邀请':'我的专属邀请'}}</text><text>把元享分享给你在意的人</text></view></view></view>
  <view class="social-invite-body"><view class="social-ticket"><view class="social-ticket-top" bindtap="goFriends"><yx-icon name="friend" tone="brand" size="40"/><text>一级好友</text><view class="social-ticket-count">{{total===null?'—':total}}<text> 位</text></view><view class="social-ticket-records">一级记录<yx-icon name="arrow" tone="brand" size="26"/></view></view><view class="social-direct-summary"><text>今日新增 <text>{{today===null?'—':today}} 位</text></text><text>仅统计服务端确认的直属一级好友</text></view><view class="social-ticket-body"><view><text class="social-caption">你的专属邀请入口</text><view class="social-ticket-title">让朋友，和你一起享</view><text class="social-ticket-copy">扫码了解元享，自主选择参与。</text></view><view class="social-code-small"><image wx:if="{{qrReady&&qrLocalPath}}" src="{{qrLocalPath}}" mode="aspectFit" binderror="qrError"/><view wx:else class="social-code-pending"><yx-icon name="grid" tone="muted" size="46"/><text>{{connecting?'连接中':profileError?'待连接':'专属码准备中'}}</text></view></view></view><button class="social-main-button" bindtap="openPoster" disabled="{{connecting}}">制作专属邀请海报</button><view wx:if="{{profileError}}" class="social-connection"><text>账户连接暂未成功</text><button bindtap="init" disabled="{{connecting}}">重新连接</button></view><view wx:elif="{{!qrReady&&!connecting&&qrStage}}" class="social-connection"><text>专属小程序码暂未准备好</text><button bindtap="retryQr">重试</button></view></view>
   <view wx:if="{{notice}}" class="social-referral-error"><text>{{notice}}</text><button bindtap="retryRecords" disabled="{{connecting||loading}}">重新连接</button></view><view class="social-section-title">邀请很简单</view><view class="social-invite-steps"><view><yx-icon name="share" tone="brand" size="48"/><text>分享邀请</text><text>发送小程序或海报</text></view><text>›</text><view><yx-icon name="user" tone="brand" size="48"/><text>好友加入</text><text>自愿打开并连接</text></view><text>›</text><view><yx-icon name="gift" tone="brand" size="48"/><text>一起发现</text><text>签到、赚币、挑好礼</text></view></view><view class="social-referral-rules"><view class="social-referral-heading"><view><yx-icon name="shield" tone="brand" size="40"/><text>一级推广，归属清楚</text></view><button bindtap="goReferralRules">完整说明 ›</button></view><view class="social-referral-rule"><text>01</text><view><text>只记录你直接邀请的好友</text><text>好友通过你的专属小程序或海报进入；好友再邀请的人不计入你的一级好友。</text></view></view><view class="social-referral-rule"><text>02</text><view><text>首次登录后，由系统核验</text><text>有效邀请来源与新注册资格以服务端确认为准，分享次数和浏览次数不等于成功邀请。</text></view></view><view class="social-referral-rule"><text>03</text><view><text>已有邀请关系不覆盖</text><text>不支持邀请自己；仅建立首次有效一级关系，以实际归属记录为准。</text></view></view><view class="social-my-inviter"><text>我的邀请人</text><text>{{inviter}}</text></view></view>
   <view class="social-referral-campaign"><view class="social-referral-heading"><view><yx-icon name="coin" tone="brand" size="40"/><text>推广活动奖励</text></view><text>{{rewardInfo.approved?'已发布活动':campaignReady?'暂无可展示活动':'待同步'}}</text></view><block wx:if="{{rewardInfo.approved}}"><view class="social-referral-cap" wx:if="{{rewardInfo.cap!==null}}"><text>每位符合条件好友的奖励上限</text><text>{{rewardInfo.cap}}<text> 金币</text></text></view><view wx:for="{{rewardInfo.stages}}" wx:key="label" class="social-referral-stage"><text>{{item.label}}</text><text>+{{item.coins}} 金币</text></view><text class="social-referral-caption">须满足已发布活动条件，奖励以实际到账为准。</text></block><text wx:elif="{{campaignReady}}" class="social-referral-caption">当前未读取到已发布的可领取推广活动。邀请关系照常记录，分享本身不代表奖励到账。</text><text wx:elif="{{notice||profileError}}" class="social-referral-caption">活动信息暂未确认，请重新连接后查看；当前不展示奖励金额。</text><text wx:else class="social-referral-caption">正在同步活动信息；未确认前不显示奖励金额。</text><view class="social-referral-links"><button bindtap="goReferralRules">一级推广与奖励说明 ›</button><button bindtap="goReferralLedger">核对金币明细 ›</button></view></view><view class="social-hub-actions"><button open-type="share"><yx-icon name="share" tone="brand" size="34"/>分享给微信好友</button><button bindtap="openGuide">查看分享指引</button></view>
  </view>
 </block>
 <block wx:else>
  <view class="social-poster-content"><view class="social-poster-intro"><view>把喜欢，分享给朋友。</view><text>专属小程序码，让好友找到你。</text></view><view wx:if="{{posterPath&&generatedTheme===selectedTheme}}" class="social-generated-poster" bindtap="previewPoster"><image src="{{posterPath}}" mode="widthFix"/></view><view wx:else class="social-poster social-poster-theme-{{selectedTheme}}"><view class="social-poster-brand"><view>享</view><text>元享</text><text>每天一点金币，每天一点惊喜</text></view><view class="social-poster-title">好礼，<text>就要一起享。</text></view><text class="social-poster-sub">签到赚金币 · 好物随心换</text><view class="social-poster-orbit"></view><image class="social-poster-art" src="/sage_dksy/resource/red/hero.png" mode="aspectFit"/><view class="social-poster-bottom"><view class="social-poster-person"><view><yx-icon name="user" tone="brand" size="44"/></view><view><text>{{nickname?'好友'+nickname+'邀请你':'元享好友邀请你'}}</text><text>长按识别，开启元享</text></view></view><view class="social-poster-code"><image wx:if="{{qrReady&&qrLocalPath}}" src="{{qrLocalPath}}" mode="aspectFit" binderror="qrError"/><view wx:else class="social-code-pending"><yx-icon name="grid" tone="muted" size="48"/><text>专属码准备中</text></view></view></view></view>
   <view class="social-poster-themes"><text>海报风格</text><button wx:for="{{themes}}" wx:key="id" class="social-theme-choice theme-{{index}} {{selectedTheme===index?'selected':''}}" data-index="{{index}}" bindtap="onPosterTap" aria-label="{{item.name}}" disabled="{{drawing||saveBusy}}"><view></view></button></view><view wx:if="{{drawing}}" class="social-poster-status">{{qrStage||'正在生成专属海报，请稍候'}}</view><view wx:elif="{{profileError}}" class="social-poster-retry"><text>账户暂时没有连接成功</text><button bindtap="init" disabled="{{connecting}}">重新连接</button></view><view wx:elif="{{!qrReady}}" class="social-poster-retry"><text>{{connecting?'正在连接账户':'真实专属码尚未准备好'}}</text><button wx:if="{{!connecting}}" bindtap="retryQr">重新获取</button></view><text class="social-poster-notice">海报使用真实专属小程序码；保存后可自主发送给好友。</text><text wx:if="{{posterPath}}" class="social-poster-notice">点击海报可查看完整高清图。</text>
  </view><view class="social-poster-footer"><button class="social-main-button" bindtap="saveQrPoster" loading="{{drawing||saveBusy}}" disabled="{{connecting||drawing||saveBusy||!code}}">{{drawing?'正在生成':'保存专属海报'}}</button><button class="social-secondary-button" bindtap="openGuide">分享指引</button></view>
 </block>
 <view wx:if="{{guideOpen}}" class="social-guide-overlay" catchtouchmove="noop"><scroll-view scroll-y="true" class="social-guide-scroll"><view class="social-guide-arrow"><view></view><view></view></view><view class="social-guide-copy"><text>分享方式 01</text><view>点右上角「···」<text>邀请朋友来元享</text></view><text>在微信原生菜单中选择分享，<text>好友由你自主选择。</text></text></view><view class="social-guide-sheet"><view class="social-guide-sheet-head"><view><yx-icon name="share" tone="brand" size="48"/></view><view><text>也可以分享专属海报</text><text>保存后，在微信聊天中发送图片</text></view></view><view class="social-guide-step"><text>1</text><text>返回海报页面，保存专属海报</text></view><view class="social-guide-step"><text>2</text><text>打开微信聊天，自主选择发送对象</text></view><view class="social-guide-step"><text>3</text><text>好友扫码，了解并自愿参与</text></view><button class="social-guide-native" open-type="share">使用微信原生分享</button><button class="social-gold-button" bindtap="closeGuide">我知道了</button></view><text class="social-guide-footnote">不强制分享，不要求选择指定好友</text></scroll-view></view>
 <canvas canvas-id="v11ShareCanvas" class="social-canvas"/>
</view>
