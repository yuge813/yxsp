<view class="invite-page ui-page invite-size-{{fontScale}}">
 <view class="invite-hero"><text class="invite-kicker">元享邀请 / 一起发现日常好礼</text><view class="invite-title">喜欢的生活，<text>值得一起分享。</text></view><text class="invite-description">把元享分享给朋友，同行的每一步都有记录。</text><button class="invite-main" bindtap="openPoster">制作专属邀请海报 <yx-icon name="arrow" tone="light" size="32"/></button><view class="invite-code"><view><text>我的邀请编号</text><text>{{code||'正在连接账户'}}</text></view><button bindtap="copyCode" disabled="{{!code}}">复制</button></view><view wx:if="{{profileError}}" class="invite-profile-error" bindtap="init">{{profileError}} · 点击重试</view></view>
 <view class="invite-metrics"><view><text>{{metricsReady?total:'—'}}</text><text>成功邀请</text></view><view><text>{{metricsReady?today:'—'}}</text><text>今日新增</text></view><yx-icon name="friend" tone="green" size="64"/></view><text class="invite-metric-note">统计已绑定的一级邀请关系，扫码和浏览不计入。</text>
 <view class="invite-section ui-card"><view class="invite-section-heading" bindtap="togglePoster"><view><text class="invite-section-kicker">01 / 我的海报</text><view class="invite-section-title">把邀请，做成一张好看的图。</view></view><yx-icon name="{{posterExpanded?'close':'arrow'}}" tone="muted" size="30"/></view><view wx:if="{{!posterExpanded}}" class="invite-poster-teaser" bindtap="openPoster"><view><yx-icon name="image" tone="green" size="62"/></view><view><text>选择专属海报风格</text><text>真实小程序码 · 预览后保存</text></view><yx-icon name="arrow" tone="muted" size="30"/></view>
  <view wx:else><view class="invite-poster-caption"><text>{{selectedName}}</text><text>{{selectedTheme+1}} / {{themes.length}}</text></view><view class="invite-poster-frame"><swiper class="invite-poster-swiper" current="{{selectedTheme}}" circular="true" bindchange="onPosterSwipe" duration="240"><swiper-item wx:for="{{themes}}" wx:key="id"><image class="invite-poster-surface" src="{{item.src}}" mode="scaleToFill"/><image wx:if="{{qrReady&&qrLocalPath}}" class="invite-poster-qr" style="left:{{item.qrLeft}}%;top:{{item.qrTop}}%;width:{{item.qrWPct}}%;height:{{item.qrHPct}}%;" src="{{qrLocalPath}}" mode="scaleToFill"/><view wx:else class="invite-qr-pending" style="left:{{item.qrLeft}}%;top:{{item.qrTop}}%;width:{{item.qrWPct}}%;height:{{item.qrHPct}}%;"><yx-icon name="grid" tone="muted" size="38"/><text>专属码准备中</text></view></swiper-item></swiper></view><scroll-view scroll-x="true" class="invite-poster-choices" show-scrollbar="false"><view class="invite-poster-choice-row"><view wx:for="{{themes}}" wx:key="id" data-index="{{index}}" bindtap="onPosterTap" class="invite-poster-choice {{selectedTheme===index?'is-selected':''}}"><image src="{{item.src}}" mode="aspectFill"/><text>{{item.name}}</text></view></view></scroll-view><view wx:if="{{!qrReady}}" class="invite-qr-status"><text>{{qrStage||'正在准备真实专属小程序码'}}</text><button bindtap="retryQr" disabled="{{drawing}}">重试</button></view><button class="ui-primary" bindtap="saveQrPoster" loading="{{drawing}}" disabled="{{drawing||!code}}">{{drawing?'正在生成高清海报':'生成并保存海报'}}</button><view class="invite-action-row"><button class="ui-secondary" bindtap="makeQr" disabled="{{drawing||!code}}">高清预览</button><button wx:if="{{code}}" class="ui-secondary" open-type="share">分享给微信好友</button></view><view wx:if="{{posterPath&&generatedTheme===selectedTheme}}" class="invite-ready" bindtap="previewPoster"><image src="{{posterPath}}" mode="aspectFill"/><view><text>这张海报已经生成</text><text>点击查看完整高清图</text></view><yx-icon name="arrow" tone="muted" size="30"/></view><text class="invite-footnote">好友登录后，按平台规则确认邀请关系。</text></view>
 </view>
 <navigator class="invite-friends" url="/sage_dksy/pages/v132grow/index"><view class="invite-friends-mark"><yx-icon name="leaf" tone="green" size="44"/></view><view><text>好友同行与成长</text><text>我的一级好友 · 7日成长进度</text></view><yx-icon name="arrow" tone="ink" size="34"/></navigator>
 <view class="invite-section ui-card"><view class="invite-section-heading"><view><text class="invite-section-kicker">02 / 同行记录</text><view class="invite-section-title">成功邀请的朋友</view></view><text class="invite-total">{{metricsReady?total:'—'}} 人</text></view><yx-state wx:if="{{loading&&!items.length}}" type="loading" title="正在读取邀请记录"/><yx-state wx:elif="{{notice&&!items.length}}" type="error" title="邀请记录暂时没有加载出来" description="请稍后重试，已有邀请关系不受影响" action="重新加载" bindaction="retryRecords"/><yx-state wx:elif="{{!items.length}}" type="empty" title="等一位朋友，一起开始" description="好友登录并成功归属后，会显示在这里" action="制作邀请海报" bindaction="openPoster"/><view wx:for="{{items}}" wx:key="member_mask" class="invite-friend-row"><view class="invite-friend-avatar"><yx-icon name="user" tone="green" size="40"/></view><view class="invite-friend-body"><text>{{item.nickname||'元享好友'}}</text><text>{{item.member_mask}}</text><text>绑定 {{item.bindText}}</text></view><view class="invite-friend-meta"><text>已绑定</text><text>{{item.balance_visible?'余额 '+item.balance:'余额未公开'}}</text></view></view><button wx:if="{{items.length&&hasMore}}" class="ui-text-button" bindtap="load" disabled="{{loading}}" loading="{{loading}}">{{notice?'加载未成功，点击重试':'查看更多邀请记录'}}</button></view>
 <view class="invite-section ui-card"><view class="invite-fold" bindtap="toggleWallet"><view><text>我的金币账本</text><text>余额与流水累计分开统计</text></view><yx-icon name="{{walletExpanded?'close':'arrow'}}" tone="muted" size="30"/></view><view wx:if="{{walletExpanded}}" class="invite-wallet"><view><text>{{walletReady?currentBalance:'—'}}</text><text>当前余额</text></view><view><text>{{walletReady?ledgerReceived:'—'}}</text><text>流水累计获得</text></view><text wx:if="{{!ledgerComplete}}" class="invite-wallet-note">历史流水尚未完全对账，累计获得可能不完整。</text><navigator url="/sage_dksy/pages/user/integral">查看金币明细 ›</navigator></view></view>
 <view class="invite-section ui-card"><view class="invite-fold" bindtap="toggleSettings"><view><text>隐私与辅助设置</text><text>你可以随时调整自己的偏好</text></view><yx-icon name="{{settingsExpanded?'close':'arrow'}}" tone="muted" size="30"/></view><view wx:if="{{settingsExpanded}}"><view class="invite-setting"><view><text>向邀请人展示金币余额</text><text>默认关闭，可随时撤回</text></view><switch checked="{{showBalance}}" bindchange="privacy" color="#20352E"/></view><view class="invite-setting"><view><text>操作语音</text><text>主动开启后使用</text></view><switch checked="{{voiceOn}}" bindchange="voice" color="#20352E"/></view><view class="invite-font-setting"><text>字体大小</text><radio-group bindchange="font"><label><radio value="1" checked="{{fontScale===1}}" color="#20352E"/>标准</label><label><radio value="2" checked="{{fontScale===2}}" color="#20352E"/>较大</label><label><radio value="3" checked="{{fontScale===3}}" color="#20352E"/>最大</label></radio-group></view></view></view>
 <text class="invite-bottom">邀请归属：{{inviter||'正在读取'}}<text>如有疑问，请联系元享客服核实。</text></text><canvas canvas-id="v11ShareCanvas" class="invite-canvas"/>
</view>
