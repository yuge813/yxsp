page{background:#F5F3ED}.service-page{padding-top:52rpx}.service-top{padding:24rpx 14rpx 30rpx}.service-mark{height:150rpx;width:150rpx;display:flex;align-items:center;justify-content:center;background:#E3E9D8;border-radius:44rpx;margin:70rpx 0 44rpx}.service-title{font-size:52rpx;color:#20352E;font-weight:600;line-height:1.45;letter-spacing:-1rpx;max-width:600rpx}.service-description{font-size:29rpx;line-height:1.95;color:#526D4D;display:block;margin-top:30rpx}.service-actions{display:flex;flex-direction:column;gap:24rpx;margin-top:38rpx}.service-actions navigator{display:flex;align-items:center;justify-content:center;text-align:center;font-size:30rpx;line-height:1.6;padding:24rpx;min-height:96rpx}.service-help{display:flex;align-items:center;gap:12rpx;flex-wrap:wrap;font-size:24rpx;line-height:1.8;color:#5E7357;border-top:1rpx solid #DDE4D2;margin-top:58rpx;padding-top:28rpx}.service-help>text{flex:1;min-width:360rpx}.service-help button{background:transparent;padding:0;min-height:88rpx;line-height:88rpx;font-size:26rpx;color:#A8442B;margin:0 0 0 auto}