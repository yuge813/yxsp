<view class="home-page">
  <view class="home-hero">
    <view class="home-hero-top"><text class="home-eyebrow">每日积累 · 悦享生活</text><navigator class="home-reminder" url="/sage_dksy/pages/v14/reminders/index" aria-label="签到提醒"><yx-icon name="bell" tone="light" size="36"/></navigator></view>
    <view class="home-title">{{today_qian===1?'今天的坚持，':'每一天，'}}<text>{{today_qian===1?'已经记下。':'都有好事发生。'}}</text></view>
    <view class="home-hero-seal" aria-hidden="true">日积<text>月累</text></view>
    <navigator class="home-wallet" url="/sage_dksy/pages/user/integral"><view><text class="home-wallet-label">当前可用金币</text><view class="home-wallet-value">{{loaded && num!==null?num:'—'}}<text>金币</text></view></view><view class="home-wallet-link">查看明细<yx-icon name="arrow" tone="light" size="24"/></view></navigator>
  </view>
  <view class="home-main">
    <yx-state wx:if="{{!loaded && pageError}}" type="error" title="暂时还没连接上" description="{{pageError}}" action="重新连接" bindaction="init"/>
    <yx-state wx:elif="{{!loaded}}" type="loading" title="正在同步你的进度"/>
    <block wx:else>
      <view class="home-sign ui-card">
        <view class="home-sign-top"><view><text class="home-sign-kicker">今日签到</text><view class="home-sign-title">{{today_qian===1?'小小坚持，已经到账':(nextSignReward!==null?'今天再攒 '+nextSignReward+' 金币':'给好习惯，一点奖励')}}</view></view><text class="home-streak">连续 {{signNum}} 天</text></view>
        <view class="home-days"><view wx:for="{{signCards}}" wx:key="day" class="home-day {{item.done?'is-done':item.active?'is-today':''}}"><text>第{{item.day}}天</text><view><yx-icon wx:if="{{item.done}}" name="yes" tone="green" size="30"/><text wx:else>{{item.amount===null?'—':'+'+item.amount}}</text></view></view></view>
        <button class="ui-primary home-sign-button" loading="{{signing}}" disabled="{{signing || !signReady || today_qian===1}}" bindtap="bindSignIn">{{today_qian===1?'今日已签到':(!signReady?'正在同步签到状态':'立即签到')}}</button>
        <view wx:if="{{signError}}" class="home-inline-error" bindtap="retrySections">{{signError}} · 重新加载</view>
        <navigator wx:else url="/sage_dksy/pages/v14/sign/index" class="home-sign-detail">7天奖励提前看 <yx-icon name="arrow" tone="muted" size="22"/></navigator>
      </view>
      <view class="home-shortcuts">
        <navigator url="/sage_dksy/pages/v12/list"><view><yx-icon name="book" tone="ink" size="44"/></view><text>阅读文章</text></navigator>
        <navigator url="/sage_dksy/pages/v132grow/index"><view><yx-icon name="friend" tone="ink" size="44"/></view><text>邀请好友</text></navigator>
        <navigator url="/sage_dksy/pages/user/order"><view><yx-icon name="order" tone="ink" size="44"/></view><text>兑换记录</text></navigator>
        <navigator url="/sage_dksy/pages/v16/all"><view><yx-icon name="grid" tone="ink" size="44"/></view><text>全部功能</text></navigator>
      </view>
      <view wx:if="{{pageError}}" class="ui-error" bindtap="init">{{pageError}} · 重新连接</view>
      <view class="ui-section-head"><view><text class="home-section-number">01 /</text><text>今天的小任务</text></view><navigator url="/sage_dksy/pages/v14/tasks/index">全部任务 <yx-icon name="arrow" tone="muted" size="24"/></navigator></view>
      <view class="home-task ui-card">
        <view class="home-task-main"><view class="home-task-icon"><yx-icon name="play" tone="brand" size="48"/></view><view class="home-task-copy"><text class="home-task-title">自愿看视频</text><text class="home-task-desc">完整观看后领取{{todayTask.remaining!==null?' · 剩余 '+todayTask.remaining+' 次':''}}</text><text wx:if="{{todayTask.coins!==null}}" class="home-task-reward">每次 +{{todayTask.coins}} 金币</text></view></view>
        <button class="home-task-action" loading="{{todayTaskBusy}}" disabled="{{!todayTask.enabled || todayTaskBusy}}" bindtap="openTodayTask">{{todayTask.button}}</button>
        <text class="home-task-status">{{todayTask.hint || todayTask.label}}</text>
        <button wx:if="{{todayTask.state==='unavailable'}}" class="home-task-retry" bindtap="refreshTodayTask">重新获取状态</button>
      </view>
      <view class="ui-section-head"><view><text class="home-section-number">02 /</text><text>读点好内容</text></view><navigator url="/sage_dksy/pages/v12/list">更多阅读 <yx-icon name="arrow" tone="muted" size="24"/></navigator></view>
      <yx-state wx:if="{{articleLoading && !recommendArticle.title}}" type="loading"/>
      <view wx:elif="{{articleError && !recommendArticle.title}}" class="home-content-note" bindtap="retrySections">{{articleError}} · 点击重试</view>
      <navigator wx:elif="{{recommendArticle.title}}" class="home-story" url="/sage_dksy/pages/v12/detail?id={{recommendArticle.id}}"><image wx:if="{{recommendArticle.cover_url}}" class="home-story-image" src="{{recommendArticle.cover_url}}" mode="aspectFill" binderror="onArticleImageError"/><view wx:else class="home-story-fallback"><yx-icon name="book" tone="green" size="80"/></view><view class="home-story-copy"><text class="home-story-kicker">免费阅读 · 内容精选</text><text class="home-story-title">{{recommendArticle.title}}</text><view><text>{{recommendArticle.source || '元享阅读'}}</text><yx-icon name="arrow" tone="ink" size="32"/></view></view></navigator>
      <navigator wx:else class="home-content-note" url="/sage_dksy/pages/v12/list">内容正在整理中，去阅读页看看 <yx-icon name="arrow" tone="muted" size="24"/></navigator>
      <view class="home-ad"><yx22-ad placement="home_native"/></view>
      <view class="ui-section-head"><view><text class="home-section-number">03 /</text><text>攒一份喜欢的好礼</text></view><navigator url="/sage_dksy/pages/prize/index">全部好礼 <yx-icon name="arrow" tone="muted" size="24"/></navigator></view>
      <yx-state wx:if="{{contentLoading && !homeGoods.length}}" type="loading"/>
      <yx-state wx:elif="{{goodsError && !homeGoods.length}}" type="error" title="好礼暂未加载出来" description="请检查网络后重试" action="重新加载" bindaction="retrySections"/>
      <yx-state wx:elif="{{!homeGoods.length}}" type="empty" title="好礼正在准备中" description="上架后会在这里与你见面"/>
      <view wx:else class="home-products"><view class="home-product" wx:for="{{homeGoods}}" wx:key="prize_id" data-id="{{item.prize_id}}" bindtap="prize_show"><view class="home-product-picture"><image wx:if="{{item.prize_picurl && !item._imageFailed}}" src="{{item.prize_picurl}}" mode="aspectFit" data-id="{{item.prize_id}}" binderror="onPrizeImageError"/><view wx:else><yx-icon name="gift" tone="muted" size="80"/></view></view><view class="home-product-copy"><text>{{item.prize_title}}</text><view><text>{{item.prize_integral}}</text><text>金币</text></view></view></view></view>
      <text class="home-endnote">每天一点积累，慢慢遇见喜欢。</text>
    </block>
  </view>
  <include src="/sage_dksy/pages/nav/nav.wxml"/>
</view>
<yx22-popup scene="home" ready="{{loaded}}"/>
