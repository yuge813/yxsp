@import "../../utils/referral-rewards.wxss";
.friend-page{padding-bottom:calc(175rpx + env(safe-area-inset-bottom));background:#FFF6F5}.friend-stage{height:325rpx;position:relative;overflow:hidden;background:linear-gradient(125deg,#D70C38,#F82743 70%,#FF6F4C);border-radius:40rpx;padding:36rpx;color:#fff}.friend-stage>text{font-size:24rpx;color:#FFE3E9;position:relative;z-index:2}.friend-stage>view:first-of-type{font-size:54rpx;font-weight:800;line-height:1.5;margin-top:16rpx;position:relative;z-index:2}.friend-stage>image{position:absolute;right:-20rpx;bottom:-20rpx;height:310rpx;width:330rpx;opacity:.9}.friend-total{position:relative;z-index:2;display:flex;align-items:baseline;gap:14rpx;margin-top:24rpx}.friend-total>text:first-child{font-size:66rpx;font-weight:800;line-height:1.2}.friend-total>text:last-child{font-size:24rpx;color:#FFE4EA}.friend-count-row{display:flex;background:white;border:1rpx solid #F1DFE7;border-radius:28rpx;padding:25rpx;margin:25rpx 0 36rpx}.friend-count-row>view{flex:1;display:flex;flex-direction:column;align-items:center;gap:10rpx}.friend-count-row>view+view{border-left:1rpx solid #F2DEE6}.friend-count-row>view>text:first-child{font-size:42rpx;font-weight:700;color:#C3123D}.friend-count-row>view>text:last-child{font-size:24rpx;color:#806574}.friend-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx;font-size:32rpx;font-weight:650}.friend-heading>text:last-child{font-size:24rpx;color:#806574;font-weight:400}.friend-list{padding:0 26rpx;background:#fff;border:1rpx solid #F2DFE6;border-radius:30rpx}.friend-person{display:flex;align-items:center;gap:20rpx;min-height:148rpx;padding:26rpx 0;border-bottom:1rpx solid #F2E4EC}.friend-person:last-child{border:0}.friend-avatar{width:78rpx;height:78rpx;background:linear-gradient(145deg,#FFEFCF,#FFC4CF);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}.friend-person>view:nth-child(2){flex:1;min-width:0}.friend-person>view:nth-child(2)>text:first-child{font-size:28rpx;font-weight:550;display:block}.friend-person>view:nth-child(2)>text:last-child{font-size:24rpx;line-height:1.7;color:#806574;display:block;margin-top:8rpx;word-break:break-all}.friend-person>text{font-size:24rpx;color:#BB2C51;background:#FFF0F3;padding:8rpx 14rpx;border-radius:12rpx;white-space:nowrap}.friend-note{display:flex;justify-content:center;align-items:flex-start;gap:14rpx;font-size:24rpx;line-height:1.8;color:#806574;margin:34rpx 0}.friend-note>text>text{display:block}.friend-note yx-icon{margin-top:5rpx}.friend-footer{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1rpx solid #F0DEE7;padding:24rpx 34rpx calc(28rpx + env(safe-area-inset-bottom));z-index:20}
.friend-level-intro{background:#FFF0F3;border:1rpx solid #F2D8E2;padding:26rpx;border-radius:28rpx;margin-bottom:34rpx}.friend-level-intro>view{display:flex;align-items:center;gap:14rpx;font-size:28rpx;font-weight:650;line-height:1.6;color:#9A2649}.friend-level-intro>text{display:block;font-size:24rpx;line-height:1.85;color:#806574;margin-top:16rpx}.friend-level-intro>button{margin:8rpx 0 -12rpx;padding:16rpx 0;min-height:88rpx;text-align:left;font-size:24rpx;color:#B41D45}.friend-person>view:nth-child(2)>text{font-size:24rpx;line-height:1.7;color:#806574;display:block;word-break:break-all}.friend-person>view:nth-child(2)>text:first-child{font-size:28rpx;line-height:1.6;color:#27212C;font-weight:550;margin-bottom:8rpx}.friend-person>view:nth-child(2)>text:last-child{margin-top:0}.friend-list-end{font-size:24rpx;line-height:1.7;text-align:center;padding:24rpx 0;color:#806574}.friend-rewards{background:#fff;border:1rpx solid #F2DFE6;border-radius:30rpx;padding:28rpx;margin-top:32rpx}.friend-rewards .friend-heading{font-size:29rpx;margin-bottom:20rpx}.friend-rewards .friend-heading>text:last-child{font-size:23rpx}.friend-reward-cap{display:flex;flex-direction:column;gap:10rpx;background:#FFF2D8;border-radius:20rpx;padding:24rpx;margin-bottom:12rpx;color:#96603A;font-size:24rpx;line-height:1.7}.friend-reward-cap>text:last-child{font-size:42rpx;color:#BE1743;font-weight:750}.friend-reward-cap>text:last-child>text{font-size:24rpx;font-weight:400}.friend-reward-stage{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:22rpx 0;border-bottom:1rpx solid #F3E4EB;font-size:26rpx;line-height:1.7}.friend-reward-stage>text:first-child{flex:1;min-width:0}.friend-reward-stage>text:last-child{color:#C21842;font-weight:650;flex-shrink:0}.friend-reward-copy{display:block;font-size:24rpx;line-height:1.85;color:#806574;margin-top:18rpx}.friend-reward-links{display:flex;justify-content:space-between;align-items:center;gap:12rpx;margin-top:10rpx}.friend-reward-links>button{margin:0;padding:16rpx 0;min-height:88rpx;background:transparent;color:#B51C45;font-size:24rpx;line-height:1.6;display:flex;align-items:center}

