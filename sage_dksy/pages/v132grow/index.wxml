<view class="ui-page friend-page"><view class="friend-hero"><view><text class="ui-kicker">有朋友，日常更有趣</text><text class="friend-title">一起，把日子<text>过得有期待。</text></text><text class="friend-hero-desc">分享喜欢，也分享一点生活的好意。</text></view><view class="friend-hero-mark"><yx-icon name="friend" tone="green" size="78"/></view></view>
  <button bindtap="goPoster" class="friend-poster"><yx-icon name="share" tone="light" size="38"/><text>我的专属邀请海报</text><yx-icon name="arrow" tone="light" size="28"/></button>
  <view class="friend-stats"><view><text>{{direct===null?'—':direct}}</text><text>已归属好友</text></view><view><text>{{today===null?'—':today}}</text><text>今日新增</text></view></view>
  <view class="friend-tabs"><view data-tab="friends" bindtap="setTab" class="{{tab==='friends'?'on':''}}">我的好友</view><view data-tab="growth" bindtap="setTab" class="{{tab==='growth'?'on':''}}">我的成长</view><view data-tab="rewards" bindtap="setTab" class="{{tab==='rewards'?'on':''}}">推荐奖励</view></view>
  <block wx:if="{{tab==='friends'}}"><yx-state wx:if="{{loading&&!loaded}}" type="loading"/><yx-state wx:elif="{{message&&!loaded}}" type="error" title="好友暂未加载" description="{{message}}" action="重新加载" bindaction="retry"/><view wx:else class="ui-card friend-panel"><view class="friend-panel-head"><text>好友列表</text><text wx:if="{{direct!==null}}">共 {{direct}} 人</text></view><yx-state wx:if="{{!items.length}}" type="empty" title="好朋友，还在来的路上" description="自愿分享你的专属海报，邀请朋友一起体验。" action="看看邀请海报" bindaction="goPoster"/><view class="friend-person" wx:for="{{items}}" wx:key="member_mask"><view class="friend-person-avatar"><yx-icon name="user" tone="green" size="38"/></view><view><text>{{item.nickname||'元享好友'}}</text><text>{{item.member_mask}} · {{item.registered}}</text></view><text>已归属</text></view></view><view wx:if="{{message&&loaded}}" bindtap="retry" class="friend-message">{{message}}　重新加载</view><button wx:if="{{hasMore}}" bindtap="loadMore" loading="{{loading}}" disabled="{{loading}}" class="ui-text-button">加载更多好友</button></block>
  <block wx:elif="{{tab==='growth'}}"><yx-state wx:if="{{!growthLoaded&&!growthError}}" type="loading"/><yx-state wx:elif="{{growthError}}" type="error" title="成长进度暂未同步" description="{{growthError}}" action="重新同步" bindaction="retry"/><view wx:else class="ui-card friend-panel"><view class="friend-panel-head"><text>我的7天成长</text><text>{{growth.done_count||0}} / 7</text></view><view class="friend-progress"><view wx:for="{{days}}" wx:key="*this" class="{{growth.joined&&growth.done_count>=item?'active':''}}"/></view><view class="friend-milestone" wx:for="{{milestones}}" wx:key="day"><view><text>{{item.day}}</text><text>天</text></view><view><text>{{item.title}}</text><text>{{item.hint}}</text></view></view><button bindtap="goGrowth" class="ui-secondary">{{growth.joined?'查看成长进度':'了解成长计划'}}</button><text class="friend-note">成长计划与连续签到分别统计。</text></view></block>
  <block wx:else><yx-state wx:if="{{loading&&!loaded}}" type="loading"/><yx-state wx:elif="{{message&&!loaded}}" type="error" title="奖励信息暂未同步" description="{{message}}" action="重试" bindaction="retry"/><view wx:else class="ui-card friend-panel"><view class="friend-panel-head"><text>推荐奖励</text><text class="friend-status">{{rewardInfo.approved?'活动进行中':'尚未开放'}}</text></view><block wx:if="{{rewardInfo.approved}}"><view wx:if="{{rewardInfo.cap!==null&&rewardInfo.cap>0}}" class="friend-reward"><text>每位符合条件的好友最高奖励</text><text>{{rewardInfo.cap}} <text>金币</text></text></view><view class="friend-reward-stage" wx:for="{{rewardInfo.stages}}" wx:key="label"><text>{{item.label}}</text><text>+{{item.coins}} 金币</text></view><view wx:if="{{rewardInfo.earned!==null}}" class="friend-earned">活动已获奖励 <text>{{rewardInfo.earned}} 金币</text></view><text class="friend-note">参与条件与领取结果，以活动规则和真实到账为准。</text></block><yx-state wx:else type="empty" title="推荐奖励暂未开放" description="邀请与分享由你自主选择，当前没有可领取的推荐奖励。"/></view></block>
  <navigator class="friend-rules" url="/sage_dksy/pages/v14/rewards/index">查看活动规则 <yx-icon name="arrow" tone="muted" size="26"/></navigator>
</view>
