.help-page{min-height:100vh;background:#FFF6F5}.help-body{padding:34rpx}.help-stage{position:relative;border-radius:40rpx;background:radial-gradient(ellipse at 95% 75%,#FF80535A,transparent 55%),linear-gradient(120deg,#D30B3E,#FB3750);color:white;padding:46rpx 40rpx 42rpx;overflow:hidden;min-height:356rpx}.help-stage>text{display:block;font-size:24rpx;letter-spacing:3rpx;margin-bottom:23rpx;color:#FFE6EE;position:relative;z-index:2}.help-stage>view{font-size:52rpx;font-weight:750;line-height:1.35;position:relative;z-index:2}.help-stage>view>text{display:block}.help-stage>yx-icon{position:absolute;right:23rpx;bottom:44rpx;transform:rotate(-13deg);opacity:.7}.help-stage:after{content:'';height:327rpx;width:327rpx;position:absolute;right:-102rpx;top:-27rpx;border-radius:50%;border:2rpx solid #FFFFFF30;box-shadow:0 0 0 46rpx #FFFFFF08}.help-categories{display:flex;gap:17rpx;align-items:center;padding:38rpx 0 33rpx}.help-categories>view{padding:15rpx 25rpx;background:white;color:#806574;font-size:25rpx;border-radius:29rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center}.help-categories>view.active{color:#fff;background:#D51343}.faq-list{background:white;border:2rpx solid #F0DCE7;border-radius:35rpx;overflow:hidden}.faq-item{border-top:2rpx solid #F5E6ED}.faq-item:first-child{border-top:0}.faq-item.open{background:linear-gradient(150deg,#FFF0F3,#fff)}.faq-heading{min-height:114rpx;display:flex;align-items:center;gap:17rpx;padding:23rpx 30rpx}.faq-heading>text:first-child{font-size:24rpx;font-weight:600;color:#CB829B;flex-shrink:0}.faq-heading>text:nth-child(2){font-size:27rpx;font-weight:550;line-height:1.65;flex:1;min-width:0;color:#634157}.faq-item.open .faq-heading>text:nth-child(2){font-weight:700;color:#27212C}.faq-item.open .faq-heading>yx-icon{transform:rotate(90deg)}.faq-content{padding:0 30rpx 33rpx 74rpx}.faq-content>text:first-child{font-size:25rpx;line-height:1.9;color:#826377;display:block}.faq-tip{display:block;background:#FFEDF2;color:#A84C6C;font-size:24rpx;line-height:1.7;border-radius:13rpx;padding:15rpx 17rpx;margin-top:25rpx}.help-more{display:flex;align-items:center;flex-direction:column;gap:15rpx;margin-top:42rpx;padding-bottom:15rpx}.help-more>text:first-child{font-size:28rpx;font-weight:650;color:#80536B}.help-more>text:last-child{font-size:24rpx;color:#806574;line-height:1.7}.help-footer-spacer{height:calc(170rpx + env(safe-area-inset-bottom))}.help-footer{position:fixed;bottom:0;left:0;right:0;z-index:80;background:#fff;border-top:2rpx solid #F2DFE6;padding:25rpx 34rpx calc(25rpx + env(safe-area-inset-bottom))}.help-footer>.ui-primary{width:100%;display:flex;align-items:center;justify-content:center;gap:12rpx}

.faq-heading>text:nth-child(2){font-size:28rpx}
