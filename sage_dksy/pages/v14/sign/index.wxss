.sign-intro{padding:20rpx 0 36rpx}.sign-intro .ui-title{font-size:64rpx;line-height:1.25;margin:24rpx 0}.sign-intro .ui-title>text{display:block}.sign-streak{display:flex;align-items:center;gap:12rpx;font-size:27rpx;color:#5D6F5B}.sign-reward-card{padding:30rpx 30rpx 20rpx;background:#20352E;color:#FFFEFA;border-radius:28rpx}.sign-reward-card.signed{background:#E8EDE0;color:#20352E}.sign-card-top{display:flex;align-items:center;justify-content:space-between;font-size:25rpx;color:#D1DBCE;gap:16rpx}.signed .sign-card-top{color:#5D6F5B}.sign-card-top>text:last-child{font-size:23rpx;white-space:nowrap}.sign-reward-number{display:flex;align-items:baseline;justify-content:center;gap:16rpx;margin:35rpx 0 37rpx;font-size:116rpx;line-height:1;font-weight:650;letter-spacing:-3rpx;font-variant-numeric:tabular-nums}.sign-unit{font-size:27rpx;letter-spacing:0;font-weight:400;color:#D1DBCE}.signed .sign-unit{color:#5D6F5B}.sign-reward-number>.sign-reward-pending{font-size:44rpx;letter-spacing:0;line-height:1.5;margin:22rpx 0}.sign-condition{font-size:24rpx;line-height:1.5;text-align:center;padding:22rpx 0 7rpx;color:#D1DBCE}.sign-cycle{font-size:23rpx;color:#63705F;font-weight:400}.sign-calendar{padding:30rpx 20rpx 24rpx}.sign-days{display:flex;justify-content:space-between;gap:5rpx}.sign-day{display:flex;flex-direction:column;align-items:center;flex:1;min-width:0;gap:15rpx}.sign-day-label{font-size:22rpx;color:#63705F;white-space:nowrap}.sign-day-symbol{width:66rpx;height:70rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;background:#F0F1E8;font-size:24rpx;font-weight:600;color:#63705F}.sign-day.today .sign-day-symbol{background:#20352E;color:#FFFEFA}.sign-day.today .sign-day-label{color:#20352E;font-weight:600}.sign-day.done .sign-day-symbol{background:#E8EDE0}.sign-day-state{font-size:21rpx;color:#63705F;white-space:nowrap}.sign-calendar-note{padding-top:22rpx;border-top:1rpx solid #E3E7DA;margin-top:28rpx;font-size:24rpx;line-height:1.7;color:#63705F}.sign-config-note{font-size:24rpx;line-height:1.7;color:#A33D25;margin-top:15rpx;min-height:88rpx;display:flex;align-items:center}.sign-links{padding:0 26rpx;margin-top:28rpx}.sign-links>view{display:flex;gap:20rpx;align-items:center;padding:26rpx 0;min-height:110rpx;border-bottom:1rpx solid #E3E7DA}.sign-links>view:last-child{border-bottom:0}.sign-links>view>view{flex:1;min-width:0;display:flex;flex-direction:column;gap:9rpx}.sign-links>view>view>text:first-child{font-size:29rpx;color:#20352E}.sign-links>view>view>text:last-child{font-size:24rpx;line-height:1.6;color:#63705F}.sign-ledger{display:flex;align-items:center;justify-content:center;gap:3rpx;min-height:100rpx;font-size:24rpx;color:#63705F;margin-top:16rpx}.sign-receipt{padding-top:24rpx;border-top:1rpx solid #CBD5C2;margin:0 0 27rpx}.sign-receipt>view{display:flex;justify-content:space-between;align-items:center;gap:14rpx;font-size:27rpx;color:#20352E}.sign-receipt>view>text:last-child{font-size:36rpx;font-weight:650}.sign-receipt>text{display:block;font-size:24rpx;line-height:1.7;color:#63705F;margin-top:15rpx}.sign-home{margin-top:28rpx}@media(max-width:340px){.sign-intro .ui-title{font-size:57rpx}.sign-calendar{padding:28rpx 15rpx}.sign-day-symbol{width:62rpx}.sign-cycle{font-size:21rpx}}
