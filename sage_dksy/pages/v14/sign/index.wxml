<view class="sign-page">
 <view wx:if="{{recordsVisible}}" class="sign-body sign-records"><view class="records-title">每一天，都记得。</view><text class="records-sub">签到记录与实际到账情况</text><view class="record-summary"><view><text>连续签到</text><text>{{statusReady?streak:'—'}}<text>天</text></text></view><view><text>今天签到</text><text>{{statusReady?(todaySigned?'已完成':'未签到'):'待同步'}}</text></view></view><view class="record-month"><text>{{recordMonth || '当前月份'}}</text><text>本月已加载记录</text></view><view class="record-calendar"><view class="week-row"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view><view class="calendar-dots"><text wx:for="{{calendarDays}}" wx:key="key" class="{{item.recorded?'recorded':''}}">{{item.label}}</text></view></view><view class="records-section">已加载签到记录</view><yx-state wx:if="{{recordLoading && !recordRows.length}}" type="loading"/><yx-state wx:elif="{{recordError && !recordRows.length}}" type="error" title="签到记录暂未加载出来" action="重新加载" bindaction="retryRecords"/><yx-state wx:elif="{{!recordRows.length}}" type="empty" title="当前已加载记录中暂无签到收入" description="继续加载更多记录，或查看完整金币明细"/><view wx:else class="record-list ui-card"><view wx:for="{{recordRows}}" wx:key="key"><view class="record-icon"><yx-icon name="check" tone="brand" size="40"/></view><view><text>{{item.title}}</text><text>{{item.time}}</text></view><text>{{item.amount===null?'待核对':'+'+item.amount}}</text></view></view><view wx:if="{{recordError}}" class="ui-error" bindtap="retryRecords">{{recordError}} · 重试</view><button wx:if="{{recordHasMore}}" class="ui-text-button" bindtap="moreRecords" loading="{{recordLoading}}" disabled="{{recordLoading}}">继续加载记录</button><button class="ui-text-button" bindtap="closeRecords">返回每日签到</button></view>
 <view wx:elif="{{justSigned}}" class="sign-body sign-success"><view class="sign-success-art"><image src="/sage_dksy/resource/red/coin.png" mode="aspectFit"/><text>签到成功</text></view><view class="sign-result-title">今天的坚持，<text>已经到账。</text></view><view class="prize-ticket"><text>本次获得</text><view class="ticket-amount">+{{lastReward}}<text>金币</text></view><view class="ticket-divider"></view><view class="ticket-info"><text>当前金币</text><text>{{balance===null?'正在同步':balance}}</text></view><view class="ticket-info"><text>连续签到</text><text>{{statusReady?streak+' 天':'正在同步'}}</text></view></view><view wx:if="{{nextDayNumber!==null}}" class="next-day-strip"><yx-icon name="check" tone="brand" size="46"/><view><text>明天继续，奖励提前看</text><text>第 {{nextDayNumber}} 天签到奖励：{{nextDayReward===null?'待同步':nextDayReward+' 金币'}}</text></view></view><button class="ui-text-button" bindtap="goHome">返回首页</button></view>
 <view wx:else class="sign-body">
  <view class="sign-topline"><view><text>已连续签到</text><view>{{statusReady?streak:'—'}}<text>天</text></view></view><view class="sign-reminder" bindtap="goReminders"><yx-icon name="bell" tone="brand" size="34"/><text>签到提醒</text></view></view>
  <yx-state wx:if="{{loading && !statusReady}}" type="loading" title="正在同步签到进度"/><yx-state wx:elif="{{error && !statusReady}}" type="error" title="签到状态暂未同步" description="请检查网络后重试" action="重新加载" bindaction="retry"/>
  <block wx:else><view class="sign-today-stage"><text>{{todaySigned?'今日签到已完成':'今天签到可领取'}}</text><view><text class="{{todayReward===null?'pending':''}}">{{todayReward===null?'待同步':todayReward}}</text><text wx:if="{{todayReward!==null}}">金币</text></view><image src="/sage_dksy/resource/red/coin.png" mode="aspectFit"/></view><view class="sign-calendar ui-card"><view class="sign-calendar-heading"><text>我的7天签到</text><view bindtap="openRecords">签到记录 <yx-icon name="arrow" tone="muted" size="24"/></view></view><view class="big-days"><view wx:for="{{days}}" wx:key="day" class="sign-day {{item.state}} {{item.day===7?'seventh':''}}"><text>{{item.state==='today'?'今天':'第'+item.day+'天'}}</text><view><yx-icon name="{{item.state==='done'?'yes':item.day===7?'gift':'coin'}}" tone="{{item.state==='today' && item.day!==7?'light':'brand'}}" size="44"/></view><text class="day-reward">{{item.state==='done'?'已签到':(item.amount===null?'待同步':'+'+item.amount)}}</text><text wx:if="{{item.day===7}}" class="seventh-note">第7天 · 签到奖励</text></view></view><view class="sign-calendar-notice"><yx-icon name="info" tone="brand" size="32"/><text>每天一次签到，记录每一天的小收获。</text></view><view wx:if="{{!configReady && !loading}}" class="sign-config-note" bindtap="retry">部分奖励尚未同步 · 点击刷新</view></view><view wx:if="{{error}}" class="ui-error" bindtap="retry">{{error}} · 重新加载</view></block>
 </view>
 <view class="sign-footer-spacer"></view><view class="sign-footer"><button wx:if="{{recordsVisible || justSigned}}" class="ui-primary" bindtap="goLedger">查看金币明细</button><button wx:else class="ui-primary" bindtap="sign" loading="{{busy}}" disabled="{{busy || loading || todaySigned || !statusReady}}">{{todaySigned?'今日已签到':(loading?'正在同步签到状态':(todayReward===null?'立即签到':'立即签到，领取 '+todayReward+' 金币'))}}</button></view>
</view>
