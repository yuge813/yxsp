.task-page>.ui-title>text{display:block}.task-page>.ui-title{font-size:64rpx;line-height:1.25;margin:22rpx 0}.task-page>.ui-lead{max-width:550rpx;line-height:1.8}.task-notice{display:flex;gap:14rpx;align-items:flex-start;font-size:24rpx;line-height:1.7;color:#52654E;background:#E9EDDF;border-radius:16rpx;padding:22rpx;margin-top:30rpx}.task-refresh{display:flex;gap:8rpx;align-items:center;justify-content:flex-end;min-width:100rpx;min-height:88rpx;font-size:24rpx;color:#63705F;font-weight:400}.task-item{padding:30rpx 26rpx;margin-bottom:22rpx}.task-sign{background:#E8EDE0;border-color:#E0E7D7}.task-item-top{display:flex;align-items:center;gap:18rpx}.task-symbol{height:82rpx;width:76rpx;background:#EBEFE4;display:flex;align-items:center;justify-content:center;border-radius:20rpx;flex-shrink:0}.task-symbol.brand{background:#FAE8DF}.task-sign .task-symbol{background:#F5F6EF}.task-description{flex:1;min-width:0;display:flex;flex-direction:column;gap:9rpx}.task-name{font-size:31rpx;line-height:1.4;font-weight:600;color:#20352E}.task-sub{font-size:24rpx;color:#63705F;line-height:1.6}.task-status-tag{font-size:22rpx;max-width:190rpx;color:#63705F;text-align:right;line-height:1.6}.task-status-tag.ready{color:#A33D25}.task-item-bottom{display:flex;align-items:center;justify-content:space-between;gap:22rpx;margin-top:26rpx}.task-reward{font-size:29rpx;font-weight:600;color:#20352E}.task-button{min-width:158rpx;min-height:88rpx;line-height:1.4;display:flex;align-items:center;justify-content:center;padding:0 22rpx;font-size:26rpx;font-weight:600;border-radius:16rpx;background:#BF442A;color:#FFFEFA;margin:0;flex-shrink:0}.task-button.secondary{background:#EAEDE2;color:#20352E}.task-button[disabled]{background:#ECEDE5;color:#747B6A}.task-sign .task-button{background:#20352E;color:#FFFEFA}.task-meta{display:flex;align-items:center;justify-content:space-between;padding-top:24rpx;margin-top:24rpx;border-top:1rpx solid #E7E8DE;color:#63705F;font-size:24rpx;gap:16rpx}.task-meta>text:first-child{color:#AD4128;font-size:27rpx;font-weight:600}.task-meta>text:only-child{color:#63705F;font-size:24rpx;font-weight:400}.task-condition{font-size:24rpx;color:#63705F;line-height:1.7;flex:1}.task-error{display:flex;gap:14rpx;align-items:center;padding:24rpx 20rpx;font-size:25rpx;line-height:1.7;color:#A33D25;background:#FAE8DF;border-radius:16rpx;margin:24rpx 0;min-height:88rpx}.task-explain{display:flex;gap:20rpx;padding:22rpx 8rpx;margin-top:12rpx}.task-explain>view{flex:1;display:flex;flex-direction:column;gap:11rpx}.task-explain>view>text:first-child{font-size:27rpx;color:#20352E;font-weight:600}.task-explain>view>text:last-child{font-size:24rpx;color:#63705F;line-height:1.8}.task-links{margin-top:24rpx;border-top:1rpx solid #DADFD1}.task-links>view{display:flex;justify-content:space-between;align-items:center;font-size:27rpx;color:#20352E;min-height:100rpx;border-bottom:1rpx solid #DADFD1}@media(max-width:340px){.task-item{padding:26rpx 22rpx}.task-item-top{gap:13rpx}.task-status-tag{max-width:145rpx}.task-button{min-width:138rpx;padding:0 16rpx}}
