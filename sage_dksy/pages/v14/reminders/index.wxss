.reminder-art{position:relative;width:132rpx;height:132rpx;border-radius:36rpx;background:#E4EBDD;display:flex;align-items:center;justify-content:center;margin:28rpx 0 36rpx;transform:rotate(-7deg)}.reminder-art>view{position:absolute;width:25rpx;height:25rpx;border-radius:50%;background:#BF442A;top:-3rpx;right:-3rpx;border:6rpx solid #F5F3ED}.reminder-page>.ui-title{font-size:64rpx;line-height:1.25;margin:24rpx 0}.reminder-page>.ui-title>text{display:block}.reminder-page>.ui-lead{line-height:1.8;display:block;margin-bottom:36rpx}.reminder-card{padding:30rpx 28rpx;margin-top:32rpx}.reminder-card-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:31rpx;color:#20352E;font-weight:600;padding-bottom:25rpx;border-bottom:1rpx solid #E2E6DA}.reminder-card-head>text:last-child{font-size:22rpx;font-weight:400;white-space:nowrap;color:#5D6F5B;background:#E8EDE0;padding:10rpx 14rpx;border-radius:10rpx}.reminder-line{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;font-size:26rpx;line-height:1.8;margin-top:24rpx;color:#20352E}.reminder-line>text:first-child{color:#63705F;white-space:nowrap}.reminder-line>text:last-child{text-align:right}.reminder-card>.ui-primary{margin-top:34rpx}.reminder-note{display:flex;gap:13rpx;align-items:flex-start;font-size:24rpx;line-height:1.8;color:#63705F;margin-top:25rpx}.reminder-note>text{flex:1}.reminder-error{display:flex;flex-direction:column;gap:14rpx;background:#FAE8DF;color:#A33D25;font-size:25rpx;line-height:1.7;padding:25rpx;border-radius:16rpx;margin-top:25rpx}.reminder-error>text:last-child{display:flex;align-items:center;gap:8rpx;min-height:70rpx}.reminder-confirm{display:flex;gap:12rpx;font-size:24rpx;line-height:1.7;color:#5D6F5B;padding:27rpx 8rpx}.reminder-back{margin-top:28rpx}.reminder-endnote{display:block;text-align:center;font-size:24rpx;line-height:1.7;color:#63705F;margin-top:32rpx}@media(max-width:340px){.reminder-page>.ui-title{font-size:56rpx}}
