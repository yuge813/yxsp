.reminder-page{min-height:100vh;background:#FFF6F5}.reminder-body{padding:34rpx}.reminder-hero{text-align:center;padding:54rpx 0 60rpx}.reminder-hero>view:first-child{display:flex;align-items:center;justify-content:center;background:linear-gradient(150deg,#FFF0C2,#FFD978);border-radius:48rpx;height:180rpx;width:180rpx;margin:0 auto 44rpx;box-shadow:0 25rpx 54rpx #E6A86128}.reminder-hero>view:nth-child(2){font-size:56rpx;font-weight:750;line-height:1.4;color:#AE1849}.reminder-hero>view:nth-child(2)>text{display:block}.reminder-hero>text{display:block;font-size:25rpx;line-height:1.8;color:#806574;margin-top:23rpx}.reminder-card{padding:33rpx}.reminder-title{display:flex;align-items:center;gap:19rpx}.reminder-title>text:nth-child(2){font-size:28rpx;font-weight:750;flex:1;color:#51334B}.reminder-title>text:last-child{font-size:24rpx;white-space:nowrap;background:#F0EBF1;color:#806574;border-radius:13rpx;padding:8rpx 13rpx}.reminder-copy{display:block;font-size:25rpx;line-height:1.9;color:#806574;margin-top:29rpx}.reminder-accepted{display:flex;gap:12rpx;align-items:flex-start;font-size:24rpx;line-height:1.7;color:#B81B48;background:#FFF0F3;border-radius:15rpx;padding:20rpx;margin-top:23rpx}.reminder-accepted>text{flex:1}.reminder-steps{padding:25rpx 13rpx}.reminder-steps>view{display:flex;align-items:flex-start;gap:23rpx;margin:40rpx 0}.reminder-steps>view>text{height:54rpx;width:54rpx;background:#FFE4EC;border:2rpx solid #FAC9D7;border-radius:17rpx;display:flex;align-items:center;justify-content:center;font-size:28rpx;font-weight:700;color:#C11A49;flex-shrink:0}.reminder-steps>view>view{flex:1;min-width:0;display:flex;flex-direction:column;gap:11rpx}.reminder-steps>view>view>text:first-child{font-size:28rpx;font-weight:700;color:#27212C}.reminder-steps>view>view>text:last-child{font-size:24rpx;line-height:1.8;color:#806574}.reminder-footer-spacer{height:calc(170rpx + env(safe-area-inset-bottom))}.reminder-footer{position:fixed;bottom:0;left:0;right:0;z-index:80;background:#fff;border-top:2rpx solid #F2DFE6;padding:25rpx 34rpx calc(25rpx + env(safe-area-inset-bottom))}.reminder-footer>.ui-primary{width:100%}
