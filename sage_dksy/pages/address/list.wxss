page{background:#F5F3ED}.address-page{padding-bottom:calc(290rpx + env(safe-area-inset-bottom))}.address-intro{padding:12rpx 0 36rpx}.address-intro .ui-title{font-size:58rpx;margin:14rpx 0}.address-intro .ui-lead{font-size:28rpx;line-height:1.7;color:#63725D;display:block}.address-item{background:#FFFEFA;border:1rpx solid #DFE4D4;border-radius:26rpx;padding:0 26rpx;margin-bottom:24rpx}.address-select{padding:30rpx 0;display:flex;gap:20rpx;align-items:flex-start;min-height:128rpx}.address-check{height:36rpx;width:36rpx;border:2rpx solid #A4B298;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-top:4rpx;flex-shrink:0}.address-check.selected{background:#20352E;border-color:#20352E}.address-copy{flex:1;min-width:0}.address-copy>view{display:flex;align-items:center;flex-wrap:wrap;gap:14rpx;font-size:30rpx;color:#20352E;font-weight:600}.address-copy>view>text:nth-child(2){font-size:26rpx;font-weight:400;color:#65765B}.address-copy>text{display:block;margin-top:16rpx;line-height:1.8;font-size:27rpx;color:#596D50;word-break:break-all}.address-copy .address-default{font-size:22rpx;color:#A83F26;background:#FAE9DC;border-radius:8rpx;padding:4rpx 9rpx;font-weight:400}.address-actions{display:flex;justify-content:flex-end;gap:28rpx;border-top:1rpx solid #E4E9D9}.address-actions>button{margin:0;min-height:88rpx;padding:0 12rpx;background:transparent;color:#506747;font-size:25rpx;line-height:88rpx}.address-actions>button:after{border:0}.address-footnote{display:flex;align-items:flex-start;gap:14rpx;color:#65775A;font-size:24rpx;line-height:1.8;margin:34rpx 4rpx}.address-footnote yx-icon{margin-top:7rpx;flex-shrink:0}.address-footer{position:fixed;bottom:0;left:0;right:0;background:#F5F3ED;border-top:1rpx solid #DDE3D2;padding:22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));z-index:40}.address-footer>button+button{margin-top:16rpx}
