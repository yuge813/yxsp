<view class="ui-page address-page"><view class="address-intro"><text class="ui-kicker">让喜欢，送达身边</text><view class="ui-title">收货地址</view><text class="ui-lead">选择常用地址，兑换实物好礼更方便。</text></view><yx-state wx:if="{{!accountReady}}" type="error" title="请先连接账号" description="地址按账号保存在当前设备，请返回我的完成账号连接。" action="返回我的" bindaction="goAccount"/><block wx:elif="{{hasAddresses}}"><view class="address-item" wx:for="{{items}}" wx:key="id"><view class="address-select" bindtap="onSelect" data-id="{{item.id}}"><view class="address-check {{selectedId===item.id?'selected':''}}"><yx-icon wx:if="{{selectedId===item.id}}" name="yes" tone="light" size="24"/></view><view class="address-copy"><view><text>{{item.name}}</text><text>{{item.viewPhone}}</text><text class="address-default" wx:if="{{item.isDefault}}">默认</text></view><text>{{item.viewAddress}}</text></view></view><view class="address-actions"><button data-id="{{item.id}}" bindtap="onEdit">编辑地址</button><button data-id="{{item.id}}" bindtap="onDelete">删除</button></view></view></block><yx-state wx:elif="{{accountReady}}" type="empty" title="还没有收货地址" description="添加一个地址，准备接收下一份好礼。"/><view class="address-footnote"><yx-icon name="info" size="30" tone="green"/><text>地址保存在当前设备的小程序中；仅在你提交订单时用于配送。</text></view><view class="address-footer"><button class="ui-primary" bindtap="onWechatAddress" disabled="{{!accountReady}}">使用微信收货地址</button><button class="ui-secondary" bindtap="onAdd" disabled="{{!accountReady}}">手动新增地址</button></view></view>