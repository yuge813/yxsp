<view class="cm-scope">
 <view wx:if="{{!accountReady}}" class="cm-page"><yx-state type="error" title="请先连接账号" description="地址按账号保存在当前设备，请返回我的完成账号连接。" action="返回我的" bindaction="goAccount"/></view>
 <view wx:elif="{{!hasAddresses}}" class="cm-page cm-address-empty"><view class="cm-empty-address-art"><view class="cm-empty-orbit"></view><view class="cm-envelope"><view class="cm-envelope-paper"></view><view class="cm-envelope-pin"><yx-icon name="location" tone="brand" size="110"/></view></view><text class="cm-empty-spark one">✦</text><text class="cm-empty-spark two">✧</text></view><view class="cm-empty-address-title"><text>为喜欢，留一个收货位置</text><view class="cm-h1">还没有收货地址</view><view class="cm-p">添加地址后，兑换喜欢的好礼，<text>就知道该送往哪里了。</text></view></view><view class="cm-empty-address-actions"><button class="ui-primary" bindtap="onWechatAddress"><yx-icon name="location" tone="light" size="40"/>使用微信收货地址</button><button class="ui-secondary" bindtap="onAdd">手动新增地址</button></view><view class="cm-empty-address-privacy"><yx-icon name="shield" tone="muted" size="36"/><view class="cm-p">地址保存在当前设备<text>填写地址不代表已获得试用商品</text></view></view><button wx:if="{{selectMode&&pendingSelectionId}}" class="ui-primary" bindtap="onUse">使用此收货地址</button></view>
 <view wx:elif="{{selectMode}}" class="cm-page cm-with-footer cm-address-choose"><view class="cm-choose-title"><view class="cm-h1">选择收货地址</view><view class="cm-p">本次好礼将寄送至你选择的地址。</view></view><view wx:for="{{items}}" wx:key="id" class="cm-address-item {{pendingSelectionId===item.id?'selected-address':''}}" data-id="{{item.id}}" bindtap="onSelect"><view class="cm-address-row"><view class="cm-radio {{pendingSelectionId===item.id?'selected':''}}"><yx-icon wx:if="{{pendingSelectionId===item.id}}" name="yes" tone="light" size="28"/></view><view><view><text class="cm-b">{{item.name}}</text><text>{{item.viewPhone}}</text><text class="tag" wx:if="{{item.isDefault}}">默认</text></view><view class="cm-p">{{item.viewAddress}}</view></view></view><text wx:if="{{pendingSelectionId===item.id}}" class="cm-selected-tag">本次使用</text></view><view class="cm-native-address" bindtap="onWechatAddress"><view class="cm-native-icon"><yx-icon name="location" tone="brand" size="52"/></view><view class="cm-native-copy"><text class="cm-b">使用微信收货地址</text><view class="cm-p">从微信已有地址中选择</view></view><yx-icon name="arrow" tone="muted" size="32"/></view><button class="cm-manual-address" bindtap="onAdd">新增收货地址</button><view class="cm-selection-note"><yx-icon name="shield" tone="muted" size="38"/><view class="cm-p">确认后可返回兑换页面，<text>再次核对商品与扣除金币。</text></view></view><view class="cm-action-footer"><button class="ui-primary" bindtap="onUse" disabled="{{!pendingSelectionId}}">使用此收货地址</button></view></view>
 <view wx:else class="cm-page cm-with-footer cm-address-page"><view class="cm-address-heading"><view><text>让好礼，准确送到你手里</text><view class="cm-h1">我的收货地址</view></view><view><yx-icon name="location" tone="brand" size="78"/></view></view><view wx:for="{{items}}" wx:key="id" class="cm-address-item"><view class="cm-address-row"><yx-icon name="location" tone="muted" size="38"/><view><view><text class="cm-b">{{item.name}}</text><text>{{item.viewPhone}}</text><text class="tag" wx:if="{{item.isDefault}}">默认</text></view><view class="cm-p">{{item.viewAddress}}</view></view></view><view class="cm-address-actions"><button bindtap="onSetDefault" data-id="{{item.id}}" disabled="{{item.isDefault}}"><yx-icon wx:if="{{item.isDefault}}" name="yes" tone="brand" size="28"/>{{item.isDefault?'默认地址':'设为默认'}}</button><view><button bindtap="onEdit" data-id="{{item.id}}">编辑</button><button bindtap="onDelete" data-id="{{item.id}}">删除</button></view></view></view><view class="cm-address-privacy"><yx-icon name="shield" tone="muted" size="38"/><view class="cm-p">地址按账户保存在当前设备，<text>仅在提交订单时用于商品配送。</text></view></view><view class="cm-action-footer"><button class="ui-primary" bindtap="onAdd"><yx-icon name="location" tone="light" size="40"/>新增收货地址</button></view></view>
</view>
