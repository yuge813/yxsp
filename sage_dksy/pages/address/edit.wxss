page{background:#F5F3ED}.address-edit{padding-bottom:calc(180rpx + env(safe-area-inset-bottom))}.address-edit-head{padding:12rpx 0 36rpx}.address-edit-head .ui-title{margin-top:16rpx;font-size:52rpx}.address-form{background:#FFFEFA;border:1rpx solid #DDE5D3;border-radius:26rpx;padding:4rpx 28rpx}.address-field{display:flex;align-items:center;gap:26rpx;min-height:122rpx;border-bottom:1rpx solid #E4E9D9;font-size:28rpx;color:#20352E}.address-field>text{width:140rpx;flex-shrink:0}.address-field>input{flex:1;min-width:0;font-size:29rpx;height:88rpx}.address-placeholder{color:#697961}.address-region>view{flex:1;line-height:1.6;padding:26rpx 0;min-width:0}.address-detail{padding:30rpx 0;border-bottom:1rpx solid #E4E9D9}.address-detail>text{font-size:28rpx;color:#20352E;display:block;margin-bottom:22rpx}.address-detail>textarea{width:100%;height:170rpx;line-height:1.7;font-size:28rpx}.address-default-row{display:flex;align-items:center;justify-content:space-between;gap:26rpx;padding:32rpx 0}.address-default-row>view{display:flex;flex-direction:column;gap:12rpx;color:#20352E;font-size:28rpx}.address-default-row>view>text:nth-child(2){font-size:24rpx;color:#64795A}.address-privacy{display:flex;gap:14rpx;align-items:flex-start;margin:30rpx 4rpx;font-size:24rpx;line-height:1.8;color:#637959}.address-privacy yx-icon{margin-top:6rpx;flex-shrink:0}.address-save{position:fixed;bottom:0;left:0;right:0;background:#F5F3ED;padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));border-top:1rpx solid #DDE3D2;z-index:40}
