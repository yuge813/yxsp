<view class="ui-page offer-page"><view class="offer-heading"><text class="ui-kicker">元享 · 活动发现</text><text class="ui-title">发现身边的好事。</text><text class="ui-lead">活动详情与参与规则，以实际页面为准。</text></view><swiper wx:if="{{swiper.length}}" class="offer-swiper" autoplay="{{true}}" indicator-dots="{{swiper.length>1}}" interval="4500"><swiper-item wx:for="{{swiper}}" wx:key="index"><image src="{{item.picurl}}" mode="aspectFill" bindtap="appurl" data-linkurl="{{item.linkurl}}" binderror="bannerError" data-index="{{index}}"/></swiper-item></swiper>
 <yx-state wx:if="{{loading&&!loaded}}" type="loading"/><yx-state wx:elif="{{error&&!loaded}}" type="error" title="活动暂时没有加载出来" description="{{error}}" action="重新加载" bindaction="retry"/><block wx:else><view wx:if="{{error}}" class="ui-error" bindtap="retry">{{error}} · 点击重试</view><navigator class="offer-row ui-card" wx:for="{{tehui}}" wx:key="id" url="tehui_show?id={{item.id}}"><text wx:if="{{item.tag_title}}" class="offer-tag">{{item.tag_title}}</text><text class="offer-title">{{item.title}}</text><view class="offer-footer"><text>活动时间 {{item.ontime}}</text><yx-icon name="arrow" tone="brand" size="32"/></view></navigator><yx-state wx:if="{{loaded&&!tehui.length}}" type="empty" title="近期暂无新的活动" description="可以稍后再来发现更多"/><view wx:if="{{loading}}" class="offer-end">正在加载…</view><button wx:elif="{{hasMore&&tehui.length}}" class="ui-text-button" bindtap="onReachBottom">继续加载</button><view wx:elif="{{tehui.length}}" class="offer-end">已展示全部返回的活动</view></block>
</view><include src="/sage_dksy/pages/nav/nav.wxml"/>
