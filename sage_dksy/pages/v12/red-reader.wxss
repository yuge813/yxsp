.read-reward-card{border:1rpx solid #F1D8DC;background:linear-gradient(135deg,#FFF6DE,#FFF0E8 65%,#FFF0F3);border-radius:30rpx;padding:28rpx;margin:0 0 34rpx}.read-reward-top,.read-reward-label,.read-rules,.read-result-top{display:flex;align-items:center}.read-reward-top{justify-content:space-between;gap:14rpx}.read-reward-label{gap:10rpx;color:#AD2445;font-size:25rpx;font-weight:650}.read-rules{gap:4rpx;min-height:64rpx;font-size:24rpx;color:#806574;flex-shrink:0}.read-reward-main{display:flex;align-items:center;gap:14rpx;margin:14rpx 0 28rpx}.read-reward-copy{flex:1;min-width:0}.read-reward-title{display:block;font-weight:700;font-size:35rpx;line-height:1.5;color:#6D203A}.read-reward-title>text{display:block}.read-reward-caption{display:block;color:#87616A;font-size:24rpx;line-height:1.65;margin-top:14rpx}.read-reward-coin{width:104rpx;height:104rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:8rpx solid #FFDB85;border-radius:50%;background:#FFE5A0;box-shadow:0 10rpx 0 #E7AD4B;transform:rotate(-10deg);margin-right:7rpx}.read-reward-status{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-top:1rpx dashed #E5BFAB}.read-status-label,.read-reward-remaining>text:first-child{display:block;font-size:24rpx;color:#886365}.read-status-value{display:flex;align-items:baseline;gap:10rpx;margin-top:8rpx;font-size:30rpx;line-height:1.45;font-weight:650;color:#B82342;overflow-wrap:anywhere}.read-status-value>text:first-child{font-size:38rpx}.read-status-value>text+text{font-size:24rpx;font-weight:400}.read-reward-remaining{text-align:right;flex-shrink:0}.read-reward-remaining>text:last-child{display:block;font-size:26rpx;margin-top:8rpx;line-height:1.5;color:#8B4D4F}.read-watch{width:100%;margin-top:4rpx;font-size:28rpx}.read-reward-footnote{display:block;margin-top:18rpx;font-size:23rpx;line-height:1.7;color:#8A6669;text-align:center}.read-result{background:#FFF;border:1rpx solid #F2D5DD;border-radius:20rpx;padding:22rpx;margin-bottom:24rpx}.read-result.paid{background:#FFF9E9;border-color:#EFC66E}.read-result-top{gap:10rpx;flex-wrap:wrap;font-size:26rpx;color:#942C47;font-weight:650;line-height:1.55}.read-result-amount{margin-left:auto;white-space:nowrap;font-size:29rpx;color:#B10C38}.read-result-note{display:block;font-size:24rpx;color:#806574;line-height:1.7;margin-top:14rpx}.read-result-actions{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-top:10rpx}.read-result-actions button,.read-result-actions navigator{display:flex;align-items:center;justify-content:center;min-height:76rpx;font-size:24rpx;color:#A92246;padding:8rpx 4rpx}.read-result-actions button{margin:0;background:transparent}.read-result.unpaid{background:#FFF8FA}.read-result.pending{background:#FFFAED}.read-result.error{background:#FFF4F5}
