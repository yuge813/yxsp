@import "./red-reader.wxss";
page{background:#FFF6F5}.reader-page{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}.reader-intro{position:relative;display:flex;align-items:center;justify-content:space-between;overflow:hidden;padding:34rpx 36rpx 68rpx;background:linear-gradient(116deg,#D70C38,#F3273D 75%,#FF5841);color:#FFF}.reader-intro-copy{position:relative;z-index:1;flex:1;min-width:0}.reader-eyebrow{display:block;font-size:24rpx;letter-spacing:2rpx;color:#FFDBDF}.reader-intro-copy>view{font-size:50rpx;line-height:1.42;font-weight:700;margin:18rpx 0}.reader-intro-copy>view>text{display:block}.reader-intro-note{display:block;font-size:24rpx;line-height:1.7;color:#FFE9E2}.reader-intro-art{position:relative;width:156rpx;height:156rpx;margin-left:10rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid rgba(255,222,162,.4);border-radius:38rpx;background:rgba(255,228,169,.13);transform:rotate(-9deg)}.reader-intro-art>view{position:absolute;width:220rpx;height:220rpx;border:1rpx solid rgba(255,223,176,.3);border-radius:50%}.reader-body{position:relative;padding:0 32rpx;min-width:0}.reader-body>.read-reward-card{margin-top:-34rpx;position:relative;z-index:1;box-shadow:0 12rpx 28rpx rgba(135,31,66,.05)}.reader-section-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:40rpx 0 24rpx;font-size:34rpx;font-weight:650}.reader-section-head>text:last-child{font-weight:400;font-size:24rpx;color:#9A6A79}.reader-search{display:flex;align-items:center;gap:18rpx;background:#FFFFFF;border:1rpx solid #F0DCE3;border-radius:20rpx;padding:0 24rpx;height:92rpx}.reader-search input{flex:1;min-width:0;font-size:26rpx;color:#27212C}.reader-search button{margin:0;padding:0;width:72rpx;height:88rpx;display:flex;align-items:center;justify-content:center;background:transparent}.reader-categories{white-space:nowrap;margin:24rpx 0 28rpx}.reader-categories-inner{display:flex;align-items:center;gap:14rpx}.reader-category{display:inline-flex;align-items:center;justify-content:center;min-height:78rpx;padding:16rpx 28rpx;color:#806574;font-size:28rpx;background:#FFFFFF;border-radius:40rpx}.reader-category.is-active{color:#FFFFFF;background:#D4113A;font-weight:650}.reader-feature{background:#FFFFFF;border:1rpx solid #F1DDE5;border-radius:28rpx;overflow:hidden;margin-bottom:24rpx}.reader-feature-image{height:302rpx;width:100%;display:block;background:#F7E4EB}.reader-feature-empty{height:234rpx;background:linear-gradient(130deg,#FFF0F3,#FFE6DC);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16rpx;color:#A45F72;font-size:24rpx;letter-spacing:5rpx}.reader-feature-copy{padding:26rpx 28rpx;color:#27212C}.reader-feature-meta{display:flex;justify-content:space-between;align-items:center;font-size:24rpx;color:#806574;gap:20rpx}.reader-feature-meta>text:first-child{padding:6rpx 12rpx;background:#FFF0F3;color:#BD2247;border-radius:7rpx;font-weight:500}.reader-feature-meta>text:last-child{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;max-width:60%}.reader-feature-title{font-size:36rpx;line-height:1.5;font-weight:650;margin:20rpx 0 14rpx;word-break:break-word}.reader-feature-summary{font-size:26rpx;line-height:1.75;color:#806574;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.reader-feature-link{display:flex;align-items:center;justify-content:flex-end;gap:8rpx;font-size:26rpx;margin-top:22rpx;color:#BD2247}.reader-stories{margin-top:8rpx}.reader-story{display:flex;gap:24rpx;padding:28rpx;border:1rpx solid #F1DCE6;background:#FFF;border-radius:26rpx;align-items:center;margin-bottom:18rpx}.reader-story-main{flex:1;min-width:0}.reader-story-source{font-size:24rpx;color:#AD6C80}.reader-story-title{font-size:30rpx;line-height:1.5;font-weight:600;color:#27212C;margin-top:10rpx;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.reader-story-summary{font-size:24rpx;color:#806574;line-height:1.65;margin-top:12rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.reader-story-image,.reader-story-placeholder{width:172rpx;height:180rpx;flex-shrink:0;border-radius:16rpx;background:#FFF0F3}.reader-story-placeholder{display:flex;align-items:center;justify-content:center}.reader-pagination{text-align:center;font-size:24rpx;color:#806574;margin:24rpx 0}.reader-pagination button{white-space:normal}.reader-footnote{display:flex;align-items:center;justify-content:center;gap:10rpx;font-size:24rpx;line-height:1.7;color:#806574;min-height:88rpx}.reader-pressed{opacity:.8}
@media(max-width:350px){.reader-intro{padding-left:28rpx;padding-right:28rpx}.reader-intro-copy>view{font-size:45rpx}.reader-intro-art{width:126rpx;height:142rpx}.reader-body{padding-left:24rpx;padding-right:24rpx}.reader-story{gap:18rpx;padding:24rpx}.reader-story-image,.reader-story-placeholder{width:146rpx;height:166rpx}}
