page{background:#FFFEFA}.article-page{padding:38rpx 38rpx 64rpx}.article-kicker{font-size:24rpx;line-height:1.6;color:#5E735C;display:block}.article-title{font-size:52rpx;line-height:1.48;font-weight:700;letter-spacing:-1rpx;color:#20352E;margin:22rpx 0 24rpx;word-break:break-word}.article-source{font-size:25rpx;color:#5B6D5E}.article-tools{display:flex;align-items:center;gap:8rpx;border-top:1rpx solid #DFE4D6;border-bottom:1rpx solid #DFE4D6;margin:30rpx 0;min-height:100rpx}.article-tools button{background:transparent;border:0;padding:0;min-height:88rpx;display:flex;align-items:center;justify-content:center;color:#4F6457;margin:0;border-radius:0}.article-font{display:flex;align-items:center;gap:4rpx;margin-right:auto}.article-font button{width:78rpx;font-size:31rpx}.article-font text{font-size:23rpx;color:#69755F}.article-tools button[disabled]{color:#969D90;opacity:.6}.article-favorite,.article-share{gap:8rpx;font-size:25rpx;min-width:118rpx}.article-favorite.is-favorite{color:#AF442C}.article-cover{width:100%;height:auto;display:block;margin:32rpx 0 38rpx;border-radius:18rpx;background:#E6EBDD}.article-body{display:block;color:#263A30;line-height:1.95;word-break:break-word;white-space:pre-wrap;letter-spacing:.4rpx}.article-attribution{margin-top:44rpx;padding-top:26rpx;border-top:1rpx solid #DFE4D6;color:#62735E;font-size:24rpx;line-height:1.8;word-break:break-all}.article-attribution-title{font-size:27rpx;font-weight:600;margin-bottom:14rpx;color:#20352E}.article-attribution text{display:block;margin-top:8rpx}.article-reward{padding:30rpx;margin-top:38rpx;background:#F5F3ED}.article-reward-heading{display:flex;align-items:center;gap:18rpx}.article-reward-heading>view{flex:1}.article-reward-heading text{display:block;font-size:30rpx;font-weight:600;color:#20352E}.article-reward-heading .article-reward-sub{font-size:25rpx;font-weight:400;color:#5E705B;margin-top:10rpx;line-height:1.6}.article-reward-info{display:flex;justify-content:space-between;gap:20rpx;margin:26rpx 0;color:#9E3F28;font-size:25rpx;line-height:1.7}.article-reward .ui-secondary{margin-top:20rpx}.article-reward-note{display:block;font-size:24rpx;text-align:center;color:#62765A;margin-top:22rpx}.ui-error{margin-bottom:26rpx}
