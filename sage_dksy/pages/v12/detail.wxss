@import "./red-reader.wxss";
page{background:#FFFFFF}.article-page{padding:34rpx 34rpx calc(48rpx + env(safe-area-inset-bottom))}.article-kicker{display:flex;align-items:center;justify-content:space-between;gap:18rpx;font-size:24rpx;line-height:1.6;color:#A5697D}.article-kicker>view{display:flex;align-items:center;gap:8rpx;background:#FFF0F3;padding:8rpx 13rpx;border-radius:9rpx;color:#C1224B;font-weight:600}.article-title{font-size:46rpx;line-height:1.5;font-weight:700;letter-spacing:-.5rpx;color:#27212C;margin:28rpx 0 20rpx;word-break:break-word}.article-source{font-size:25rpx;line-height:1.7;color:#806574}.article-tools{display:flex;align-items:center;gap:6rpx;border-bottom:1rpx solid #F2DFE6;margin:18rpx 0 24rpx;min-height:100rpx}.article-tools button{background:transparent;border:0;padding:0;min-height:88rpx;display:flex;align-items:center;justify-content:center;color:#806574;margin:0;border-radius:0}.article-font{display:flex;align-items:center;gap:2rpx;margin-right:auto}.article-font button{width:78rpx;font-size:31rpx}.article-font text{font-size:24rpx;color:#806574}.article-tools button[disabled]{color:#806574;opacity:.6}.article-favorite,.article-share{gap:6rpx;font-size:25rpx;min-width:118rpx}.article-favorite.is-favorite{color:#C1224B}.article-reward-entry{display:flex;align-items:center;justify-content:space-between;gap:8rpx;background:#FFF7E7;border:1rpx solid #F1DFBB;border-radius:20rpx;padding:16rpx 18rpx;margin-bottom:30rpx}.article-reward-entry>view{display:flex;align-items:center;gap:12rpx;min-width:0;flex:1}.article-reward-entry>view>view{flex:1;min-width:0}.article-reward-entry text{display:block;font-size:23rpx;line-height:1.7;color:#916C66}.article-reward-entry>view>view>text:first-child{font-size:25rpx;color:#8D3049;font-weight:600}.article-reward-entry button{display:flex;align-items:center;justify-content:center;gap:3rpx;min-height:76rpx;max-width:164rpx;flex-shrink:0;font-size:24rpx;color:#B72344;background:transparent;padding:6rpx 0;margin:0}.article-cover{width:100%;height:auto;display:block;margin:28rpx 0 34rpx;border-radius:20rpx;background:#FFF0F3}.article-body{display:block;color:#3E333C;line-height:1.95;word-break:break-word;white-space:pre-wrap;letter-spacing:.4rpx}.article-end-mark{display:flex;align-items:center;justify-content:center;gap:12rpx;color:#A88694;font-size:24rpx;margin:42rpx 0 24rpx}.article-end-mark>view{width:70rpx;height:1rpx;background:#EEDFE6}.article-attribution{margin-top:24rpx;padding:24rpx;border:1rpx solid #F1DFE6;border-radius:20rpx;background:#FFFAFB;color:#806574;font-size:24rpx;line-height:1.8;word-break:break-all}.article-attribution-title{font-size:26rpx;font-weight:600;margin-bottom:10rpx;color:#775364}.article-attribution text{display:block;margin-top:6rpx}.article-reward-slot{padding-top:34rpx}.article-back{display:flex;align-items:center;justify-content:center;gap:8rpx;min-height:92rpx;font-size:27rpx;line-height:1.6;color:#B91B43}.ui-error{margin-bottom:26rpx}
@media(max-width:350px){.article-page{padding-left:26rpx;padding-right:26rpx}.article-title{font-size:42rpx}.article-font button{width:70rpx}.article-favorite,.article-share{min-width:108rpx}.article-reward-entry>view>yx-icon{display:none}}
