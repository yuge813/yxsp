<view class="read-reward-card">
 <view class="read-reward-top"><view class="read-reward-label"><yx-icon name="play" tone="brand" size="34"/><text>阅读广告激励</text></view><navigator url="/sage_dksy/pages/v14/rewards/index?category=read" class="read-rules">规则说明 <yx-icon name="arrow" tone="muted" size="24"/></navigator></view>
 <view class="read-reward-main"><view class="read-reward-copy"><text class="read-reward-title">好内容免费读，<text>奖励由你选择。</text></text><text class="read-reward-caption">自愿完整观看视频后，按实际规则领取</text></view><view class="read-reward-coin"><yx-icon name="coin" tone="brand" size="62"/></view></view>
 <view wx:if="{{rewardResult}}" class="read-result {{rewardResult.state}}" aria-role="status"><view class="read-result-top"><yx-icon name="{{rewardResult.state==='paid'?'yes':rewardResult.state==='pending'?'clock':rewardResult.state==='unpaid'?'play':'info'}}" tone="brand" size="36"/><text>{{rewardResult.state==='paid'?'本次奖励已到账':rewardResult.state==='unpaid'?'本次未获得奖励':rewardResult.state==='pending'?'本次奖励仍在核验':'广告暂时不可用'}}</text><text wx:if="{{rewardResult.state==='paid'}}" class="read-result-amount">+{{rewardResult.coins}} 金币</text></view><text class="read-result-note">{{rewardResult.state==='paid'?'服务端已确认，可在金币明细核对。':rewardResult.state==='unpaid'?'本次未发放金币，文章可以继续免费读。具体结果请核对金币明细。':rewardResult.state==='pending'?'请稍后查看金币明细；当前不显示未确认的到账金额。':'请重新获取状态后再试，普通阅读不受影响。'}}</text><view class="read-result-actions"><button bindtap="dismissReward">我知道了</button><navigator wx:if="{{rewardResult.state==='paid'||rewardResult.state==='pending'}}" url="/sage_dksy/pages/user/integral">查看金币明细 ›</navigator></view></view>
 <view class="read-reward-status"><view><text class="read-status-label">{{rewardView.state==='ready'?'本次广告奖励':'当前奖励状态'}}</text><view class="read-status-value"><block wx:if="{{rewardView.state==='ready'}}"><text>{{reward.coins===undefined||reward.coins===null||reward.coins===''?'待同步':'+'+reward.coins}}</text><text wx:if="{{reward.coins!==undefined&&reward.coins!==null&&reward.coins!==''}}">金币</text></block><text wx:else>{{rewardView.text}}</text></view></view><view class="read-reward-remaining"><text>{{rewardView.state==='cool'?'冷却剩余':rewardView.state==='ready'?'今日剩余':'参与条件'}}</text><text>{{rewardView.state==='cool'?rewardView.sub:rewardView.state==='ready'?rewardView.remaining+' 次':'以实际状态为准'}}</text></view></view>
 <button wx:if="{{rewardView.state==='ready'}}" class="ui-primary read-watch" bindtap="watch">自愿看视频，完成领金币 <yx-icon name="play" tone="light" size="34"/></button>
 <button wx:elif="{{rewardView.state==='cool'}}" class="ui-secondary read-watch" disabled="{{true}}">冷却中 · {{rewardView.sub}}</button>
 <button wx:else class="ui-secondary read-watch" bindtap="refreshReward">{{rewardView.state==='loading'?'正在同步状态':'重新获取奖励状态'}}</button>
 <text class="read-reward-footnote">提前关闭不发奖励 · 到账以服务端核验为准</text>
</view>
