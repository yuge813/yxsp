page{background:#FFF6F5}.ad-bridge{text-align:center;padding-top:150rpx}.ad-mark{width:116rpx;height:116rpx;display:flex;align-items:center;justify-content:center;background:#FFE3E7;border-radius:34rpx;margin:0 auto 34rpx}.ad-bridge .ui-title{font-size:44rpx;margin:24rpx 0 36rpx}.ad-status{display:flex;align-items:center;justify-content:center;gap:20rpx;color:#6F5968;font-size:30rpx;line-height:1.7;min-height:120rpx}.ad-spinner{width:36rpx;height:36rpx;border:4rpx solid #F1D3DE;border-top-color:#D4113A;border-radius:50%;animation:spin 1s linear infinite;flex-shrink:0}.ad-note{font-size:26rpx;line-height:1.8;color:#806574;margin:50rpx 0}.ad-note text{display:block}.ad-bridge .ui-secondary{margin-top:40rpx}@keyframes spin{to{transform:rotate(360deg)}}
