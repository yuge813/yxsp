<view class="article-page ui-page">
 <yx-state wx:if="{{loading&&!article}}" type="loading" title="正在打开文章"/>
 <yx-state wx:elif="{{error&&!article}}" type="error" title="文章暂时无法打开" description="{{error}}" action="重新加载" bindaction="load"/>
 <block wx:if="{{article}}">
  <text class="article-kicker">元享阅读 / {{article.source||'好内容分享'}}</text><view class="article-title">{{article.title}}</view><text class="article-source">{{article.source}}</text>
  <view class="article-tools"><view class="article-font"><button data-delta="-2" bindtap="font" disabled="{{fontSize<=30}}" aria-label="缩小字号">A−</button><text>字号</text><button data-delta="2" bindtap="font" disabled="{{fontSize>=46}}" aria-label="放大字号">A＋</button></view><button class="article-favorite {{favorite?'is-favorite':''}}" bindtap="toggleFavorite" loading="{{favoriteBusy}}" disabled="{{favoriteBusy}}"><yx-icon name="heart" tone="{{favorite?'brand':'muted'}}" size="34"/><text>{{favorite?'已收藏':'收藏'}}</text></button><button class="article-share" open-type="share"><yx-icon name="share" tone="muted" size="34"/><text>分享</text></button></view>
  <view wx:if="{{error}}" class="ui-error" bindtap="load">更新未成功，已保留当前文章 · 点击重试</view>
  <image wx:if="{{article.cover_url}}" class="article-cover" src="{{article.cover_url}}" mode="widthFix" binderror="imgError"/>
  <text class="article-body" style="font-size:{{fontSize}}rpx" user-select="true">{{article.body}}</text>
  <yx22-ad placement="read_detail_banner"/>
  <view class="article-attribution"><view class="article-attribution-title">内容来源与授权</view><text>{{article.source}}</text><text wx:if="{{article.image_credit}}">图片：{{article.image_credit}}</text><text wx:if="{{article.image_source_url}}">图片来源：{{article.image_source_url}}</text><text wx:if="{{article.image_license_url}}">图片许可：{{article.image_license_url}}</text><text wx:if="{{article.license_url}}">转载与改编许可：{{article.license_url}}</text></view>
  <view class="article-reward ui-card"><view class="article-reward-heading"><yx-icon name="play" tone="brand" size="42"/><view><text>读到这里，休息一下</text><text class="article-reward-sub">自愿观看视频，按规则领取金币</text></view></view><view class="article-reward-info"><text>{{rewardView.state==='ready'?rewardView.sub:rewardView.text}}</text><text wx:if="{{rewardView.state==='ready'}}">今日剩余 {{rewardView.remaining}} 次</text><text wx:elif="{{rewardView.state==='cool'&&rewardView.sub}}">{{rewardView.sub}}</text></view><button wx:if="{{rewardView.state==='ready'}}" class="ui-secondary" bindtap="watch">自愿看视频</button><button wx:elif="{{rewardView.text==='状态更新失败'}}" class="ui-secondary" bindtap="refreshReward">重新读取奖励状态</button><text class="article-reward-note">文章始终可以免费阅读</text></view>
 </block>
</view>
