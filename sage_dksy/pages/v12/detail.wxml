<view class="article-page ui-page">
 <yx-state wx:if="{{loading&&!article}}" type="loading" title="正在打开文章"/>
 <yx-state wx:elif="{{error&&!article}}" type="error" title="文章暂时无法打开" description="{{error}}" action="重新加载" bindaction="load"/>
 <block wx:if="{{article}}">
  <view class="article-kicker"><view><yx-icon name="book" tone="brand" size="28"/><text>元享阅读</text></view><text>免费好内容</text></view><view class="article-title">{{article.title}}</view><text class="article-source">{{article.source||'元享阅读'}}</text>
  <view class="article-tools"><view class="article-font"><button data-delta="-2" bindtap="font" disabled="{{fontSize<=30}}" aria-label="缩小字号">A−</button><text>字号</text><button data-delta="2" bindtap="font" disabled="{{fontSize>=46}}" aria-label="放大字号">A＋</button></view><button class="article-favorite {{favorite?'is-favorite':''}}" bindtap="toggleFavorite" loading="{{favoriteBusy}}" disabled="{{favoriteBusy}}"><yx-icon name="heart" tone="{{favorite?'brand':'muted'}}" size="34"/><text>{{favorite?'已收藏':'收藏'}}</text></button><button class="article-share" open-type="share"><yx-icon name="share" tone="muted" size="34"/><text>分享</text></button></view>
  <view class="article-reward-entry"><view><yx-icon name="coin" tone="brand" size="42"/><view><text>阅读免费，广告激励自愿参与</text><text>完整观看后，奖励以实际核验为准</text></view></view><button bindtap="scrollToReward">查看激励 <yx-icon name="arrow" tone="brand" size="24"/></button></view>
  <view wx:if="{{error}}" class="ui-error" bindtap="load">更新未成功，已保留当前文章 · 点击重试</view>
  <image wx:if="{{article.cover_url}}" class="article-cover" src="{{article.cover_url}}" mode="widthFix" binderror="imgError"/>
  <text class="article-body" style="font-size:{{fontSize}}rpx" user-select="true">{{article.body}}</text>
  <view class="article-end-mark"><view></view><yx-icon name="book" tone="muted" size="26"/><text>感谢阅读</text><view></view></view>
  <yx22-ad placement="read_detail_banner"/>
  <view class="article-attribution"><view class="article-attribution-title">内容来源与授权</view><text>{{article.source||'以文章实际来源说明为准'}}</text><text wx:if="{{article.image_credit}}">图片：{{article.image_credit}}</text><text wx:if="{{article.image_source_url}}">图片来源：{{article.image_source_url}}</text><text wx:if="{{article.image_license_url}}">图片许可：{{article.image_license_url}}</text><text wx:if="{{article.license_url}}">转载与改编许可：{{article.license_url}}</text></view>
  <view id="read-reward" class="article-reward-slot"><include src="./red-reader-reward.wxml"/></view>
  <navigator class="article-back" url="/sage_dksy/pages/v12/list" open-type="redirect">继续发现更多好内容 <yx-icon name="arrow" tone="brand" size="28"/></navigator>
 </block>
</view>
