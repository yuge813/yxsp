<view class="reader-page">
 <view class="reader-intro"><view class="reader-intro-copy"><text class="reader-eyebrow">元享阅读 · 每日发现</text><view>把时间，<text>留给好内容。</text></view><text class="reader-intro-note">文章免费阅读，广告激励自愿参与</text></view><view class="reader-intro-art"><yx-icon name="book" tone="light" size="104"/><view></view></view></view>
 <view class="reader-body">
  <include src="./red-reader-reward.wxml"/>
  <view class="reader-section-head"><text>今天，读点好内容</text><text>免费阅读</text></view>
  <view class="reader-search"><yx-icon name="search" tone="muted" size="36"/><input placeholder="搜索当前已加载的文章" value="{{searchText}}" bindinput="onSearch" confirm-type="search"/><button wx:if="{{searchText}}" bindtap="clearSearch" aria-label="清除搜索"><yx-icon name="close" tone="muted" size="32"/></button></view>
  <scroll-view scroll-x="true" class="reader-categories" show-scrollbar="{{false}}"><view class="reader-categories-inner"><view wx:for="{{categories}}" wx:key="slug" data-cat="{{item.slug}}" bindtap="switchCat" class="reader-category {{category===item.slug?'is-active':''}}">{{item.name}}</view></view></scroll-view>
  <yx-state wx:if="{{loading&&!items.length}}" type="loading" title="正在整理好内容"/>
  <yx-state wx:elif="{{error&&!items.length}}" type="error" title="内容暂时没有加载出来" description="请检查网络，再试一次" action="重新加载" bindaction="retry"/>
  <yx-state wx:elif="{{!items.length}}" type="empty" title="内容正在整理中" description="稍后再来，看看新的发现"/>
  <yx-state wx:elif="{{searchText&&!filteredItems.length}}" type="empty" title="已加载文章中没有匹配内容" description="试试其他关键词，或清除搜索继续浏览" action="清除搜索" bindaction="clearSearch"/>
  <block wx:if="{{filteredItems.length}}">
   <view class="reader-feature" data-id="{{filteredItems[0].id}}" bindtap="detail" hover-class="reader-pressed"><image wx:if="{{filteredItems[0].hasImage}}" class="reader-feature-image" src="{{filteredItems[0].cover_url}}" mode="aspectFill" data-id="{{filteredItems[0].id}}" binderror="imgError"/><view wx:else class="reader-feature-empty"><yx-icon name="book" tone="brand" size="96"/><text>元享阅读</text></view><view class="reader-feature-copy"><view class="reader-feature-meta"><text>精选好文</text><text>{{filteredItems[0].source||'元享阅读'}}</text></view><view class="reader-feature-title">{{filteredItems[0].title}}</view><text wx:if="{{filteredItems[0].summary}}" class="reader-feature-summary">{{filteredItems[0].summary}}</text><view class="reader-feature-link"><text>开始阅读</text><yx-icon name="arrow" tone="brand" size="30"/></view></view></view>
   <yx22-ad placement="read_feed_native"/>
   <view class="reader-stories"><block wx:for="{{filteredItems}}" wx:key="id"><view wx:if="{{index>0}}" class="reader-story" data-id="{{item.id}}" bindtap="detail" hover-class="reader-pressed"><view class="reader-story-main"><text class="reader-story-source">{{item.source||'元享阅读'}}</text><view class="reader-story-title">{{item.title}}</view><text wx:if="{{item.summary}}" class="reader-story-summary">{{item.summary}}</text></view><image wx:if="{{item.hasImage}}" class="reader-story-image" src="{{item.cover_url}}" mode="aspectFill" lazy-load="true" data-id="{{item.id}}" binderror="imgError"/><view wx:else class="reader-story-placeholder"><yx-icon name="book" tone="brand" size="48"/></view></view></block></view>
  </block>
  <view wx:if="{{items.length}}" class="reader-pagination"><button wx:if="{{error}}" class="ui-text-button" bindtap="retry">{{error}} · 重新加载</button><button wx:elif="{{hasMore}}" class="ui-text-button" loading="{{loading}}" disabled="{{loading}}" bindtap="load">{{loading?'正在加载':'继续发现更多内容'}}</button><text wx:else>已看完当前分类的内容</text></view>
  <navigator class="reader-footnote" url="/sage_dksy/pages/v14/rewards/index?category=read"><yx-icon name="info" tone="muted" size="28"/><text>阅读与广告激励说明</text><yx-icon name="arrow" tone="muted" size="24"/></navigator>
 </view>
 <yx22-popup scene="read"/>
</view>
