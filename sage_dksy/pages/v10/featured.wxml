<view class="featured-page ui-page"><view class="featured-hero"><text class="ui-kicker">元享精选 / 日常里的新期待</text><view class="ui-title">{{title}}</view><text class="ui-lead">看看新发现，为喜欢的好物慢慢积累。</text></view><yx-state wx:if="{{loading&&!items.length}}" type="loading" title="正在读取精选内容"/><yx-state wx:elif="{{error&&!items.length}}" type="error" title="精选内容暂时没有加载出来" action="重新加载" bindaction="refresh"/><yx-state wx:elif="{{closed}}" type="empty" title="本期精选暂未开放" description="之后再来，看看新的好物与活动"/><yx-state wx:elif="{{!items.length}}" type="empty" title="精选内容正在准备" description="当前暂无上架的精选活动"/><view wx:if="{{error&&items.length}}" class="ui-error" bindtap="refresh">更新未成功，点击重试</view><block wx:if="{{!closed}}"><view class="featured-card ui-card" wx:for="{{items}}" wx:key="key"><view class="featured-image-wrap" data-kind="{{item.kind}}" data-id="{{item.id}}" data-active="{{item.active}}" bindtap="open"><image wx:if="{{item.image&&!item._imageFailed}}" class="featured-image" src="{{item.image}}" mode="aspectFill" data-index="{{index}}" binderror="imageError"/><view wx:else class="featured-image-empty"><yx-icon name="gift" tone="green" size="90"/></view><view class="featured-category">{{item.kind==='trial'?'商品试用':'金币好礼'}}</view></view><view class="featured-body"><text class="featured-state">{{item.state}}</text><view class="featured-name">{{item.title}}</view><view class="featured-meta"><text wx:if="{{item.quantity!==undefined}}">{{item.kind==='trial'?'试用名额':'当前库存'}}：{{item.quantity}}</text><text wx:if="{{item.deadline}}">截止：{{item.deadline}}</text><text wx:if="{{item.terms}}">参与条件：{{item.terms}}</text><text wx:if="{{item.freight}}">配送说明：{{item.freight}}</text><text wx:if="{{item.kind==='trial'&&item.result_note}}">结果公布：{{item.result_note}}</text></view><button class="ui-primary" data-kind="{{item.kind}}" data-id="{{item.id}}" data-active="{{item.active}}" bindtap="open">查看{{item.kind==='trial'?'活动':'好礼'}}详情</button><view wx:if="{{shareOn}}" class="featured-share"><button class="ui-text-button" open-type="share" data-kind="{{item.kind}}" data-id="{{item.id}}"><yx-icon name="share" tone="muted" size="32"/>分享给好友</button><button wx:if="{{posterOn}}" class="ui-text-button" data-kind="{{item.kind}}" data-id="{{item.id}}" bindtap="cardShare"><yx-icon name="image" tone="muted" size="32"/>制作海报</button></view></view></view></block></view>
