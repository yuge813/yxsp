/* 元享 · Modern lifestyle system. One shared foundation, no historical theme cascade. */
page{background:#FFF6F5;color:#27212C;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:30rpx;line-height:1.55;}
view,text,image,navigator,button,input,textarea,scroll-view{box-sizing:border-box;}
button{margin:0;padding:0;font-family:inherit;font-weight:500;line-height:1.4;border-radius:0;background:transparent;color:inherit;}button::after{border:0;}button[disabled]{background:#EEEAF0;color:#857986;opacity:1;}image{display:block;}input,textarea{color:#27212C;font-family:inherit;}
.ui-page{min-height:100vh;padding:32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));}.ui-kicker{display:block;font-size:24rpx;font-weight:500;line-height:1.6;letter-spacing:2rpx;color:#795D68;}.ui-title{display:block;font-size:48rpx;line-height:1.3;letter-spacing:-1rpx;font-weight:700;color:#27212C;overflow-wrap:anywhere;}.ui-lead{display:block;font-size:28rpx;line-height:1.8;color:#795D68;}
.ui-section-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:44rpx 0 22rpx;font-size:34rpx;font-weight:650;line-height:1.4;}.ui-section-head navigator,.ui-section-head>text:last-child:not(:first-child){font-size:25rpx;color:#806574;font-weight:400;}.ui-card{background:#FFFFFF;border:1rpx solid #F2DFE6;border-radius:32rpx;padding:28rpx;min-width:0;}.ui-row{display:flex;align-items:center;gap:20rpx;min-width:0;}.ui-muted{color:#795D68;font-size:26rpx;line-height:1.7;}.ui-label{display:block;font-size:26rpx;line-height:1.6;color:#795D68;}.ui-balance{font-variant-numeric:tabular-nums;font-size:62rpx;line-height:1.15;font-weight:700;letter-spacing:-2rpx;overflow-wrap:anywhere;}
.ui-primary,.ui-secondary{display:flex;align-items:center;justify-content:center;gap:12rpx;min-height:96rpx;padding:20rpx 28rpx;border-radius:18rpx;font-size:30rpx;font-weight:650;line-height:1.5;text-align:center;white-space:normal;}.ui-primary{background:#D4113A;color:#FFFFFF;}.ui-secondary{min-height:92rpx;background:#FFF0F3;color:#27212C;}.ui-primary[disabled],.ui-secondary[disabled]{background:#EEEAF0;color:#857986;}.ui-text-button{min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:16rpx;font-size:26rpx;color:#B91B43;}
.ui-input{width:100%;min-height:96rpx;background:#FFF8FA;border:1rpx solid #EFDCE5;border-radius:16rpx;padding:22rpx 24rpx;font-size:30rpx;line-height:1.6;}.ui-error{display:block;padding:24rpx;border:1rpx solid #F6C7D4;background:#FFF0F3;border-radius:18rpx;color:#B61D44;font-size:26rpx;line-height:1.7;margin:20rpx 0;overflow-wrap:anywhere;}.ui-empty{padding:64rpx 28rpx;text-align:center;font-size:28rpx;line-height:1.8;color:#795D68;}.ui-tag{display:inline-flex;align-items:center;gap:6rpx;border-radius:9rpx;background:#FFF0F3;color:#BC1943;font-size:23rpx;line-height:1.6;padding:6rpx 12rpx;}.ui-tag-warm{background:#FFF1D3;color:#96521F;}.ui-divider{height:1rpx;background:#F2DFE6;margin:24rpx 0;}.ui-footnote{font-size:24rpx;line-height:1.8;color:#806574;}.ui-ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.ui-safe-bottom{height:calc(40rpx + env(safe-area-inset-bottom));}
/* Four root destinations with an opaque, safe-area-aware navigation surface. */
.club-nav-spacer{height:calc(132rpx + env(safe-area-inset-bottom));width:100%;flex-shrink:0;}.club-nav{position:fixed;left:0;right:0;bottom:0;z-index:90;display:flex;align-items:flex-start;justify-content:space-around;background:#FFFFFF;border-top:1rpx solid #F2DFE6;height:calc(118rpx + env(safe-area-inset-bottom));padding:10rpx 16rpx env(safe-area-inset-bottom);box-sizing:border-box;}.club-nav-tab{position:relative;flex:1;min-width:0;min-height:100rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;color:#806574;font-size:23rpx;line-height:1.3;}.club-nav-tab image{width:42rpx;height:42rpx;}.club-nav-tab.club-active{color:#D4113A;font-weight:650;}.club-nav-tab.club-active::before{content:"";position:absolute;top:-11rpx;left:calc(50% - 16rpx);width:32rpx;height:5rpx;border-radius:0 0 4rpx 4rpx;background:#D4113A;}
/* Native ads are ordinary scroll content, never footer hit targets. */
.yx44-inline-ad{position:relative;width:100%;clear:both;margin:32rpx 0 44rpx;z-index:0;}.yx44-inline-ad ad,.yx44-inline-ad ad-custom{display:block;position:relative;width:100%;max-width:100%;}.yx44-safe-scroll-tail{height:calc(156rpx + env(safe-area-inset-bottom));pointer-events:none;}
rich-text{overflow-wrap:anywhere;}textarea{line-height:1.8;}@media (max-width:350px){.ui-page{padding-left:24rpx;padding-right:24rpx;}.ui-title{font-size:44rpx;}.ui-card{padding:24rpx;}}

/* Approved five-destination red navigation. */
.club-nav-tab{flex:1;max-width:20%;font-size:22rpx;gap:8rpx}.club-nav-tab.club-active::before{display:none}.club-nav-tab image{width:44rpx;height:44rpx}.club-nav-tab.club-active{background:#FFF0F3;border-radius:18rpx;min-height:96rpx}.ui-gold{background:linear-gradient(115deg,#FFF2C2,#FFDA83);color:#8C1739}.ui-ticket{background:linear-gradient(130deg,#FFF8E7,#FFE8BE);border:1rpx solid #F2D59B;border-radius:32rpx;padding:34rpx}.ui-red-stage{background:linear-gradient(120deg,#D70C38,#F3273D 65%,#FF5841);color:#fff;border-radius:36rpx;padding:40rpx}
